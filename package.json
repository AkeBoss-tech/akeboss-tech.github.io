{
  "name": "akash-portfolio",
  "packageManager": "bun@1.4.0",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/three": "^0.184.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "jsdom": "^26.1.0",
    "playwright": "^1.59.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "predev": "bun run images:build",
    "prebuild": "bun run images:build && bun run wiki:validate",
    "dev": "bun --bun next dev --port 3001",
    "build": "bun --bun next build",
    "redirects:build": "bun scripts/build-legacy-redirects.mjs",
    "images:build": "bun scripts/build-responsive-images.mjs",
    "jobfill:test": "node --test tools/jobfill/test/security.test.mjs && node tools/jobfill/test/run-sample.mjs",
    "wiki:validate": "bun scripts/validate-wiki.mjs",
    "start": "bun --bun next start",
    "lint": "bun --bun eslint .",
    "test": "bun test ./test/",
    "check": "bun run --parallel lint wiki:validate test",
    "audit": "bun audit --audit-level=high"
  },
  "main": "index.js",
  "type": "module",
  "dependencies": {
    "animejs": "^4.4.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.17.0",
    "next": "^16.2.4",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.376.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0"
  },
  "private": true
}

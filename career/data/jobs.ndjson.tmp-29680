{"schema_version":1,"job_key":"greenhouse:anthropic:5391237008","source":{"type":"greenhouse","board":"anthropic","job_id":"5391237008","source_url":"https://boards-api.greenhouse.io/v1/boards/anthropic/jobs","response_hash":"9c536f37a88cfa2f1af70ce5caa2ad98b889ffb9e214b6e9347814e47e16bf2f","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Anthropic","slug":"anthropic","lists":["ai-ml","ai-infra","research"],"target_role":null,"fit_tier":null},"title":"Partner Account Manager - Spain, Italy & MEA","canonical_url":"https://job-boards.greenhouse.io/anthropic/jobs/5391237008","apply_url":"https://job-boards.greenhouse.io/anthropic/jobs/5391237008","locations":[{"label":"Madrid, Spain"}],"workplace_type":"unknown","employment_type":"unknown","departments":["Sales"],"teams":[],"language":"en","requisition_id":"266729","internal_job_id":4533016008,"first_published_at":"2026-08-20T10:49:53-04:00","source_updated_at":"2026-08-24T12:26:43-04:00","application_deadline":null,"description_plain":null,"description_html":null,"compensation":[],"custom_fields":{"Location Type":"On-Site"},"status":"open","first_seen_at":"2026-08-24T20:50:05.208Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":false,"tier":"stretch","score":0,"level":"manager","term":null,"tracks":[],"role_matches":[],"early_career_matches":[],"positive_matches":[],"exclude_matches":["Manager"],"configured_tracks":["ai-ml","ai-infra","research"]}}
{"schema_version":1,"job_key":"greenhouse:anthropic:5391241008","source":{"type":"greenhouse","board":"anthropic","job_id":"5391241008","source_url":"https://boards-api.greenhouse.io/v1/boards/anthropic/jobs","response_hash":"a62f1ba4b0038f59e35291948c7d5eac15f78a2a3c84ff28db13c7665f0ec836","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Anthropic","slug":"anthropic","lists":["ai-ml","ai-infra","research"],"target_role":null,"fit_tier":null},"title":"Partner Account Manager, DACH","canonical_url":"https://job-boards.greenhouse.io/anthropic/jobs/5391241008","apply_url":"https://job-boards.greenhouse.io/anthropic/jobs/5391241008","locations":[{"label":"Munich, Germany"},{"label":"München, Bavaria, Germany"}],"workplace_type":"unknown","employment_type":"unknown","departments":["Sales"],"teams":[],"language":"en","requisition_id":"266730","internal_job_id":4533018008,"first_published_at":"2026-08-21T06:38:48-04:00","source_updated_at":"2026-08-21T12:50:59-04:00","application_deadline":null,"description_plain":null,"description_html":null,"compensation":[],"custom_fields":{"Location Type":"On-Site"},"status":"open","first_seen_at":"2026-08-24T01:56:20.339Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":false,"tier":"stretch","score":0,"level":"manager","term":null,"tracks":[],"role_matches":[],"early_career_matches":[],"positive_matches":[],"exclude_matches":["Manager"],"configured_tracks":["ai-ml","ai-infra","research"]}}

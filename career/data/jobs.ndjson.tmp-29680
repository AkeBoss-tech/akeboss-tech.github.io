{"schema_version":1,"job_key":"greenhouse:anthropic:5193428008","source":{"type":"greenhouse","board":"anthropic","job_id":"5193428008","source_url":"https://boards-api.greenhouse.io/v1/boards/anthropic/jobs","response_hash":"b5c985016f0d9173a26b00a3f09289df3082bb8be1cdb99962eb84fb57469f34","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Anthropic","slug":"anthropic","lists":["ai-ml","ai-infra","research"],"target_role":null,"fit_tier":null},"title":"Sr. Manager, Cash Application","canonical_url":"https://job-boards.greenhouse.io/anthropic/jobs/5193428008","apply_url":"https://job-boards.greenhouse.io/anthropic/jobs/5193428008","locations":[{"label":"San Francisco, CA | New York City, NY | Seattle, WA"},{"label":"San Francisco, California, United States"}],"workplace_type":"unknown","employment_type":"unknown","departments":["Finance"],"teams":[],"language":"en","requisition_id":"261942","internal_job_id":4461843008,"first_published_at":"2026-04-27T16:08:53-04:00","source_updated_at":"2026-08-21T12:50:08-04:00","application_deadline":null,"description_plain":null,"description_html":null,"compensation":[],"custom_fields":{"Location Type":"On-Site"},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":false,"tier":"stretch","score":0,"level":"manager","term":null,"tracks":[],"role_matches":[],"early_career_matches":[],"positive_matches":[],"exclude_matches":["Manager"],"configured_tracks":["ai-ml","ai-infra","research"]}}

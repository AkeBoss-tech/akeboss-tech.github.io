{"schema_version":1,"job_key":"workday:bah-bah-jobs:/job/Washington-DC/Scheduler-and-Risk-Analyst--Mid_R0245649","source":{"type":"workday","board":"bah-BAH_Jobs","job_id":"/job/Washington-DC/Scheduler-and-Risk-Analyst--Mid_R0245649","source_url":"https://bah.wd1.myworkdayjobs.com/wday/cxs/bah/BAH_Jobs/jobs","response_hash":"6fb1eb6a1488eeb33f725342c75cba1eb4aa62eb0b1691652490a166922d2948","fetched_at":"2026-08-25T02:30:45.417Z"},"company":{"name":"Booz Allen","slug":"booz-allen","lists":["consulting-ai","enterprise-ai"],"target_role":null,"fit_tier":null},"title":"Scheduler and Risk Analyst, Mid","canonical_url":"https://bah.wd1.myworkdayjobs.com/BAH_Jobs/job/Washington-DC/Scheduler-and-Risk-Analyst--Mid_R0245649","apply_url":"https://bah.wd1.myworkdayjobs.com/BAH_Jobs/job/Washington-DC/Scheduler-and-Risk-Analyst--Mid_R0245649","locations":[{"label":"Washington, DC"}],"workplace_type":"unknown","employment_type":"unknown","departments":[],"teams":[],"language":null,"requisition_id":"R0245649","internal_job_id":null,"first_published_at":null,"source_updated_at":null,"application_deadline":null,"description_plain":null,"description_html":null,"compensation":[],"custom_fields":{"can_apply":null,"country":null,"posted_on":"Posted 19 Days Ago"},"status":"open","first_seen_at":"2026-08-20T06:16:39.881Z","last_seen_at":"2026-08-25T02:30:45.417Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":false,"tier":"stretch","score":0,"level":"unspecified","term":null,"tracks":[],"role_matches":[],"early_career_matches":[],"positive_matches":[],"exclude_matches":[],"configured_tracks":["consulting-ai","enterprise-ai"]}}

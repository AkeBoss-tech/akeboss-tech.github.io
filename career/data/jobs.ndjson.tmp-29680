{"schema_version":1,"job_key":"greenhouse:anthropic:5101378008","source":{"type":"greenhouse","board":"anthropic","job_id":"5101378008","source_url":"https://boards-api.greenhouse.io/v1/boards/anthropic/jobs","response_hash":"6ad11ab17eaa80e975dfef33ecce3f594d4c640658b2bf65f7b6b294e50f43dc","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Anthropic","slug":"anthropic","lists":["ai-ml","ai-infra","research"],"target_role":null,"fit_tier":null},"title":"Account Executive, Public Sector","canonical_url":"https://job-boards.greenhouse.io/anthropic/jobs/5101378008","apply_url":"https://job-boards.greenhouse.io/anthropic/jobs/5101378008","locations":[{"label":"Sydney, Australia"},{"label":"Sydney, New South Wales, Australia"}],"workplace_type":"unknown","employment_type":"unknown","departments":["Sales"],"teams":[],"language":"en","requisition_id":"260322","internal_job_id":4418623008,"first_published_at":"2026-04-07T16:10:24-04:00","source_updated_at":"2026-08-21T12:49:53-04:00","application_deadline":null,"description_plain":null,"description_html":null,"compensation":[],"custom_fields":{"Location Type":null},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":false,"tier":"stretch","score":0,"level":"unspecified","term":null,"tracks":[],"role_matches":[],"early_career_matches":[],"positive_matches":[],"exclude_matches":["Account Executive"],"configured_tracks":["ai-ml","ai-infra","research"]}}
{"schema_version":1,"job_key":"greenhouse:anthropic:5400138008","source":{"type":"greenhouse","board":"anthropic","job_id":"5400138008","source_url":"https://boards-api.greenhouse.io/v1/boards/anthropic/jobs","response_hash":"11bfc77c39b78c36bfb2375944a0678661bc2a67fe86c859d5ded55e14c5ce37","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Anthropic","slug":"anthropic","lists":["ai-ml","ai-infra","research"],"target_role":null,"fit_tier":null},"title":"Account Executive, Startups","canonical_url":"https://job-boards.greenhouse.io/anthropic/jobs/5400138008","apply_url":"https://job-boards.greenhouse.io/anthropic/jobs/5400138008","locations":[{"label":"San Francisco, CA | New York City, NY"},{"label":"New York, New York, United States"},{"label":"San Francisco, California, United States"}],"workplace_type":"unknown","employment_type":"unknown","departments":["Sales"],"teams":[],"language":"en","requisition_id":"3356","internal_job_id":4147866008,"first_published_at":"2026-08-24T16:19:13-04:00","source_updated_at":"2026-08-24T16:19:13-04:00","application_deadline":null,"description_plain":null,"description_html":null,"compensation":[],"custom_fields":{"Location Type":"On-Site"},"status":"open","first_seen_at":"2026-08-24T20:50:05.208Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":false,"tier":"stretch","score":0,"level":"unspecified","term":null,"tracks":[],"role_matches":[],"early_career_matches":[],"positive_matches":[],"exclude_matches":["Account Executive"],"configured_tracks":["ai-ml","ai-infra","research"]}}

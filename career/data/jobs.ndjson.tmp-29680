{"schema_version":1,"job_key":"workday:bah-bah-jobs:/job/Arlington-VA/Data-Quality-Engineer_R0242630","source":{"type":"workday","board":"bah-BAH_Jobs","job_id":"/job/Arlington-VA/Data-Quality-Engineer_R0242630","source_url":"https://bah.wd1.myworkdayjobs.com/wday/cxs/bah/BAH_Jobs/jobs","response_hash":"d29ce67a9ccb8d4849ef6217e9b49d2038da1e60ddc3d615f09fc20443443a73","fetched_at":"2026-08-25T02:30:45.417Z"},"company":{"name":"Booz Allen","slug":"booz-allen","lists":["consulting-ai","enterprise-ai"],"target_role":null,"fit_tier":null},"title":"Data Quality Engineer","canonical_url":"https://bah.wd1.myworkdayjobs.com/BAH_Jobs/job/Arlington-VA/Data-Quality-Engineer_R0242630","apply_url":"https://bah.wd1.myworkdayjobs.com/BAH_Jobs/job/Arlington-VA/Data-Quality-Engineer_R0242630","locations":[{"label":"Arlington, VA"}],"workplace_type":"unknown","employment_type":"unknown","departments":[],"teams":[],"language":null,"requisition_id":"R0242630","internal_job_id":null,"first_published_at":null,"source_updated_at":null,"application_deadline":null,"description_plain":null,"description_html":null,"compensation":[],"custom_fields":{"can_apply":null,"country":null,"posted_on":"Posted 30+ Days Ago"},"status":"open","first_seen_at":"2026-08-20T06:16:39.881Z","last_seen_at":"2026-08-25T02:30:45.417Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":false,"tier":"stretch","score":0,"level":"unspecified","term":null,"tracks":[],"role_matches":[],"early_career_matches":[],"positive_matches":[],"exclude_matches":[],"configured_tracks":["consulting-ai","enterprise-ai"]}}

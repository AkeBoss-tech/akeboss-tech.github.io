{"schema_version":1,"job_key":"ashby:abridge:d48553c1-a360-4509-a1e0-9df6d8b480f6","source":{"type":"ashby","board":"abridge","job_id":"d48553c1-a360-4509-a1e0-9df6d8b480f6","source_url":"https://api.ashbyhq.com/posting-api/job-board/abridge","response_hash":"2370a22d57dfc159855e2e935b7522ec89a7917a8022bc592543f7005ee22516","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Abridge","slug":"abridge","lists":["enterprise-ai","founding"],"target_role":null,"fit_tier":null},"title":"Staff Product Designer","canonical_url":"https://jobs.ashbyhq.com/abridge/d48553c1-a360-4509-a1e0-9df6d8b480f6","apply_url":"https://jobs.ashbyhq.com/abridge/d48553c1-a360-4509-a1e0-9df6d8b480f6/application","locations":[{"label":"SF Office","city":"San Francisco","region":"California","country":"USA","remote":null,"hybrid":null},{"label":"NYC Office","city":"New York City","region":"New York","country":"USA","remote":null,"hybrid":null}],"workplace_type":"hybrid","employment_type":"full_time","departments":["Builder"],"teams":["Product Design"],"language":null,"requisition_id":null,"internal_job_id":null,"first_published_at":"2025-09-02T22:25:07.056+00:00","source_updated_at":null,"application_deadline":null,"description_plain":null,"description_html":null,"compensation":[{"type":"salary","summary":"$240K – $299K • Offers Equity","salary_summary":"$240K - $299K","tiers":[{"title":null,"summary":"Estimated base salary for NYC / SF $240K – $299K • Offers Equity","additional_information":null}]}],"custom_fields":{},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":false,"tier":"stretch","score":0,"level":"staff","term":null,"tracks":[],"role_matches":[],"early_career_matches":[],"positive_matches":[],"exclude_matches":["Staff","Designer"],"configured_tracks":["enterprise-ai","founding"]}}

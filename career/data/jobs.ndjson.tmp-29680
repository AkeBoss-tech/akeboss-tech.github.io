{"schema_version":1,"job_key":"ashby:abridge:a107c6ea-3af4-46ea-b26d-61dd9dcdc13a","source":{"type":"ashby","board":"abridge","job_id":"a107c6ea-3af4-46ea-b26d-61dd9dcdc13a","source_url":"https://api.ashbyhq.com/posting-api/job-board/abridge","response_hash":"d6d0664f71946088a1429e584a09cd5766131110009ba07eb696bf8c1ec3931e","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Abridge","slug":"abridge","lists":["enterprise-ai","founding"],"target_role":null,"fit_tier":null},"title":"Partner Success Manager - East","canonical_url":"https://jobs.ashbyhq.com/abridge/a107c6ea-3af4-46ea-b26d-61dd9dcdc13a","apply_url":"https://jobs.ashbyhq.com/abridge/a107c6ea-3af4-46ea-b26d-61dd9dcdc13a/application","locations":[{"label":"NYC Office","city":"New York City","region":"New York","country":"USA","remote":null,"hybrid":null}],"workplace_type":"hybrid","employment_type":"full_time","departments":["Commercial"],"teams":["Partner Success - Strategic"],"language":null,"requisition_id":null,"internal_job_id":null,"first_published_at":"2026-07-16T19:14:23.739+00:00","source_updated_at":null,"application_deadline":null,"description_plain":null,"description_html":null,"compensation":[{"type":"salary","summary":"$130K – $150K • $26K – $30K Equity • Offers Bonus","salary_summary":"$130K - $150K","tiers":[{"title":null,"summary":"$130K – $150K • $26K – $30K Equity • Offers Bonus","additional_information":null}]}],"custom_fields":{},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":false,"tier":"stretch","score":0,"level":"manager","term":null,"tracks":[],"role_matches":[],"early_career_matches":[],"positive_matches":[],"exclude_matches":["Manager"],"configured_tracks":["enterprise-ai","founding"]}}

{"schema_version":1,"job_key":"ashby:attio:01869e97-176e-4f53-a701-86d6c69ef0ea","source":{"type":"ashby","board":"attio","job_id":"01869e97-176e-4f53-a701-86d6c69ef0ea","source_url":"https://api.ashbyhq.com/posting-api/job-board/attio","response_hash":"0f2cddae7b8f011bcc1bde4cec1de7df414d08b49e60ab200d0239d7784b7f4b","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Attio","slug":"attio","lists":["ai-ml","founding"],"target_role":null,"fit_tier":null},"title":"Account Executive","canonical_url":"https://jobs.ashbyhq.com/attio/01869e97-176e-4f53-a701-86d6c69ef0ea","apply_url":"https://jobs.ashbyhq.com/attio/01869e97-176e-4f53-a701-86d6c69ef0ea/application","locations":[{"label":"London","city":"London","region":"London","country":"United Kingdom","remote":null,"hybrid":null}],"workplace_type":"hybrid","employment_type":"full_time","departments":["GTM"],"teams":["Sales"],"language":null,"requisition_id":null,"internal_job_id":null,"first_published_at":"2026-05-26T18:35:52.164+00:00","source_updated_at":null,"application_deadline":null,"description_plain":null,"description_html":null,"compensation":[{"type":"salary","summary":null,"salary_summary":null,"tiers":[]}],"custom_fields":{},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":false,"tier":"stretch","score":0,"level":"unspecified","term":null,"tracks":[],"role_matches":[],"early_career_matches":[],"positive_matches":[],"exclude_matches":["Account Executive"],"configured_tracks":["ai-ml","founding"]}}

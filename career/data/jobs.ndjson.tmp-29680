{"schema_version":1,"job_key":"workday:bah-bah-jobs:/job/El-Segundo-CA/Digital-Engineer--Lead_R0241157","source":{"type":"workday","board":"bah-BAH_Jobs","job_id":"/job/El-Segundo-CA/Digital-Engineer--Lead_R0241157","source_url":"https://bah.wd1.myworkdayjobs.com/wday/cxs/bah/BAH_Jobs/jobs","response_hash":"c609c22fff0e15bcc8e14705063e974698f55b2703d651f8daf3879f8673ea04","fetched_at":"2026-08-25T02:30:45.417Z"},"company":{"name":"Booz Allen","slug":"booz-allen","lists":["consulting-ai","enterprise-ai"],"target_role":null,"fit_tier":null},"title":"Digital Engineer, Lead","canonical_url":"https://bah.wd1.myworkdayjobs.com/BAH_Jobs/job/El-Segundo-CA/Digital-Engineer--Lead_R0241157","apply_url":"https://bah.wd1.myworkdayjobs.com/BAH_Jobs/job/El-Segundo-CA/Digital-Engineer--Lead_R0241157","locations":[{"label":"El Segundo, CA"}],"workplace_type":"unknown","employment_type":"unknown","departments":[],"teams":[],"language":null,"requisition_id":"R0241157","internal_job_id":null,"first_published_at":null,"source_updated_at":null,"application_deadline":null,"description_plain":null,"description_html":null,"compensation":[],"custom_fields":{"can_apply":null,"country":null,"posted_on":"Posted 30+ Days Ago"},"status":"open","first_seen_at":"2026-08-20T06:16:39.881Z","last_seen_at":"2026-08-25T02:30:45.417Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":false,"tier":"stretch","score":0,"level":"lead","term":null,"tracks":[],"role_matches":[],"early_career_matches":[],"positive_matches":[],"exclude_matches":["Lead "],"configured_tracks":["consulting-ai","enterprise-ai"]}}
{"schema_version":1,"job_key":"workday:bah-bah-jobs:/job/Washington-DC/Digital-Engineering-Solutions-Engineer_R0247209","source":{"type":"workday","board":"bah-BAH_Jobs","job_id":"/job/Washington-DC/Digital-Engineering-Solutions-Engineer_R0247209","source_url":"https://bah.wd1.myworkdayjobs.com/wday/cxs/bah/BAH_Jobs/jobs","response_hash":"49997eb80f576dea174a72933eeeab9d95db2e5415cd04fdbaf0e2b5ee7f4664","fetched_at":"2026-08-25T02:30:45.417Z"},"company":{"name":"Booz Allen","slug":"booz-allen","lists":["consulting-ai","enterprise-ai"],"target_role":null,"fit_tier":null},"title":"Digital Engineering Solutions Engineer","canonical_url":"https://bah.wd1.myworkdayjobs.com/BAH_Jobs/job/Washington-DC/Digital-Engineering-Solutions-Engineer_R0247209","apply_url":"https://bah.wd1.myworkdayjobs.com/BAH_Jobs/job/Washington-DC/Digital-Engineering-Solutions-Engineer_R0247209","locations":[{"label":"Washington, DC"}],"workplace_type":"unknown","employment_type":"full_time","departments":[],"teams":[],"language":null,"requisition_id":"R0247209","internal_job_id":"26f0e5a9193a100104c93d6bd32c0000","first_published_at":"2026-08-18","source_updated_at":null,"application_deadline":null,"description_plain":"Digital Engineering Solutions Engineer The Opportunity:\nAre you looking for an opportunity to combine your technical skills with big picture thinking to make an impact in national defense? You understand your customer’s engineering needs and how to connect their authoritative digital data together to support their missions. Your ability to integrate varying engineering lifecycle artifacts together across a digital engineering ecosystem helps deliver transformational change to their organization.  \n\nAs a Digital Engineering Integration Engineer on our team, you have the opportunity to help an important client adopt and integrate digital engineering practices into their organization. Your technical expertise will be vital as you help the client organization define and stand up a digital engineering ecosystem and associated tools, processes and procedures to increase organizational capacity and speed. You’ll leverage your skills in systems engineering and offer expert advice and recommendations while leading a small team defining and implementing the digital engineering ecosystem. Grow your skills by merging engineering and business process to create transformational digital engineering change for our clients. Join our team and help drive the change needed to meet the challenges of the 21st century. \n\nJoin us. The world can’t wait. \n\nYou Have: \n- 6+ years of experience with model-based systems engineering (MBSE) practices\n\n- Experience with specifying or designing a digital engineering ecosystem or environment or information system using systems engineering practices\n\n- Experience with engineering processes for defense acquisition\n\n- Knowledge of product configuration and data management principles and practices\n\n- Knowledge of digital threads concepts, its purpose in digital engineering, and its role in connecting data across engineering disciplines\n\n- Ability to effectively and succinctly communicate complex technical information effectively to both non-technical and technical audiences, including senior organizational leaders\n\n- Ability to organize and lead small teams, and develop and maintain client relationships during project delivery\n\n- Secret clearance\n\n- Bachelor's degree in Engineering\n\nNice If You Have:\n- Experience implementing digital threads solutions\n\n- Experience with Product Life Cycle Management practices and tools\n\n- Experience with product development at an aerospace or defense OEM\n\n- Possession of excellent data analysis skills\n\n- Master’s degree in Engineering\n\nClearance:\nApplicants selected will be subject to a security investigation and may need to meet eligibility requirements for access to classified information; Secret clearance is required.\n\nCompensation\nAt Booz Allen, we celebrate your contributions, provide you with opportunities and choices, and support your total well-being. Our offerings include health, life, disability, financial, and retirement benefits, as well as paid leave, professional development, tuition assistance, work-life programs, and dependent care. Our recognition awards program acknowledges employees for exceptional performance and superior demonstration of our values. Full-time and part-time employees working at least 20 hours a week on a regular basis are eligible to participate in Booz Allen’s benefit programs. Individuals that do not meet the threshold are only eligible for select offerings, not inclusive of health benefits. We encourage you to learn more about our total benefits by visiting the Resource page on our Careers site and reviewing Our Employee Benefits page.\n\nSalary at Booz Allen is determined by various factors, including but not limited to location, the individual’s particular combination of education, knowledge, skills, competencies, and experience, as well as contract-specific affordability and organizational requirements. The projected compensation range for this position is $86,800.00 to $198,000.00 (annualized USD). The estimate displayed represents the typical salary range for this position and is just one component of Booz Allen’s total compensation package for employees. This posting will close within 90 days from the Posting Date.\nIdentity Statement\nAs part of the hiring process, we will ask you to complete an identity verification process that leverages advanced biometrics and artificial intelligence to ensure authenticity and protect against identity fraud. You are expected to be on camera during interviews and assessments. We reserve the right to take your picture to verify your identity and prevent fraud.\n\nCandidate AI Usage Policy\nAI is a part of our daily work at Booz Allen, and we are committed to the responsible and ethical use of AI tools. However, we want to ensure a fair candidate process based on your own skills and knowledge. As part of this commitment, the use of artificial intelligence (AI) or other tools to assist with responses during interviews (whether in-person or virtual) is prohibited unless permission is explicitly provided .\n\nWork Model\nOur people-first culture prioritizes the benefits of collaboration, whether it occurs in person or virtually. To support engagement and effective communication, employees working virtually are generally expected to have their cameras on during meetings.\n- Remote : If this position is listed as remote, there may still be occasions when you are required to work in person at a Booz Allen or customer facility.\n\n- Hybrid : If this position is listed as hybrid, you will be expected to work from a Booz Allen facility frequently, in alignment with leadership expectations and the needs of the role. You may also be required to work from or visit a customer facility.\n\n- Onsite : If this position is listed as onsite, work will primarily be performed at a Booz Allen office or customer facility, where employees will collaborate directly with colleagues and customers as required by the role.\n\nCommitment to Non-Discrimination\nAll qualified applicants will receive consideration for employment without regard to disability, status as a protected veteran or any other status protected by applicable federal, state, local, or international law.","description_html":"Digital Engineering Solutions Engineer<p><b>The Opportunity:</b></p><p>Are you looking for an opportunity to combine your technical skills with big picture thinking to make an impact in national defense? You understand your customer’s engineering needs and how to connect their authoritative digital data together to support their missions. Your ability to integrate varying engineering lifecycle artifacts together across a digital engineering ecosystem helps deliver transformational change to their organization.  </p><p></p><p>As a Digital Engineering Integration Engineer on our team, you have the opportunity to help an important client adopt and integrate digital engineering practices into their organization. Your technical expertise will be vital as you help the client organization define and stand up a digital engineering ecosystem and associated tools, processes and procedures to increase organizational capacity and speed. You’ll leverage your skills in systems engineering and offer expert advice and recommendations while leading a small team defining and implementing the digital engineering ecosystem. Grow your skills by merging engineering and business process to create transformational digital engineering change for our clients. Join our team and help drive the change needed to meet the challenges of the 21st century. </p><p></p><p>Join us. The world can’t wait. </p><p></p><p><b>You Have: </b></p><ul><li><p>6&#43; years of experience with model-based systems engineering (MBSE) practices</p></li><li><p>Experience with specifying or designing a digital engineering ecosystem or environment or information system using systems engineering practices</p></li><li><p>Experience with engineering processes for defense acquisition</p></li><li><p>Knowledge of product configuration and data management principles and practices</p></li><li><p>Knowledge of digital threads concepts, its purpose in digital engineering, and its role in connecting data across engineering disciplines</p></li><li><p>Ability to effectively and succinctly communicate complex technical information effectively to both non-technical and technical audiences, including senior organizational leaders</p></li><li><p>Ability to organize and lead small teams, and develop and maintain client relationships during project delivery</p></li><li><p>Secret clearance</p></li><li><p>Bachelor&#39;s degree in Engineering</p></li></ul><p></p><p><b>Nice If You Have:</b></p><ul><li><p>Experience implementing digital threads solutions</p></li><li><p>Experience with Product Life Cycle Management practices and tools</p></li><li><p>Experience with product development at an aerospace or defense OEM</p></li><li><p>Possession of excellent data analysis skills</p></li><li><p>Master’s degree in Engineering</p></li></ul><div><p></p></div><p><b>Clearance:</b></p><p><span>Applicants selected will be subject to a security investigation and may need to meet eligibility requirements for access to classified information; Secret clearance is required.</span></p><p></p><p style=\"text-align:inherit\"></p><p style=\"text-align:left\"><b>Compensation</b></p><p style=\"text-align:left\">At Booz Allen, we celebrate your contributions, provide you with opportunities and choices, and support your total well-being. Our offerings include health, life, disability, financial, and retirement benefits, as well as paid leave, professional development, tuition assistance, work-life programs, and dependent care. Our recognition awards program acknowledges employees for exceptional performance and superior demonstration of our values. Full-time and part-time employees working at least 20 hours a week on a regular basis are eligible to participate in Booz Allen’s benefit programs. Individuals that do not meet the threshold are only eligible for select offerings, not inclusive of health benefits. We encourage you to learn more about our total benefits by visiting the Resource page on our Careers site and reviewing Our Employee Benefits page.</p><p style=\"text-align:inherit\"></p>Salary at Booz Allen is determined by various factors, including but not limited to location, the individual’s particular combination of education, knowledge, skills, competencies, and experience, as well as contract-specific affordability and organizational requirements. The projected compensation range for this position is $86,800.00 to $198,000.00 (annualized USD). The estimate displayed represents the typical salary range for this position and is just one component of Booz Allen’s total compensation package for employees. This posting will close within 90 days from the Posting Date.<p style=\"text-align:inherit !important\"></p><p style=\"text-align:left !important\"><b>Identity Statement</b></p><p style=\"text-align:left !important\">As part of the hiring process, we will ask you to complete an identity verification process that leverages advanced biometrics and artificial intelligence to ensure authenticity and protect against identity fraud. You are expected to be on camera during interviews and assessments. We reserve the right to take your picture to verify your identity and prevent fraud.</p><p></p><p><b>Candidate AI Usage Policy</b></p><p>AI is a part of our daily work at Booz Allen, and we are committed to the responsible and ethical use of AI tools. However, we want to ensure a fair candidate process based on <b>your </b>own skills and knowledge. As part of this commitment, the use of artificial intelligence (AI) or other tools to assist with responses during interviews (whether in-person or virtual) is prohibited <b>unless permission is explicitly provided</b>. </p><p style=\"text-align:inherit !important\"></p><p style=\"text-align:left !important\"><b>Work Model</b><br />Our people-first culture prioritizes the benefits of collaboration, whether it occurs in person or virtually. To support engagement and effective communication, employees working virtually are generally expected to have their cameras on during meetings.</p><ul><li><p><b>Remote</b>: If this position is listed as remote, there may still be occasions when you are required to work in person at a Booz Allen or customer facility.</p></li><li><p><b>Hybrid</b>: If this position is listed as hybrid, you will be expected to work from a Booz Allen facility frequently, in alignment with leadership expectations and the needs of the role. You may also be required to work from or visit a customer facility.</p></li><li><p><b>Onsite</b>: If this position is listed as onsite, work will primarily be performed at a Booz Allen office or customer facility, where employees will collaborate directly with colleagues and customers as required by the role.</p></li></ul><p></p><p><b>Commitment to Non-Discrimination</b></p><p>All qualified applicants will receive consideration for employment without regard to disability, status as a protected veteran or any other status protected by applicable federal, state, local, or international law.</p><p style=\"text-align:inherit\"></p><p style=\"text-align:inherit\"></p>","compensation":[],"custom_fields":{"can_apply":true,"country":{"descriptor":"United States of America","id":"bc33aa3152ec42d4995f4791a106ed09"},"posted_on":"Posted 6 Days Ago"},"status":"open","first_seen_at":"2026-08-20T06:16:39.881Z","last_seen_at":"2026-08-25T02:30:45.417Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":true,"tier":"stretch","score":2,"level":"unspecified","term":null,"tracks":[],"role_matches":["Solutions Engineer"],"early_career_matches":[],"positive_matches":[],"exclude_matches":[],"configured_tracks":["consulting-ai","enterprise-ai"]}}

{"schema_version":1,"job_key":"greenhouse:andurilindustries:5153187007","source":{"type":"greenhouse","board":"andurilindustries","job_id":"5153187007","source_url":"https://boards-api.greenhouse.io/v1/boards/andurilindustries/jobs","response_hash":"2905adb86d94f89923ee5dd2c444fd545b851b2a2e4788765f36f5e18eb7d7dc","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Anduril","slug":"anduril","lists":["robotics","ai-ml"],"target_role":null,"fit_tier":null},"title":"2027 Mechanical Engineer Intern","canonical_url":"https://boards.greenhouse.io/andurilindustries/jobs/5153187007?gh_jid=5153187007","apply_url":"https://boards.greenhouse.io/andurilindustries/jobs/5153187007?gh_jid=5153187007","locations":[{"label":"Atlanta, Georgia, United States; Boston, Massachusetts, United States; Broomfield, Colorado, United States; Colorado Springs, Colorado, United States; Costa Mesa, California, United States; Fort Collins, Colorado, United States; Irvine, California, United States; Reston, Virginia, United States; Seattle, Washington, United States"},{"label":"Atlanta, Georgia, United States"},{"label":"Boston, Massachusetts, United States"},{"label":"Broomfield, Colorado, United States"},{"label":"Colorado Springs, Colorado, United States"},{"label":"Costa Mesa, California, United States"},{"label":"Fort Collins, Colorado, United States"},{"label":"Huntsville, Alabama, United States"},{"label":"Irvine, California, United States"},{"label":"Reston, Virginia, United States"},{"label":"Seattle, Washington, United States"}],"workplace_type":"unknown","employment_type":"intern","departments":["Hardware Platform : Core Technology Products "],"teams":[],"language":"en","requisition_id":"10475","internal_job_id":4639981007,"first_published_at":"2026-06-11T13:34:22-04:00","source_updated_at":"2026-08-24T14:07:42-04:00","application_deadline":null,"description_plain":null,"description_html":null,"compensation":[],"custom_fields":{"External Department Name for Job Board":"Internship
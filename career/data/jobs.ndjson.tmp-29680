{"schema_version":1,"job_key":"greenhouse:anthropic:5215130008","source":{"type":"greenhouse","board":"anthropic","job_id":"5215130008","source_url":"https://boards-api.greenhouse.io/v1/boards/anthropic/jobs","response_hash":"b5b85daad35e59cc3917d01e895f71196f3d110b9d476674cf32f19e9b3cf25f","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Anthropic","slug":"anthropic","lists":["ai-ml","ai-infra","research"],"target_role":null,"fit_tier":null},"title":"Senior Data Center Capacity Delivery Manager, AUS","canonical_url":"https://job-boards.greenhouse.io/anthropic/jobs/5215130008","apply_url":"https://job-boards.greenhouse.io/anthropic/jobs/5215130008","locations":[{"label":"Sydney, Australia"},{"label":"Sydney, New South Wales, Australia"}],"workplace_type":"unknown","employment_type":"unknown","departments":["Compute"],"teams":[],"language":"en","requisition_id":"P-4734","internal_job_id":4472286008,"first_published_at":"2026-05-13T16:43:31-04:00","source_updated_at":"2026-08-21T12:50:13-04:00","application_deadline":null,"description_plain":null,"description_html":null,"compensation":[],"custom_fields":{"Location Type":null},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":false,"tier":"stretch","score":0,"level":"manager","term":null,"tracks":[],"role_matches":[],"early_career_matches":[],"positive_matches":[],"exclude_matches":["Senior","Manager"],"configured_tracks":["ai-ml","ai-infra","research"]}}
{"schema_version":1,"job_key":"greenhouse:anthropic:5197549008","source":{"type":"greenhouse","board":"anthropic","job_id":"5197549008","source_url":"https://boards-api.greenhouse.io/v1/boards/anthropic/jobs","response_hash":"d455c4e3628c6033628d3b85cbf85f647d2c0e40ab9f62fc4fdaafa92dfcbf34","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Anthropic","slug":"anthropic","lists":["ai-ml","ai-infra","research"],"target_role":null,"fit_tier":null},"title":"Senior Manager, Accounts Receivable, Credit & Collections","canonical_url":"https://job-boards.greenhouse.io/anthropic/jobs/5197549008","apply_url":"https://job-boards.greenhouse.io/anthropic/jobs/5197549008","locations":[{"label":"San Francisco, CA | New York City, NY | Seattle, WA"},{"label":"San Francisco, California, United States"}],"workplace_type":"unknown","employment_type":"unknown","departments":["Finance"],"teams":[],"language":"en","requisition_id":"262014","internal_job_id":4463867008,"first_published_at":"2026-04-27T16:10:01-04:00","source_updated_at":"2026-08-21T12:50:09-04:00","application_deadline":null,"description_plain":null,"description_html":null,"compensation":[],"custom_fields":{"Location Type":"On-Site"},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":false,"tier":"stretch","score":0,"level":"manager","term":null,"tracks":[],"role_matches":[],"early_career_matches":[],"positive_matches":[],"exclude_matches":["Senior","Manager"],"configured_tracks":["ai-ml","ai-infra","research"]}}
{"schema_version":1,"job_key":"greenhouse:anthropic:5365762008","source":{"type":"greenhouse","board":"anthropic","job_id":"5365762008","source_url":"https://boards-api.greenhouse.io/v1/boards/anthropic/jobs","response_hash":"d36e8550428cdb99ce2b2276639a0ad87106b0ee1e6561843945a2619dc324fd","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Anthropic","slug":"anthropic","lists":["ai-ml","ai-infra","research"],"target_role":null,"fit_tier":null},"title":"Senior Manager, Finance Systems - Treasury","canonical_url":"https://job-boards.greenhouse.io/anthropic/jobs/5365762008","apply_url":"https://job-boards.greenhouse.io/anthropic/jobs/5365762008","locations":[{"label":"San Francisco, CA"},{"label":"San Francisco, California, United States"}],"workplace_type":"unknown","employment_type":"unknown","departments":["Finance"],"teams":[],"language":"en","requisition_id":"266294","internal_job_id":4520409008,"first_published_at":"2026-07-22T11:38:11-04:00","source_updated_at":"2026-08-21T12:50:41-04:00","application_deadline":null,"description_plain":null,"description_html":null,"compensation":[],"custom_fields":{"Location Type":"On-Site"},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":false,"tier":"stretch","score":0,"level":"manager","term":null,"tracks":[],"role_matches":[],"early_career_matches":[],"positive_matches":[],"exclude_matches":["Senior","Manager"],"configured_tracks":["ai-ml","ai-infra","research"]}}

{"schema_version":1,"job_key":"ashby:abridge:aef83f6a-0bc8-4d6a-b310-24415918ee3c","source":{"type":"ashby","board":"abridge","job_id":"aef83f6a-0bc8-4d6a-b310-24415918ee3c","source_url":"https://api.ashbyhq.com/posting-api/job-board/abridge","response_hash":"6eb41a8570939da3dd861959bb2ea186e4f81e3fd9d20f10d8c6aaf89cea29f0","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Abridge","slug":"abridge","lists":["enterprise-ai","founding"],"target_role":null,"fit_tier":null},"title":"Forward Deployed Product Manager","canonical_url":"https://jobs.ashbyhq.com/abridge/aef83f6a-0bc8-4d6a-b310-24415918ee3c","apply_url":"https://jobs.ashbyhq.com/abridge/aef83f6a-0bc8-4d6a-b310-24415918ee3c/application","locations":[{"label":"SF Office","city":"San Francisco","region":"California","country":"USA","remote":null,"hybrid":null}],"workplace_type":"hybrid","employment_type":"full_time","departments":["Builder"],"teams":["Product"],"language":null,"requisition_id":null,"internal_job_id":null,"first_published_at":"2026-06-22T17:17:11.072+00:00","source_updated_at":null,"application_deadline":null,"description_plain":null,"description_html":null,"compensation":[{"type":"salary","summary":"$260K – $290K • Offers Equity","salary_summary":"$260K - $290K","tiers":[{"title":null,"summary":"$260K – $290K • Offers Equity","additional_information":null}]}],"custom_fields":{},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":false,"tier":"stretch","score":2,"level":"manager","term":null,"tracks":["product"],"role_matches":["Forward Deployed"],"early_career_matches":[],"positive_matches":[],"exclude_matches":["Manager"],"configured_tracks":["enterprise-ai","founding"]}}

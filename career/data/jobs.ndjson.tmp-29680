{"schema_version":1,"job_key":"greenhouse:thealleninstitute:8140098","source":{"type":"greenhouse","board":"thealleninstitute","job_id":"8140098","source_url":"https://boards-api.greenhouse.io/v1/boards/thealleninstitute/jobs","response_hash":"3a12e0dde8edd9c1eadf9889bacfdc06bf9d5b16db6f31f8cfd0a42a167f3178","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Allen Institute for AI","slug":"allen-institute-for-ai","lists":["research","ai-ml"],"target_role":null,"fit_tier":null},"title":"Senior Research Engineer","canonical_url":"https://job-boards.greenhouse.io/thealleninstitute/jobs/8140098","apply_url":"https://job-boards.greenhouse.io/thealleninstitute/jobs/8140098","locations":[{"label":"Seattle, WA"},{"label":"Seattle, WA, United States"}],"workplace_type":"unknown","employment_type":"unknown","departments":["Applied Science"],"teams":[],"language":"en","requisition_id":"804","internal_job_id":3522900,"first_published_at":"2026-08-20T14:47:01-04:00","source_updated_at":"2026-08-24T23:54:41-04:00","application_deadline":null,"description_plain":null,"description_html":null,"compensation":[],"custom_fields":{},"status":"open","first_seen_at":"2026-08-20T19:53:19.897Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":false,"tier":"stretch","score":3,"level":"senior","term":null,"tracks":["ai-ml"],"role_matches":["Research Engineer"],"early_career_matches":[],"positive_matches":["Research Engineer"],"exclude_matches":["Senior"],"configured_tracks":["research","ai-ml"]}}
{"schema_version":1,"job_key":"greenhouse:thealleninstitute:7980660","source":{"type":"greenhouse","board":"thealleninstitute","job_id":"7980660","source_url":"https://boards-api.greenhouse.io/v1/boards/thealleninstitute/jobs","response_hash":"6078fa2c219c1ff16aa7865f550da856e3235d4bfe4d5c072ca6858c21d9035c","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Allen Institute for AI","slug":"allen-institute-for-ai","lists":["research","ai-ml"],"target_role":null,"fit_tier":null},"title":"Senior Research Engineer, Olmo + Molmo","canonical_url":"https://job-boards.greenhouse.io/thealleninstitute/jobs/7980660","apply_url":"https://job-boards.greenhouse.io/thealleninstitute/jobs/7980660","locations":[{"label":"Seattle, WA"},{"label":"Seattle, WA, United States"}],"workplace_type":"unknown","employment_type":"unknown","departments":["Research"],"teams":[],"language":"en","requisition_id":"770","internal_job_id":3463615,"first_published_at":"2026-06-05T16:53:42-04:00","source_updated_at":"2026-08-24T23:54:41-04:00","application_deadline":null,"description_plain":null,"description_html":null,"compensation":[],"custom_fields":{},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":false,"tier":"stretch","score":3,"level":"senior","term":null,"tracks":["ai-ml"],"role_matches":["Research Engineer"],"early_career_matches":[],"positive_matches":["Research Engineer"],"exclude_matches":["Senior"],"configured_tracks":["research","ai-ml"]}}

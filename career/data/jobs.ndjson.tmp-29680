{"schema_version":1,"job_key":"greenhouse:akunacapital:8108733","source":{"type":"greenhouse","board":"akunacapital","job_id":"8108733","source_url":"https://boards-api.greenhouse.io/v1/boards/akunacapital/jobs","response_hash":"b8299943f81345dc140625845df37b31d1ecf685003622f484a696b09792e4c3","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Akuna Capital","slug":"akuna-capital","lists":["quant"],"target_role":null,"fit_tier":null},"title":"Operations Analyst","canonical_url":"https://www.akunacapital.com/careers/job/8108733?gh_jid=8108733","apply_url":"https://www.akunacapital.com/careers/job/8108733/?gh_jid=8108733","locations":[{"label":"Chicago, IL"},{"label":"Chicago, Illinois, United States"}],"workplace_type":"unknown","employment_type":"full_time","departments":["Middle Office"],"teams":[],"language":"en","requisition_id":"286","internal_job_id":3512710,"first_published_at":"2026-08-05T10:29:25-04:00","source_updated_at":"2026-08-07T17:20:08-04:00","application_deadline":null,"description_plain":null,"description_html":null,"compensation":[],"custom_fields":{"Employment Type":"Full-time","Careers Site Section":["Experienced"],"Specialty":[],"Experience":"Experienced","Crossfilter":["Business Operations"]},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":false,"tier":"stretch","score":0,"level":"unspecified","term":null,"tracks":[],"role_matches":[],"early_career_matches":[],"positive_matches":[],"exclude_matches":[],"configured_tracks":["quant"]}}
{"schema_version":1,"job_key":"greenhouse:akunacapital:7496414","source":{"type":"greenhouse","board":"akunacapital","job_id":"7496414","source_url":"https://boards-api.greenhouse.io/v1/boards/akunacapital/jobs","response_hash":"75f259638cd06957f68fb389970ac05f2cdf7357e97b698b21fadd496e7f7140","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Akuna Capital","slug":"akuna-capital","lists":["quant"],"target_role":null,"fit_tier":null},"title":"Performance Engineer","canonical_url":"https://www.akunacapital.com/careers/job/7496414?gh_jid=7496414","apply_url":"https://www.akunacapital.com/careers/job/7496414/?gh_jid=7496414","locations":[{"label":"Chicago, IL"},{"label":"Chicago, Illinois, United States"}],"workplace_type":"unknown","employment_type":"full_time","departments":["Perf Eng"],"teams":[],"language":"en","requisition_id":"255","internal_job_id":3325448,"first_published_at":"2026-01-02T11:31:19-05:00","source_updated_at":"2026-07-13T13:29:51-04:00","application_deadline":null,"description_plain":null,"description_html":null,"compensation":[],"custom_fields":{"Employment Type":"Full-time","Careers Site Section":["Experienced"],"Specialty":["C++","NETWORKS","PYTHON"],"Experience":"Experienced","Crossfilter":["Development","Quantitative"]},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":false,"tier":"stretch","score":0,"level":"unspecified","term":null,"tracks":[],"role_matches":[],"early_career_matches":[],"positive_matches":[],"exclude_matches":[],"configured_tracks":["quant"]}}
{"schema_version":1,"job_key":"greenhouse:akunacapital:7974805","source":{"type":"greenhouse","board":"akunacapital","job_id":"7974805","source_url":"https://boards-api.greenhouse.io/v1/boards/akunacapital/jobs","response_hash":"a4e7f77bc285b09110c7ecdcc2d712184e5cc55dbf61c23fd2af12b5393b0314","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Akuna Capital","slug":"akuna-capital","lists":["quant"],"target_role":null,"fit_tier":null},"title":"Platform Engineer","canonical_url":"https://www.akunacapital.com/careers/job/7974805?gh_jid=7974805","apply_url":"https://www.akunacapital.com/careers/job/7974805/?gh_jid=7974805","locations":[{"label":"Remote"},{"label":"Chicago, Illinois, United States"}],"workplace_type":"remote","employment_type":"full_time","departments":["Platform"],"teams":[],"language":"en","requisition_id":"280","internal_job_id":3461347,"first_published_at":"2026-06-16T15:23:51-04:00","source_updated_at":"2026-08-07T12:40:14-04:00","application_deadline":null,"description_plain":"About Akuna:\n\nAkuna Capital is an innovative trading firm with a strong focus on collaboration, cutting-edge technology, data driven solutions , and automation. We specialize in providing liquidity as an options market maker – meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully , we design and implement our own low latency technologies, trading strategies , and mathematical models.\n\nOur Founding Partners first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to operate from additional offices in Sydney, Shanghai, London, and Singapore .\n\nWhat you’ll do as a Platform Engineer at Akuna:\n\nThis is an exciting role where you will be given the opportunity to take ownership of projects and make them your own. At Akuna, we are constantly looking for ways to improve our efficiency as we continue to grow. As a Platform Engineer, you will work closely with our Trading, Development, Infrastructure, and Operations teams. You will design and implement cloud solutions, automate infrastructure as code, improve cloud governance and security, and monitor our hybrid-cloud environments. I n this role, you will:\n\n- Ensure cloud services are leveraged to their full potential (AWS, Azure, Google Cloud) and best practices are being followed\n\n- Help manage our public cloud growth and continuously improve Akuna’s hybrid-cloud operating model\n\n- Evaluate proposed solution architectures and provide recommendations\n\n- Provision, configure, upgrade, and monitor technologies such as Kubernetes (EKS and on-premise), Spark, Kafka, and other large-scale distributed databases\n\n- Automate infrastructure management and development pipelines with tools like Terraform, Ansible, Jenkins and GitLab\n\n- Explore new technologies in the cloud-native/container ecosystem\n\n- Work with Infrastructure and Development teams to monitor systems, clusters and cloud deployments to detect errors and monitor performance\n\n- Adhere to the engineering mindset of creating and maintaining performant and reliable production systems\n\nQualities that make great candidates:\n\n- Bachelor's degree in Computer Science, Engineering, or a related field\n\n- 3+ years of experience in Platform Engineering, Cloud Engineering, SRE, DevOps, or related infrastructure roles\n\n- This role is available hybrid from our Chicago office or fully remote.\n\n- AWS Certified Solutions Architect certification preferred\n\n- Deep experience deploying, operating, and scaling Kubernetes in production, including on-premise clusters and Amazon EKS\n\n- Strong expertise designing and managing cloud infrastructure on AWS; experience with GCP is a plus\n\n- Advanced proficiency with Terraform and Infrastructure as Code (IaC), including reusable module development, state management, and platform automation\n\n- Experience building and operating highly available, scalable, and secure cloud-native platforms\n\n- Strong knowledge of observability, including monitoring, logging, alerting, and operational troubleshooting\n\n- Proven experience designing and maintaining CI/CD pipelines and modern software delivery practices\n\n- Strong Linux systems administration and troubleshooting skills in distributed production environments\n\n- Proficiency in automation and scripting with Python, Bash, or similar languages\n\n- Experience with cloud-native data services, including Amazon RDS, Aurora, Redshift, and DynamoDB\n\n- Demonstrated ability to lead technical initiatives, influence architectural decisions, and mentor engineers\n\n- Strong communication and collaboration skills, with experience partnering across engineering, operations, and business teams\n\n- The ability to react quickly and accurately to rapidly changing market conditions, including the ability to quickly and accurately respond and/or solve math and coding problems are essential functions of the role\n\nIn addition to technical skillsets, Akuna values the unique perspectives people can bring to the table to collaboratively solve complex problems and drive Akuna forward. We want everyone to feel empowered to apply. We welcome your application and encourage you to take the first steps toward your future with us!\n\nPlease note that level/title will be determined upon the conclusion of the interview process. If you are a current student or recent graduate, please take a look at our Entry Level and Intern positions.\n\nIn accordance with Illinois Equal Pay Act, the minimum base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. This role is also eligible for a discretionary performance bonus as part of the total compensation package and includes a comprehensive benefits package that may encompass employer-paid medical, dental, vision, retirement contributions, paid time off, and other benefits. The minimum base salary herein was determined in good faith by Akuna Capital LLC.","description_html":"<p><strong><span data-contrast=\"auto\">About Akuna:</span></strong><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:200,&quot;335559740&quot;:276}\">&nbsp;</span></p>\n<p><span data-contrast=\"auto\"><span data-ccp-parastyle=\"Normal (Web)\">Akuna Capital&nbsp;</span><span data-ccp-parastyle=\"Normal (Web)\">is an innovative</span><span data-ccp-parastyle=\"Normal (Web)\">&nbsp;trading firm with a strong focus on collaboration,&nbsp;</span><span data-ccp-parastyle=\"Normal (Web)\">cutting-edge</span><span data-ccp-parastyle=\"Normal (Web)\">&nbsp;technology, data driven solutions</span><span data-ccp-parastyle=\"Normal (Web)\">,</span><span data-ccp-parastyle=\"Normal (Web)\"> and automation. We specialize in providing liquidity as an options market maker – meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully</span><span data-ccp-parastyle=\"Normal (Web)\">,</span><span data-ccp-parastyle=\"Normal (Web)\">&nbsp;we design and implement our own low latency technologies, trading strategies</span><span data-ccp-parastyle=\"Normal (Web)\">,</span><span data-ccp-parastyle=\"Normal (Web)\">&nbsp;and mathematical models.</span></span><span data-ccp-props=\"{&quot;134233117&quot;:true,&quot;134233118&quot;:false,&quot;201341983&quot;:2,&quot;335557856&quot;:16777215,&quot;335559739&quot;:300,&quot;335559740&quot;:350}\">&nbsp;</span></p>\n<p><span data-contrast=\"auto\"><span data-ccp-parastyle=\"Normal (Web)\">Our Founding Partners</span></span><em><span data-contrast=\"auto\"><span data-ccp-parastyle=\"Normal (Web)\">&nbsp;</span></span></em><span data-contrast=\"auto\"><span data-ccp-parastyle=\"Normal (Web)\">first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to&nbsp;</span><span data-ccp-parastyle=\"Normal (Web)\">operate</span><span data-ccp-parastyle=\"Normal (Web)\">&nbsp;from&nbsp;</span><span data-ccp-parastyle=\"Normal (Web)\">additional</span><span data-ccp-parastyle=\"Normal (Web)\">&nbsp;offices in Sydney, Shanghai,&nbsp;</span><span data-ccp-parastyle=\"Normal (Web)\">London,&nbsp;</span><span data-ccp-parastyle=\"Normal (Web)\">and</span><span data-ccp-parastyle=\"Normal (Web)\"> Singapore</span><span data-ccp-parastyle=\"Normal (Web)\">.</span></span><span data-ccp-props=\"{&quot;134233117&quot;:true,&quot;134233118&quot;:false,&quot;201341983&quot;:2,&quot;335557856&quot;:16777215,&quot;335559739&quot;:300,&quot;335559740&quot;:350}\">&nbsp;</span></p>\n<p><strong><span data-contrast=\"auto\">What&nbsp;you’ll&nbsp;do as a&nbsp;Platform Engineer&nbsp;at Akuna:</span></strong><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:200,&quot;335559740&quot;:276,&quot;469777462&quot;:[9360],&quot;469777927&quot;:[0],&quot;469777928&quot;:[4]}\">&nbsp;</span></p>\n<p><span data-contrast=\"none\">This is an exciting role where you will be given the opportunity to take ownership of projects and make them your own. At Akuna, we are constantly looking for ways to improve our efficiency as we continue to grow. As a Platform Engineer, you will work closely with our Trading, Development, Infrastructure, and Operations teams. You will design and implement cloud solutions, automate infrastructure as code, improve cloud governance and security, and&nbsp;monitor&nbsp;our hybrid-cloud environments. I</span><span data-contrast=\"auto\">n this role, you will:</span><span data-ccp-props=\"{&quot;201341983&quot;:2,&quot;335557856&quot;:16777215,&quot;335559739&quot;:0,&quot;335559740&quot;:330}\">&nbsp;</span></p>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"none\">Ensure cloud services are leveraged to their full potential (AWS, Azure, Google Cloud) and best practices are being followed</span></li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\">Help manage our public cloud growth and continuously improve Akuna’s hybrid-cloud operating model</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\">Evaluate proposed solution architectures and provide recommendations</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\">Provision, configure, upgrade, and monitor technologies such as Kubernetes (EKS and on-premise), Spark, Kafka, and other large-scale distributed databases</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\">Automate infrastructure management and development pipelines with tools like Terraform, Ansible, Jenkins and GitLab</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\">Explore new technologies in the cloud-native/container ecosystem</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\">Work with Infrastructure and Development teams to monitor systems, clusters and cloud deployments to detect errors and monitor performance</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\">Adhere to the engineering mindset of creating and maintaining performant and reliable production systems</li>\n</ul>\n<p><strong><span data-contrast=\"auto\">Qualities that make great candidates:</span></strong><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:200,&quot;335559740&quot;:276}\">&nbsp;</span></p>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"9\" data-aria-level=\"1\"><span data-contrast=\"auto\">Bachelor's degree in Computer Science, Engineering, or a related field</span></li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"9\" data-aria-level=\"1\">3+ years of experience in Platform Engineering, Cloud Engineering, SRE, DevOps, or related infrastructure roles</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"9\" data-aria-level=\"1\">This role is available hybrid from our Chicago office or fully remote.</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"9\" data-aria-level=\"1\">AWS Certified Solutions Architect certification preferred</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"9\" data-aria-level=\"1\">Deep experience deploying, operating, and scaling Kubernetes in production, including on-premise clusters and Amazon EKS</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"9\" data-aria-level=\"1\">Strong expertise designing and managing cloud infrastructure on AWS; experience with GCP is a plus</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"9\" data-aria-level=\"1\">Advanced proficiency with Terraform and Infrastructure as Code (IaC), including reusable module development, state management, and platform automation</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"9\" data-aria-level=\"1\">Experience building and operating highly available, scalable, and secure cloud-native platforms</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"9\" data-aria-level=\"1\">Strong knowledge of observability, including monitoring, logging, alerting, and operational troubleshooting<span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:200,&quot;335559740&quot;:276}\">&nbsp;</span></li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"9\" data-aria-level=\"1\">Proven experience designing and maintaining CI/CD pipelines and modern software delivery practices</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"9\" data-aria-level=\"1\">Strong Linux systems administration and troubleshooting skills in distributed production environments<span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:200,&quot;335559740&quot;:276}\">&nbsp;</span></li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"9\" data-aria-level=\"1\">Proficiency in automation and scripting with Python, Bash, or similar languages</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"9\" data-aria-level=\"1\">Experience with cloud-native data services, including Amazon RDS, Aurora, Redshift, and DynamoDB</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"9\" data-aria-level=\"1\">Demonstrated ability to lead technical initiatives, influence architectural decisions, and mentor engineers</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"9\" data-aria-level=\"1\">Strong communication and collaboration skills, with experience partnering across engineering, operations, and business teams</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"9\" data-aria-level=\"1\"><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:200,&quot;335559740&quot;:276}\">The ability to react quickly and accurately to rapidly changing market conditions, including the ability to quickly and accurately respond and/or solve math and coding problems are essential functions of the role</span></li>\n</ul>\n<p><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:240}\"><strong><em>In addition to technical skillsets, Akuna values the unique perspectives people can bring to the table to collaboratively solve complex problems and drive Akuna forward. We want everyone to feel empowered to apply. We welcome your application and encourage you to take the first steps toward your future with us!</em></strong></span></p>\n<p><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:240}\"><em><span data-contrast=\"none\">Please note that level/title will be determined upon the conclusion of the interview process. If you are a current student or recent graduate, please take a look at our Entry Level and Intern positions.</span></em><span data-contrast=\"none\">&nbsp;</span></span></p>\n<p><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:240}\"><span data-contrast=\"none\"><em>In accordance with Illinois Equal Pay Act, the minimum base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. This role is also eligible for a discretionary performance bonus as part of the total compensation package and includes a comprehensive benefits package that may encompass employer-paid medical, dental, vision, retirement contributions, paid time off, and other benefits. The minimum base salary herein was determined in good faith by Akuna Capital LLC.</em></span></span></p>","compensation":[],"custom_fields":{"Employment Type":"Full-time","Careers Site Section":["Experienced"],"Specialty":["DEVOPS","LINUX","PYTHON","SYSTEMS"],"Experience":"Experienced","Crossfilter":["Development","IT Infrastructure"]},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":true,"tier":"stretch","score":3,"level":"unspecified","term":null,"tracks":["software"],"role_matches":["Platform Engineer"],"early_career_matches":[],"positive_matches":["Platform"],"exclude_matches":[],"configured_tracks":["quant"]}}
{"schema_version":1,"job_key":"greenhouse:akunacapital:8018856","source":{"type":"greenhouse","board":"akunacapital","job_id":"8018856","source_url":"https://boards-api.greenhouse.io/v1/boards/akunacapital/jobs","response_hash":"987be4bebadf8192c2587daa5dc3794e071c2f3b0a9b2c7130cfa49f53e52235","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Akuna Capital","slug":"akuna-capital","lists":["quant"],"target_role":null,"fit_tier":null},"title":"Platform Engineer Intern, Summer 2027","canonical_url":"https://www.akunacapital.com/careers/job/8018856?gh_jid=8018856","apply_url":"https://www.akunacapital.com/careers/job/8018856/?gh_jid=8018856","locations":[{"label":"Chicago, IL"},{"label":"Chicago, Illinois, United States"}],"workplace_type":"unknown","employment_type":"intern","departments":["Engineering"],"teams":[],"language":"en","requisition_id":null,"internal_job_id":3476458,"first_published_at":"2026-07-13T14:21:52-04:00","source_updated_at":"2026-07-14T14:28:52-04:00","application_deadline":null,"description_plain":"About Akuna:\n\nAkuna Capital is an innovative trading firm with a strong focus on collaboration, cutting-edge technology, data driven solutions, and automation. We specialize in providing liquidity as an options market maker, meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully, we design and implement our own low latency technologies, trading strategies, and mathematical models.\n\nOur Founding Partners first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to operate from additional offices in Sydney, Shanghai, Singapore, and London.\n\nWhat you’ll do as a Platform Engineer Intern at Akuna:\n\nWe are seeking Platform Engineer Interns to join our innovative and growing technology team for our 10-week Akunacademy internship program. You will work within the Platform Engineering Team, gaining expertise through building highly automated operations while monitoring and managing the operational capabilities of systems at Akuna. Each intern takes full ownership of their project, and at the end of the program, has the opportunity to present their work and accomplishments. In this role, you will:\n\n- Support and design the ongoing growth, design, and expansion of our Platform offerings to meet the needs of our internal stakeholders with scalable, reliable, and highly available systems\n\n- Work with our steam aligned and partner platform teams to develop our hybrid cloud platform\n\n- Produce clean, well-tested, and documented code with a clear design to support production infrastructure and systems\n\n- Challenge the status quo and help push our organization forward, as we grow beyond the limits of our current tech stack\n\nRequirements for this role:\n\n- Pursuing a bachelor’s, master’s, or Ph.D. in a technical field (computer science/engineering, math, physics, or equivalent)\n\n- Graduating by August 2028\n\n- Major GPA of 3.5 or above\n\n- Legal authorization to work in the U.S. is required on the first day of employment including F-1 students using OPT or STEM\n\nPrevious experience in finance or trading is not required. Many of our engineers joined Akuna with little-to-no prior knowledge of the markets, and we pride ourselves on our ability to onboard those new to the industry. Training and continuous education are provided for all engineers to ensure they can build the requisite technical and non-technical skillset for success.\n\nQualities that make great candidates:\n\n- Experience with Infrastructure as Code (IaC), Kubernetes, and AWS Cloud\n\n- Experience with cloud computing, networking, data engineering and security\n\n- Ability to react quickly and accurately to rapidly changing market conditions, including the ability to quickly and accurately respond and/or solve math and coding problems, is an essential function of the role\n\nIn addition to the above technical skills, Akuna values diversity of experience and perspective. We believe that engineers with varied backgrounds and interests allow us to approach problems from unique angles and to uncover innovative, optimal solutions. We want everyone to feel empowered to apply; we welcome your application, and we strongly encourage you to take the first steps in joining us in the future!\n\n**Resumes must be submitted in PDF format.\n\nBy applying to this role, you are indicating this is your top preference and acknowledge you will not be considered for other Quant and/or Tech roles at Akuna this recruiting season. This acknowledgement does not limit applications to Trading roles - in addition to this role, you may apply to any Trader roles of interest.\n\nWe are an AI-friendly company and encourage employees to leverage AI in their daily work. However, AI assistance is not permitted during interviews or assessments . Our interview process is designed to evaluate your individual skills and judgment , and the use of AI tools will result in disqualification from the hiring process.\n\nIn accordance with the Illinois Equal Pay Act, the minimum annualized base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. The minimum base salary herein was determined in good faith by Akuna Capital LLC.","description_html":"<p><strong><span data-contrast=\"none\">About Akuna:</span></strong><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<p><span data-contrast=\"none\">Akuna Capital is an innovative trading firm with a strong focus on collaboration,&nbsp;cutting-edge&nbsp;technology, data driven solutions, and automation. We specialize in providing liquidity as an options market&nbsp;maker,&nbsp;meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully, we design and implement our own low latency technologies, trading&nbsp;strategies,&nbsp;and mathematical models.&nbsp;</span><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<p><span data-contrast=\"none\">Our Founding Partners</span><em><span data-contrast=\"none\">&nbsp;</span></em><span data-contrast=\"none\">first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to&nbsp;operate&nbsp;from&nbsp;additional&nbsp;offices in Sydney, Shanghai, Singapore, and London.</span><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<p><strong><span data-contrast=\"none\">What&nbsp;you’ll&nbsp;do as a Platform Engineer Intern at Akuna:</span></strong><span data-contrast=\"none\">&nbsp;</span><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<p><span data-contrast=\"none\">We are seeking Platform Engineer Interns to join our innovative and growing technology team for our 10-week&nbsp;Akunacademy&nbsp;internship program.&nbsp;You will&nbsp;work within the Platform Engineering&nbsp;Team, gaining&nbsp;expertise&nbsp;through building highly automated&nbsp;operations while&nbsp;monitoring&nbsp;and managing the operational capabilities of systems at Akuna.&nbsp;</span><span data-contrast=\"none\">Each intern takes full ownership of their project, and at the end of the program, has the opportunity to present their work and accomplishments.&nbsp;In this role, you&nbsp;will:&nbsp;</span><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"none\">Support and design the ongoing growth, design, and expansion of our Platform offerings to meet the needs of our internal stakeholders with scalable, reliable, and highly available systems</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"2\" data-aria-level=\"1\"><span data-contrast=\"none\">Work with our steam aligned and partner platform teams to develop our hybrid cloud platform</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"3\" data-aria-level=\"1\"><span data-contrast=\"none\">Produce clean, well-tested, and documented code with a clear design to support&nbsp;production&nbsp;infrastructure and systems&nbsp;</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"4\" data-aria-level=\"1\"><span data-contrast=\"none\">Challenge the status quo and help push our organization forward, as we grow beyond the limits of our current tech stack&nbsp;</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<p><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span><strong><span data-contrast=\"none\">Requirements for this role:</span></strong><span data-ccp-props=\"{&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:278}\">&nbsp;</span></p>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"none\">Pursuing a bachelor’s,&nbsp;master’s, or&nbsp;Ph.D. in a technical field (computer science/engineering, math,&nbsp;physics, or equivalent)</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"2\" data-aria-level=\"1\"><span data-contrast=\"none\">Graduating by August 2028</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"3\" data-aria-level=\"1\"><span data-contrast=\"none\">Major GPA of 3.5 or above</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"4\" data-aria-level=\"1\"><span data-contrast=\"none\">Legal authorization to work in the U.S. is&nbsp;required&nbsp;on the first day of employment including F-1 students using OPT or STEM</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n<p><span data-contrast=\"none\">Previous&nbsp;experience in finance or trading is&nbsp;</span><strong><span data-contrast=\"none\">not</span></strong><span data-contrast=\"none\">&nbsp;required.&nbsp;Many of&nbsp;our&nbsp;engineers&nbsp;joined&nbsp;Akuna with little-to-no&nbsp;prior&nbsp;knowledge&nbsp;of the markets, and we pride ourselves on our ability to onboard those new to the industry. Training and continuous education are provided for all engineers to ensure they can build&nbsp;the requisite technical and non-technical skillset for success.</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559685&quot;:0,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></p>\n<p><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span><strong><span data-contrast=\"none\">Qualities that make great candidates:</span></strong><span data-contrast=\"none\">&nbsp;</span><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"none\">Experience with Infrastructure as Code (IaC), Kubernetes,&nbsp;and AWS Cloud&nbsp;</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"2\" data-aria-level=\"1\"><span data-contrast=\"none\">Experience with cloud computing, networking, data&nbsp;engineering&nbsp;and security</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"3\" data-aria-level=\"1\"><span data-contrast=\"none\">Ability to react quickly and accurately to rapidly changing market conditions, including the ability to quickly and accurately respond and/or solve math and coding problems, is an&nbsp;essential function of the role</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<p><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span><span data-contrast=\"none\">In addition to the above technical skills, Akuna&nbsp;values diversity of experience and perspective. We believe that&nbsp;engineers with&nbsp;varied backgrounds and interests allow&nbsp;us to&nbsp;approach problems from&nbsp;unique&nbsp;angles&nbsp;and&nbsp;to&nbsp;uncover innovative,&nbsp;optimal&nbsp;solutions.&nbsp;We want everyone to feel empowered to apply; we welcome your application, and we strongly encourage you to take the first steps in joining us&nbsp;in the future!</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559685&quot;:0,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></p>\n<p><strong><span data-contrast=\"none\">**Resumes must be&nbsp;submitted&nbsp;in PDF format.</span></strong><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<p><span data-contrast=\"none\">By&nbsp;applying&nbsp;to this role, you are&nbsp;indicating&nbsp;this is your top preference and acknowledge you will not be considered for other Quant and/or Tech roles at&nbsp;Akuna&nbsp;this recruiting season. This acknowledgement does not limit applications to Trading roles - in addition to this role, you may apply to any Trader roles of interest.</span><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<p><span data-ccp-props=\"{}\">We are an AI-friendly company and encourage employees to leverage AI in their daily work. However, AI assistance is not permitted during interviews or assessments<span data-renderer-mark=\"true\">. Our interview process is designed to evaluate your individual skills and judgment</span>, <strong data-renderer-mark=\"true\">and the use of AI tools will result in disqualification from the hiring process.</strong></span></p>\n<p><em><span data-contrast=\"none\">In accordance with&nbsp;the Illinois&nbsp;Equal Pay Act, the&nbsp;minimum&nbsp;annualized base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. The minimum base salary&nbsp;herein&nbsp;was&nbsp;determined&nbsp;in good faith by Akuna Capital LLC.</span></em><span data-ccp-props=\"{}\">&nbsp;</span></p>","compensation":[],"custom_fields":{"Employment Type":"Intern","Careers Site Section":["Student - Intern - Summer"],"Specialty":[],"Experience":"Intern","Crossfilter":["Engineering"]},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":true,"tier":"target","score":13,"level":"intern","term":"summer_2027","tracks":["software"],"role_matches":["Platform Engineer"],"early_career_matches":["Intern","2027"],"positive_matches":["Intern","2027","Platform"],"exclude_matches":[],"configured_tracks":["quant"]}}
{"schema_version":1,"job_key":"greenhouse:akunacapital:7200888","source":{"type":"greenhouse","board":"akunacapital","job_id":"7200888","source_url":"https://boards-api.greenhouse.io/v1/boards/akunacapital/jobs","response_hash":"68ac93785b3ca815dcd010ce7b387f03fc192ec1d0addbf115b9becff673b0b1","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Akuna Capital","slug":"akuna-capital","lists":["quant"],"target_role":null,"fit_tier":null},"title":"Project Manager","canonical_url":"https://www.akunacapital.com/careers/job/7200888?gh_jid=7200888","apply_url":"https://www.akunacapital.com/careers/job/7200888/?gh_jid=7200888","locations":[{"label":"Chicago, IL"},{"label":"Chicago, Illinois, United States"}],"workplace_type":"unknown","employment_type":"full_time","departments":["Project Management"],"teams":[],"language":"en","requisition_id":"240","internal_job_id":3219639,"first_published_at":"2025-08-27T11:11:45-04:00","source_updated_at":"2026-07-13T13:29:51-04:00","application_deadline":null,"description_plain":null,"description_html":null,"compensation":[],"custom_fields":{"Employment Type":"Full-time","Careers Site Section":["Experienced"],"Specialty":["PROJECT MANAGEMENT"],"Experience":"Experienced","Crossfilter":[]},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":false,"tier":"stretch","score":0,"level":"manager","term":null,"tracks":[],"role_matches":[],"early_career_matches":[],"positive_matches":[],"exclude_matches":["Manager"],"configured_tracks":["quant"]}}
{"schema_version":1,"job_key":"greenhouse:akunacapital:6812905","source":{"type":"greenhouse","board":"akunacapital","job_id":"6812905","source_url":"https://boards-api.greenhouse.io/v1/boards/akunacapital/jobs","response_hash":"03ba2a2fa100b42212cdb34ed98012349dec1eea9e39a329e4009de877063a25","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Akuna Capital","slug":"akuna-capital","lists":["quant"],"target_role":null,"fit_tier":null},"title":"Quant Strategist","canonical_url":"https://www.akunacapital.com/careers/job/6812905?gh_jid=6812905","apply_url":"https://www.akunacapital.com/careers/job/6812905/?gh_jid=6812905","locations":[{"label":"Chicago, IL"},{"label":"Chicago, Illinois, United States"}],"workplace_type":"unknown","employment_type":"full_time","departments":["Quant Strategy"],"teams":[],"language":"en","requisition_id":"232","internal_job_id":3125112,"first_published_at":"2025-07-25T17:07:45-04:00","source_updated_at":"2026-07-13T13:29:51-04:00","application_deadline":null,"description_plain":"About Akuna:\n\nAkuna Capital is an innovative trading firm with a strong focus on collaboration, cutting-edge technology, data driven solutions, and automation. We specialize in providing liquidity as an options market maker – meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully, we design and implement our own low latency technologies, trading strategies, and mathematical models.\n\nOur Founding Partners first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to operate from additional offices in Sydney, Shanghai, London, and Singapore.\n\nWhat you’ll do as a Quantitative Strategist at Akuna:\n\nAkuna's Quantitative Trading and Research team is looking to add Quant Strategists to a team of mathematicians, statisticians and technologists. The successful candidate will play a crucial role in developing and enhancing our trading strategies by leveraging quantitative expertise and a deep understanding of financial markets. This position offers the opportunity to make a direct impact on our trading decisions and overall performance. The ideal candidate will possess strong programming skills, a creative mindset, and a passion for the intricacies of financial markets. In this role you will:\n\n- Design and develop production code for trading strategies, including pricing models, execution logic, and performance optimization while collaborating closely with researchers, traders, and system engineers.\n\n- Analyze and incorporate market signals into our trading systems to enhance decision-making and performance outcomes.\n\n- Advance our existing codebase by proposing new solutions, optimizations, and improvements that align with trading goals.\n\n- Participate in the rapid prototyping of cutting-edge trading solutions driven by quantitative analysis and market research.\n\n- Stay ahead of industry trends and developments in financial markets to inform strategy adjustments and innovations.\n\n- Respond quickly and accurately to rapidly changing market conditions, solving mathematical and coding challenges as they arise.\n\n- Engage in ongoing learning and development to deepen understanding of financial markets and enhance strategic initiatives.\n\nQualities that make great candidates:\n\n- Bachelor’s, Master’s, or PhD degree in a technical field, such as Engineering, Computer Science, Mathematics, or Physics (or a related subject), with degree completion required upon employment.\n\n- 3+ years of experience in a quantitative or programming role, preferably within the finance or trading sectors.\n\n- Proficient programming skills in Python (C++ is a plus)\n\n- Desire and ability to learn the complexities of financial markets and trading mechanisms.\n\n- Deep understanding of fields such as Linear Algebra, Numerical Methods, Statistics, Optimization, Signal Processing, Computer Architecture, Machine Learning, and Heterogeneous/High-Performance Computing.\n\n- Exceptional analytical and problem-solving skills, with the ability to react quickly and effectively to rapidly changing market conditions.\n\n- Strong interest in financial markets and trading is highly valued.\n\n- The ability to react quickly and accurately to rapidly changing market conditions, including the ability to quickly and accurately respond and/or solve math and coding problems are essential functions of the role\n\nIn addition to technical skillsets, Akuna values the unique perspectives people can bring to the table to collaboratively solve complex problems and drive Akuna forward. We want everyone to feel empowered to apply. We welcome your application and encourage you to take the first steps toward your future with us!\n\nIn accordance with Illinois Equal Pay Act, the minimum base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. This role is also eligible for a discretionary performance bonus as part of the total compensation package and includes a comprehensive benefits package that may encompass employer-paid medical, dental, vision, retirement contributions, paid time off, and other benefits. The minimum base salary herein was determined in good faith by Akuna Capital LLC.","description_html":"<p><strong><span data-contrast=\"none\">About Akuna:</span></strong><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:200,&quot;335559740&quot;:276}\">&nbsp;</span></p>\n<p><span data-contrast=\"none\">Akuna Capital is an innovative trading firm with a strong focus on collaboration, cutting-edge technology, data driven solutions, and automation. We specialize in providing liquidity as an options market maker – meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully, we design and implement our own low latency technologies, trading strategies, and mathematical models.</span><span data-ccp-props=\"{&quot;134233117&quot;:true,&quot;201341983&quot;:2,&quot;335559739&quot;:300,&quot;335559740&quot;:350}\">&nbsp;</span></p>\n<p><span data-contrast=\"none\">Our Founding Partners</span><em> </em><span data-contrast=\"none\">first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to operate from additional offices in Sydney, Shanghai, London, and Singapore.</span><span data-ccp-props=\"{&quot;134233117&quot;:true,&quot;201341983&quot;:2,&quot;335559739&quot;:300,&quot;335559740&quot;:350}\">&nbsp;</span></p>\n<p><strong><span data-contrast=\"none\">What you’ll do as a Quantitative Strategist at Akuna:</span></strong><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:200,&quot;335559740&quot;:276}\">&nbsp;</span></p>\n<p><span data-contrast=\"none\">Akuna's Quantitative Trading and Research team is looking to add Quant Strategists to a team of mathematicians, statisticians and technologists. </span><span data-contrast=\"auto\">The successful candidate will play a crucial role in developing and enhancing our trading strategies by leveraging quantitative expertise and a deep understanding of financial markets. This position offers the opportunity to make a direct impact on our trading decisions and overall performance. The ideal candidate will possess strong programming skills, a creative mindset, and a passion for the intricacies of financial markets. In this role you will:</span><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">Design and develop production code for trading strategies, including pricing models, execution logic, and performance optimization while collaborating closely with researchers, traders, and system engineers.</span></li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">Analyze and incorporate market signals into our trading systems to enhance decision-making and performance outcomes.</span></li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">Advance our existing codebase by proposing new solutions, optimizations, and improvements that align with trading goals.</span></li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">Participate in the rapid prototyping of cutting-edge trading solutions driven by quantitative analysis and market research.</span></li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">Stay ahead of industry trends and developments in financial markets to inform strategy adjustments and innovations.</span></li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">Respond quickly and accurately to rapidly changing market conditions, solving mathematical and coding challenges as they arise.</span></li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">Engage in ongoing learning and development to deepen understanding of financial markets and enhance strategic initiatives.</span><span data-ccp-props=\"{}\">&nbsp;</span></li>\n</ul>\n<p><strong><span data-contrast=\"none\">Qualities that make great candidates:</span></strong><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:200,&quot;335559740&quot;:276}\">&nbsp;</span></p>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">Bachelor’s, Master’s, or PhD degree in a technical field, such as Engineering, Computer Science, Mathematics, or Physics (or a related subject), with degree completion required upon employment.&nbsp;</span></li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">3+ years of experience in a quantitative or programming role, preferably within the finance or trading sectors.</span></li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">Proficient programming skills in Python (C++ is a plus)&nbsp;</span></li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">Desire and ability to learn the complexities of financial markets and trading mechanisms.</span></li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">Deep understanding of fields such as Linear Algebra, Numerical Methods, Statistics, Optimization, Signal Processing, Computer Architecture, Machine Learning, and Heterogeneous/High-Performance Computing.</span></li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">Exceptional analytical and problem-solving skills, with the ability to react quickly and effectively to rapidly changing market conditions.</span></li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">Strong interest in financial markets and trading is highly valued.</span></li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">The ability to react quickly and accurately to rapidly changing market conditions, including the ability to quickly and accurately respond and/or solve math and coding problems are essential functions of the role &nbsp;</span><span data-ccp-props=\"{}\">&nbsp;</span></li>\n</ul>\n<p><strong><em>In addition to technical skillsets, Akuna values the unique perspectives people can bring to the table to collaboratively solve complex problems and drive Akuna forward. We want everyone to feel empowered to apply. We welcome your application and encourage you to take the first steps toward your future with us!</em></strong></p>\n<p><em>In accordance with Illinois Equal Pay Act, the minimum base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. This role is also eligible for a discretionary performance bonus as part of the total compensation package and includes a comprehensive benefits package that may encompass employer-paid medical, dental, vision, retirement contributions, paid time off, and other benefits. The minimum base salary herein was determined in good faith by Akuna Capital LLC.</em></p>","compensation":[],"custom_fields":{"Employment Type":"Full-time","Careers Site Section":["Experienced"],"Specialty":["QUANT TRADING"],"Experience":"Experienced","Crossfilter":["Quantitative"]},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":true,"tier":"stretch","score":3,"level":"unspecified","term":null,"tracks":["quant"],"role_matches":["Quant"],"early_career_matches":[],"positive_matches":["Quant"],"exclude_matches":[],"configured_tracks":["quant"]}}
{"schema_version":1,"job_key":"greenhouse:akunacapital:8021481","source":{"type":"greenhouse","board":"akunacapital","job_id":"8021481","source_url":"https://boards-api.greenhouse.io/v1/boards/akunacapital/jobs","response_hash":"79ab6cb1e7d685122723bd0aae3b4f2ca80a23e29dbf7af2208f66c3052e6b36","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Akuna Capital","slug":"akuna-capital","lists":["quant"],"target_role":null,"fit_tier":null},"title":"Quantitative Development & Strategy Intern, Summer 2027","canonical_url":"https://www.akunacapital.com/careers/job/8021481?gh_jid=8021481","apply_url":"https://www.akunacapital.com/careers/job/8021481/?gh_jid=8021481","locations":[{"label":"Chicago, IL"},{"label":"Chicago, Illinois, United States"}],"workplace_type":"unknown","employment_type":"intern","departments":["Quant"],"teams":[],"language":"en","requisition_id":null,"internal_job_id":3477557,"first_published_at":"2026-07-13T14:29:20-04:00","source_updated_at":"2026-08-05T16:39:01-04:00","application_deadline":null,"description_plain":"About Akuna:\n\nAkuna Capital is an innovative trading firm with a strong focus on collaboration, cutting-edge technology, data driven solutions, and automation. We specialize in providing liquidity as an options market-maker – meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully, we design and implement our own low latency technologies, trading strategies and mathematical models.\n\nOur Founding Partners first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to operate from additional offices in Sydney, Shanghai, London, and Singapore.\n\nWhat you’ll do as a Quantitative Development & Quantitative Strategy Intern at Akuna:\n\nAkuna’s Quant team creates trading strategies scientifically by combining its quantitative expertise with sophisticated understanding of derivatives and financial markets. The team is looking to add both Quant Development & Quant Strategy Interns to our team for our 10-week Akunacademy internship program who will make a direct and measurable impact on our trading decisions and performance.\n\nThe successful candidate will have a strong programming background, familiarity with mathematical techniques and the fluency to leverage both skills to produce trading solutions and high-performance production code. In these roles you will:\n\n- Design and develop production code of trading strategies: pricing models, execution logic and performance optimization along with researchers, traders and system engineers\n\n- Analyze and incorporate market signals in our trading systems\n\n- Advance existing codebase and propose new solutions and improvements\n\nRequirements for these roles:\n\n- Pursuing a bachelors, masters, or PhD in a technical field – Engineering, Computer Science, Math, Physics (or related subject)\n\n- Strong Python programming background\n\n- Experience in object-oriented programming\n\n- Exposure to linear algebra and introductory statistics\n\n- Desire and ability to learn the intricacies of financial markets\n\n- Must graduate by August 2028\n\n- GPA of 3.5 or above\n\n- Legal authorization to work in the U.S. is required on the first day of employment including F-1 students using CPT, OPT or STEM\n\nQualities that make great candidates:\n\n- Experience with generic and/or parallel programming\n\n- Deeper understanding of any of the following fields: Linear Algebra, Numerical Methods, Statistics, Optimization, Signal Processing, Computer Architecture, Machine Learning, Heterogeneous/High Performance computing\n\n- The ability to react quickly and accurately to rapidly changing market conditions, including the ability to quickly and accurately respond and/or solve math and coding problems are essential functions of the role\n\n- Exposure to financial markets and trading\n\n**Resumes must be submitted in PDF format.\n\nIn addition to technical skillsets, Akuna values the unique perspectives people can bring to the table to collaboratively solve complex problems and drive Akuna forward. We want everyone to feel empowered to apply. We welcome your application and encourage you to take the first steps toward your future with us!\n\nPlease note: By submitting an application for this role, you are indicating this is your top preference and acknowledge you will not be considered for other Quant and/or Tech roles at Akuna this recruiting season. This acknowledgement does not limit applications to Trading roles - in addition to this role, you may apply to any Trader roles of interest.\n\nIn accordance with Illinois Equal Pay Act, the minimum annualized base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. The minimum base salary herein was determined in good faith by Akuna Capital LLC.","description_html":"<p><span style=\"color: rgb(0, 0, 0);\"><strong>About Akuna:</strong></span></p>\n<p><span style=\"color: rgb(0, 0, 0);\"><span data-contrast=\"none\">Akuna Capital is an innovative trading firm with a strong focus on collaboration, cutting-edge technology, data driven solutions, and automation. We specialize in providing liquidity as an options market-maker – meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully, we design and implement our own low latency technologies, trading strategies and mathematical models.</span><span data-ccp-props=\"{&quot;134233117&quot;:true,&quot;134233118&quot;:false,&quot;201341983&quot;:2,&quot;335559739&quot;:300,&quot;335559740&quot;:350}\">&nbsp;</span></span></p>\n<p><span style=\"color: rgb(0, 0, 0);\"><span data-contrast=\"none\">Our Founding Partners</span><em>&nbsp;</em><span data-contrast=\"none\">first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to operate from additional offices in Sydney, Shanghai, London, and Singapore.&nbsp;</span></span></p>\n<p><strong>What you’ll do as a Quantitative Development &amp; Quantitative Strategy Intern at Akuna:</strong></p>\n<p>Akuna’s Quant team creates trading strategies scientifically by combining its quantitative expertise with sophisticated understanding of derivatives and financial markets. The team is looking to add both Quant Development &amp; Quant Strategy Interns to our team for our 10-week Akunacademy internship program who will make a direct and measurable impact on our trading decisions and performance.</p>\n<p>The successful candidate will have a strong programming background, familiarity with mathematical techniques and the fluency to leverage both skills to produce trading solutions and high-performance production code. In these roles you will:</p>\n<ul>\n<li>Design and develop production code of trading strategies: pricing models, execution logic and performance optimization along with researchers, traders and system engineers</li>\n<li>Analyze and incorporate market signals&nbsp;in our trading systems</li>\n<li>Advance existing codebase and propose new solutions and improvements</li>\n</ul>\n<p><strong>Requirements for these roles:</strong></p>\n<ul>\n<li>Pursuing a bachelors, masters, or PhD in a technical field – Engineering, Computer Science, Math, Physics (or related subject)</li>\n<li>Strong Python programming background</li>\n<li>Experience in object-oriented programming</li>\n<li>Exposure to linear algebra and introductory statistics</li>\n<li>Desire and ability to learn the intricacies of financial markets</li>\n<li>Must graduate by August 2028</li>\n<li>GPA of 3.5 or above</li>\n<li>Legal authorization to work in the U.S. is required on the first day of employment including F-1 students using CPT, OPT or STEM</li>\n</ul>\n<p><strong>Qualities that make great candidates:</strong></p>\n<ul>\n<li>Experience with generic and/or parallel programming</li>\n<li>Deeper understanding of any of the following fields: Linear Algebra, Numerical Methods, Statistics, Optimization, Signal Processing, Computer Architecture, Machine Learning, Heterogeneous/High Performance computing</li>\n<li>The ability to react quickly and accurately to rapidly changing market conditions, including the ability to quickly and accurately respond and/or solve math and coding problems are essential functions of the role</li>\n<li>Exposure to financial markets and trading</li>\n</ul>\n<p>**Resumes must be submitted in PDF format.&nbsp;</p>\n<p><strong>In addition to technical skillsets, Akuna values the unique perspectives people can bring to the table to collaboratively solve complex problems and drive Akuna forward. We want everyone to feel empowered to apply. We welcome your application and encourage you to take the first steps toward your future with us!</strong></p>\n<p style=\"font-weight: 400;\"><strong>Please note:</strong> By submitting an application for this role, you are indicating this is your top preference and acknowledge you will not be considered for other Quant and/or Tech roles at Akuna this recruiting season. This acknowledgement does not limit applications to Trading roles - in addition to this role, you may apply to any Trader roles of interest.&nbsp;</p>\n<p style=\"font-weight: 400;\"><em data-stringify-type=\"italic\">In accordance with Illinois Equal Pay Act, the minimum annualized base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. </em><em data-stringify-type=\"italic\">The minimum base salary herein was determined in good faith by Akuna Capital LLC.</em></p>","compensation":[],"custom_fields":{"Employment Type":"Intern","Careers Site Section":["Student - Intern - Summer"],"Specialty":["C++","PYTHON"],"Experience":"Intern","Crossfilter":["Quantitative"]},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":true,"tier":"target","score":13,"level":"intern","term":"summer_2027","tracks":["quant"],"role_matches":["Quantitative"],"early_career_matches":["Intern","2027"],"positive_matches":["Intern","2027","Quantitative"],"exclude_matches":[],"configured_tracks":["quant"]}}
{"schema_version":1,"job_key":"greenhouse:akunacapital:8036614","source":{"type":"greenhouse","board":"akunacapital","job_id":"8036614","source_url":"https://boards-api.greenhouse.io/v1/boards/akunacapital/jobs","response_hash":"455a1b72b7acef03a04d82882363102279a3bcc91849173435da791c77d81b2e","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Akuna Capital","slug":"akuna-capital","lists":["quant"],"target_role":null,"fit_tier":null},"title":"Quantitative Research Intern, Summer 2027","canonical_url":"https://www.akunacapital.com/careers/job/8036614?gh_jid=8036614","apply_url":"https://www.akunacapital.com/careers/job/8036614/?gh_jid=8036614","locations":[{"label":"Chicago, IL "},{"label":"Chicago, Illinois, United States"}],"workplace_type":"unknown","employment_type":"intern","departments":["Quant"],"teams":[],"language":"en","requisition_id":null,"internal_job_id":3483680,"first_published_at":"2026-07-13T14:28:45-04:00","source_updated_at":"2026-07-14T14:29:20-04:00","application_deadline":null,"description_plain":"About Akuna:\n\nAkuna Capital is an innovative trading firm with a strong focus on collaboration, cutting-edge technology, data driven solutions, and automation. We specialize in providing liquidity as an options market-maker – meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully, we design and implement our own low latency technologies, trading strategies and mathematical models.\n\nOur Founding Partners first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to operate from additional offices in Sydney, Shanghai, London, and Singapore.\n\nWhat you’ll do as a Quantitative Research Intern at Akuna:\n\nAkuna’s Quant team is looking to add Quant Research Interns to a team of mathematicians, statisticians and technologists for our 10-week Akunacademy internship program in our Chicago office. This team creates trading strategies scientifically by combining its quantitative expertise with sophisticated understanding of derivatives and financial markets.\n\nWe are looking for talented researchers who can apply and develop machine learning algorithms to contribute to Akuna’s strategy portfolio. In this role you will:\n\n- Develop trading strategies using statistical and machine learning algorithms.\n\n- Design and implement optimization algorithms for portfolio construction.\n\n- Develop quantitative models describing market behavior.\n\n- Advance existing initiatives and explore opportunities for new research topics.\n\nQualities that make great candidates:\n\n- Pursuing a bachelor’s, masters or PhD in Statistics, Computer Science, Engineering, Mathematics (or a related subject)\n\n- Expertise in statistics and machine learning\n\n- Experience building mathematical models for complex real-world problems\n\n- Intermediate programming skills in Python\n\n- The ability to react quickly and accurately to rapidly changing market conditions, including the ability to quickly and accurately respond and/or solve math and coding problems are essential functions of the role\n\n- Financial experience is not a requirement\n\n- Must graduate by August 2028\n\n- GPA of 3.5 or above\n\n- Legal authorization to work in the U.S. is required on the first day of employment including F-1 students using CPT, OPT or STEM\n\n**Resumes must be submitted in PDF format.\n\nIn addition to technical skillsets, Akuna values the unique perspectives people can bring to the table to collaboratively solve complex problems and drive Akuna forward. We want everyone to feel empowered to apply. We welcome your application and encourage you to take the first steps toward your future with us!\n\nPlease note: By submitting an application for this role, you are indicating this is your top preference and acknowledge you will not be considered for other Quant and/or Tech roles at Akuna this recruiting season. This acknowledgement does not limit applications to Trading roles - in addition to this role, you may apply to any Trader roles of interest.\n\nIn accordance with Illinois Equal Pay Act, the minimum annualized base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. The minimum base salary herein was determined in good faith by Akuna Capital LLC.","description_html":"<p><span style=\"color: rgb(0, 0, 0);\"><strong>About Akuna:</strong></span></p>\n<p><span style=\"color: rgb(0, 0, 0);\"><span data-contrast=\"none\">Akuna Capital is an innovative trading firm with a strong focus on collaboration, cutting-edge technology, data driven solutions, and automation. We specialize in providing liquidity as an options market-maker – meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully, we design and implement our own low latency technologies, trading strategies and mathematical models.</span><span data-ccp-props=\"{&quot;134233117&quot;:true,&quot;134233118&quot;:false,&quot;201341983&quot;:2,&quot;335559739&quot;:300,&quot;335559740&quot;:350}\">&nbsp;</span></span></p>\n<p><span style=\"color: rgb(0, 0, 0);\"><span data-contrast=\"none\">Our Founding Partners</span><em>&nbsp;</em><span data-contrast=\"none\">first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to operate from additional offices in Sydney, Shanghai, London, and Singapore.&nbsp;</span></span></p>\n<p><strong>What you’ll do as a Quantitative Research Intern at Akuna:</strong></p>\n<p>Akuna’s Quant team is looking to add Quant Research Interns to a team of mathematicians, statisticians and technologists for our 10-week Akunacademy internship program in our Chicago office. This team creates trading strategies scientifically by combining its quantitative expertise with sophisticated understanding of derivatives and financial markets.</p>\n<p>We are looking for talented researchers who can apply and develop machine learning algorithms to contribute to Akuna’s strategy portfolio. In this role you will:</p>\n<ul>\n<li>Develop trading strategies using statistical and machine learning algorithms.</li>\n<li>Design and implement optimization algorithms for portfolio construction.</li>\n<li>Develop quantitative models describing market behavior.</li>\n<li>Advance existing initiatives and explore opportunities for new research topics.</li>\n</ul>\n<p><strong>Qualities that make great candidates:</strong></p>\n<ul>\n<li>Pursuing a bachelor’s, masters or PhD in Statistics, Computer Science, Engineering, Mathematics (or a related subject)</li>\n<li>Expertise in statistics and machine learning</li>\n<li>Experience building mathematical models for complex real-world problems</li>\n<li>Intermediate programming skills in Python&nbsp;</li>\n<li>The ability to react quickly and accurately to rapidly changing market conditions, including the ability to quickly and accurately respond and/or solve math and coding problems are essential functions of the role</li>\n<li>Financial experience is not a requirement</li>\n<li>Must graduate by August 2028</li>\n<li>GPA of 3.5 or above</li>\n<li>Legal authorization to work in the U.S. is required on the first day of employment including F-1 students using CPT, OPT or STEM</li>\n</ul>\n<p>**Resumes must be submitted in PDF format.&nbsp;</p>\n<p><strong>In addition to technical skillsets, Akuna values the unique perspectives people can bring to the table to collaboratively solve complex problems and drive Akuna forward. We want everyone to feel empowered to apply. We welcome your application and encourage you to take the first steps toward your future with us!</strong></p>\n<p style=\"font-weight: 400;\"><strong>Please note:</strong> By submitting an application for this role, you are indicating this is your top preference and acknowledge you will not be considered for other Quant and/or Tech roles at Akuna this recruiting season. This acknowledgement does not limit applications to Trading roles - in addition to this role, you may apply to any Trader roles of interest.&nbsp;</p>\n<p style=\"font-weight: 400;\"><em data-stringify-type=\"italic\">In accordance with Illinois Equal Pay Act, the minimum annualized base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. </em><em data-stringify-type=\"italic\">The minimum base salary herein was determined in good faith by Akuna Capital LLC.</em></p>","compensation":[],"custom_fields":{"Employment Type":"Intern","Careers Site Section":["Student - Intern - Summer"],"Specialty":["C++","MACHINE LEARNING","PYTHON"],"Experience":"Intern","Crossfilter":["Quantitative"]},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":true,"tier":"target","score":13,"level":"intern","term":"summer_2027","tracks":["quant"],"role_matches":["Quantitative"],"early_career_matches":["Intern","2027"],"positive_matches":["Intern","2027","Quantitative"],"exclude_matches":[],"configured_tracks":["quant"]}}
{"schema_version":1,"job_key":"greenhouse:akunacapital:7496416","source":{"type":"greenhouse","board":"akunacapital","job_id":"7496416","source_url":"https://boards-api.greenhouse.io/v1/boards/akunacapital/jobs","response_hash":"12b9291a4fb144faeb84eceb3b00e9e1a4b4883d936bd526e4b970fa53a2a3d3","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Akuna Capital","slug":"akuna-capital","lists":["quant"],"target_role":null,"fit_tier":null},"title":"Quantitative Researcher","canonical_url":"https://www.akunacapital.com/careers/job/7496416?gh_jid=7496416","apply_url":"https://www.akunacapital.com/careers/job/7496416/?gh_jid=7496416","locations":[{"label":"Chicago, IL"},{"label":"Chicago, Illinois, United States"}],"workplace_type":"unknown","employment_type":"full_time","departments":["Quant Research"],"teams":[],"language":"en","requisition_id":"256","internal_job_id":3325449,"first_published_at":"2026-01-02T11:32:31-05:00","source_updated_at":"2026-07-13T13:29:51-04:00","application_deadline":null,"description_plain":"About Akuna:\n\nAkuna Capital is an innovative trading firm with a strong focus on collaboration, cutting-edge technology, data driven solutions, and automation. We specialize in providing liquidity as an options market maker – meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully, we design and implement our own low latency technologies, trading strategies, and mathematical models.\n\nOur Founding Partners first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to operate from additional offices in Sydney, Shanghai, London, and Singapore .\n\nWhat you’ll do as a Quantitative Researcher at Akuna:\n\nAkuna’s Trading and Research teams are seeking Quant Researchers to join a multidisciplinary group of mathematicians, statisticians, technologists and traders. These teams drive the development of trading strategies and predictive models by combining quantitative rigor with deep expertise in financial markets.\n\nWe are looking for talented researchers who can apply and develop machine learning algorithms to contribute to Akuna’s strategy portfolio. In this role, you will:\n\n- Develop trading strategies using statistical and machine learning algorithms\n\n- Drive improvements in predictive models through rigorous signal and feature research\n\n- Design and optimize machine learning workflows to support scalable, efficient, and reproducible research\n\n- Bring a results-driven mindset paired with strong collaboration and communication skills.\n\nQualities that make great candidates:\n\n- 3+ years of strong professional work experience in statistics, machine learning or related area\n\n- BS/MS/PhD degree in a technical field – Engineering, Computer Science, Math, Physics, or similar\n\n- Proven research background in academic or professional environment\n\n- Programming experience in Python or C++\n\n- Expertise in statistics and machine learning\n\n- Financial experience or knowledge of trading is a plus\n\n- The ability to react quickly and accurately to rapidly changing market conditions, including the ability to quickly and accurately respond and/or solve math and coding problems are essential functions of the role\n\nIn addition to technical skillsets, Akuna values the unique perspectives people can bring to the table to collaboratively solve complex problems and drive Akuna forward. We want all groups to feel empowered to apply, even if you don’t meet every qualification. We welcome your application and encourage you to take the first steps toward your future with us!\n\nPlease note that level/title, as well as team placement, will be determined upon the conclusion of the interview process. If you are a current student or recent graduate, please take a look at our Entry Level and Intern positions.\n\nIn accordance with Illinois Equal Pay Act, the minimum base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. This role is also eligible for a discretionary performance bonus as part of the total compensation package and includes a comprehensive benefits package that may encompass employer-paid medical, dental, vision, retirement contributions, paid time off, and other benefits. The minimum base salary herein was determined in good faith by Akuna Capital LLC.","description_html":"<p><strong>About Akuna:</strong></p>\n<p><span data-contrast=\"none\"><span data-ccp-parastyle=\"Normal (Web)\">Akuna Capital is an innovative trading firm with a strong focus on collaboration, </span><span data-ccp-parastyle=\"Normal (Web)\">cutting-edge</span><span data-ccp-parastyle=\"Normal (Web)\"> technology, data driven solutions, and automation. We specialize in providing liquidity as an options market maker – meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully, we design and implement our own low latency technologies, trading strategies, and mathematical models.</span></span><span data-ccp-props=\"{&quot;134233117&quot;:true,&quot;134233118&quot;:false,&quot;201341983&quot;:2,&quot;335559739&quot;:300,&quot;335559740&quot;:350}\">&nbsp;</span></p>\n<p><span data-contrast=\"none\"><span data-ccp-parastyle=\"Normal (Web)\">Our Founding Partners</span></span><em> </em><span data-contrast=\"none\"><span data-ccp-parastyle=\"Normal (Web)\">first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to </span><span data-ccp-parastyle=\"Normal (Web)\">operate</span><span data-ccp-parastyle=\"Normal (Web)\"> from </span><span data-ccp-parastyle=\"Normal (Web)\">additional</span><span data-ccp-parastyle=\"Normal (Web)\"> offices in </span><span data-ccp-parastyle=\"Normal (Web)\">Sydney, Shanghai, London, and </span><span data-ccp-parastyle=\"Normal (Web)\">Singapore</span><span data-ccp-parastyle=\"Normal (Web)\">.</span></span><span data-ccp-props=\"{&quot;134233117&quot;:true,&quot;134233118&quot;:false,&quot;201341983&quot;:2,&quot;335559739&quot;:300,&quot;335559740&quot;:350}\">&nbsp;</span></p>\n<p><strong>What you’ll do as a Quantitative Researcher at Akuna:</strong></p>\n<p><span data-contrast=\"auto\">Akuna’s Trading and Research teams are seeking Quant Researchers to join a multidisciplinary group of mathematicians, statisticians, technologists and traders. These teams drive the development of trading strategies and predictive models by combining quantitative rigor with deep expertise in financial markets.</span><span data-ccp-props=\"{&quot;201341983&quot;:2,&quot;335559738&quot;:240,&quot;335559739&quot;:0,&quot;335559740&quot;:240}\">&nbsp;</span></p>\n<p><span data-contrast=\"auto\">We are looking for talented researchers who can apply and develop machine learning algorithms to contribute to Akuna’s strategy portfolio. In this role, you will:</span><span data-ccp-props=\"{&quot;201341983&quot;:2,&quot;335559738&quot;:240,&quot;335559739&quot;:0,&quot;335559740&quot;:240}\">&nbsp;</span></p>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">Develop trading strategies using statistical and machine learning algorithms</span></li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\">Drive improvements in predictive models through rigorous signal and feature research</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\">Design and optimize machine learning workflows to support scalable, efficient, and reproducible research</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\">Bring a results-driven mindset paired with strong collaboration and communication skills.<span data-ccp-props=\"{&quot;201341983&quot;:2,&quot;335559738&quot;:240,&quot;335559739&quot;:0,&quot;335559740&quot;:240}\">&nbsp;</span></li>\n</ul>\n<p><strong><span data-contrast=\"auto\">Qualities that make great candidates:</span></strong><span data-ccp-props=\"{&quot;201341983&quot;:2,&quot;335559738&quot;:240,&quot;335559739&quot;:0,&quot;335559740&quot;:240}\">&nbsp;</span></p>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"5\" data-aria-level=\"1\"><span data-contrast=\"auto\">3+ years of strong professional work experience in statistics, machine learning or related area</span></li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"5\" data-aria-level=\"1\">BS/MS/PhD degree in a technical field – Engineering, Computer Science, Math, Physics, or similar</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"5\" data-aria-level=\"1\">Proven research background in academic or professional environment</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"5\" data-aria-level=\"1\">Programming experience in Python or C++</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"5\" data-aria-level=\"1\">Expertise in statistics and machine learning</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"5\" data-aria-level=\"1\">Financial experience or knowledge of trading is a plus</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"5\" data-aria-level=\"1\">The ability to react quickly and accurately to rapidly changing market conditions, including the ability to quickly and accurately respond and/or solve math and coding problems are essential functions of the role</li>\n</ul>\n<p><strong><span data-contrast=\"none\">In addition to technical skillsets, Akuna values the unique perspectives people can bring to the table to collaboratively solve complex problems and drive Akuna forward. We want all groups to feel empowered to apply, even if you don’t meet every qualification. We welcome your application and encourage you to take the first steps toward your future with us!</span></strong><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:279}\">&nbsp;</span></p>\n<p><em><span data-contrast=\"none\">Please note that level/title, as well as team placement, will be determined upon the conclusion of the interview process. If you are a current student or recent graduate, please take a look at our Entry Level and Intern positions.</span></em><span data-contrast=\"none\">&nbsp;</span></p>\n<p><span data-contrast=\"none\"><em>In accordance with Illinois Equal Pay Act, the minimum base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. This role is also eligible for a discretionary performance bonus as part of the total compensation package and includes a comprehensive benefits package that may encompass employer-paid medical, dental, vision, retirement contributions, paid time off, and other benefits. The minimum base salary herein was determined in good faith by Akuna Capital LLC.</em></span></p>","compensation":[],"custom_fields":{"Employment Type":"Full-time","Careers Site Section":["Experienced"],"Specialty":["MACHINE LEARNING","MARKET MICROSTRUCTURE","PYTHON"],"Experience":"Experienced","Crossfilter":["Quantitative"]},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":true,"tier":"stretch","score":3,"level":"unspecified","term":null,"tracks":["quant"],"role_matches":["Quantitative"],"early_career_matches":[],"positive_matches":["Quantitative"],"exclude_matches":[],"configured_tracks":["quant"]}}
{"schema_version":1,"job_key":"greenhouse:akunacapital:7846695","source":{"type":"greenhouse","board":"akunacapital","job_id":"7846695","source_url":"https://boards-api.greenhouse.io/v1/boards/akunacapital/jobs","response_hash":"56050112fa4fda9cfd6cd85ecfef31106eca05ca9d0b5aa471532a8f0ca4dad2","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Akuna Capital","slug":"akuna-capital","lists":["quant"],"target_role":null,"fit_tier":null},"title":"Quantitative Researcher - Prediction Markets","canonical_url":"https://www.akunacapital.com/careers/job/7846695?gh_jid=7846695","apply_url":"https://www.akunacapital.com/careers/job/7846695/?gh_jid=7846695","locations":[{"label":"Chicago, IL"},{"label":"Chicago, Illinois, United States"}],"workplace_type":"unknown","employment_type":"full_time","departments":["Quant Research"],"teams":[],"language":"en","requisition_id":"272","internal_job_id":3420113,"first_published_at":"2026-04-28T17:59:35-04:00","source_updated_at":"2026-08-14T18:10:34-04:00","application_deadline":null,"description_plain":"Akuna Capital is an innovative trading firm with a strong focus on collaboration, cutting-edge technology, data driven solutions, and automation. We specialize in providing liquidity as an options market maker – meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully, we design and implement our own low latency technologies, trading strategies, and mathematical models.\n\nOur Founding Partners first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to operate from additional offices in Sydney, Shanghai, London, and Singapore .\n\nWhat you’ll do as a Quantitative Researcher at Akuna:\n\nAkuna's Prediction Markets team is looking to add a Quantitative Researcher focused on sports related contracts. The successful candidate will play a crucial role in developing Akuna’s sports pricing capabilities, working closely with development and trading teams to refine and deploy these models alongside our strategies. This position offers the opportunity to make a direct impact on an exciting new desk at Akuna. The ideal candidate will possess strong programming and analytical skills, a creative mindset, and a passion for sports. In this role you will:\n\n- Design and develop data capture pipelines to enable the pricing of a variety of sports contracts (match outcomes, player props, in-game events)\n\n- Develop and calibrate pricing models using historical data in service of in-play quoting of sports contracts.\n\n- Build and maintain internal tooling to facilitate all aspects of the research pipeline\n\n- Work closely with trading and development to deploy models into production trading strategies, bridging the gap from research to production with an ownership mentality\n\nQualities that make great candidates:\n\n- Bachelor’s, Master’s, or PhD degree in a technical field, such as Engineering, Computer Science, Mathematics, or Physics (or a related subject)\n\n- Proficient programming skills in Python (C++ is a plus)\n\n- 1+ years of experience in a quantitative or programming role, preferably within the trading sector.\n\n- Deep understanding of fields such as Linear Algebra, Numerical Methods, Statistics, Optimization, and Machine Learning\n\n- Strong interest in sports and quantitative modeling.\n\nWe are especially interested in high agency individuals who have practical experience in financial markets and see the recent rise in prediction markets as an opportunity to ply their trade to a new domain they find more dynamic and exciting: sports. If you are a working quant and a sports data nerd, we want to hear from you!\n\nIn addition to technical skillsets, Akuna values the unique perspectives people can bring to the table to collaboratively solve complex problems and drive Akuna forward. We want everyone to feel empowered to apply. We welcome your application and encourage you to take the first steps toward your future with us!\n\nIn accordance with Illinois Equal Pay Act, the minimum base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. This role is also eligible for a discretionary performance bonus as part of the total compensation package and includes a comprehensive benefits package that may encompass employer-paid medical, dental, vision, retirement contributions, paid time off, and other benefits. The minimum base salary herein was determined in good faith by Akuna Capital LLC.","description_html":"<p><span data-contrast=\"none\"><span data-ccp-parastyle=\"Normal (Web)\">Akuna Capital is an innovative trading firm with a strong focus on collaboration,&nbsp;</span><span data-ccp-parastyle=\"Normal (Web)\">cutting-edge</span><span data-ccp-parastyle=\"Normal (Web)\"> technology, data driven solutions, and automation. We specialize in providing liquidity as an options market maker – meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully, we design and implement our own low latency technologies, trading strategies, and mathematical models.</span></span><span data-ccp-props=\"{&quot;134233117&quot;:true,&quot;134233118&quot;:false,&quot;201341983&quot;:2,&quot;335559739&quot;:300,&quot;335559740&quot;:350}\">&nbsp;</span></p>\n<p><span data-contrast=\"none\"><span data-ccp-parastyle=\"Normal (Web)\">Our Founding Partners</span></span><em><span data-contrast=\"none\"><span data-ccp-parastyle=\"Normal (Web)\">&nbsp;</span></span></em><span data-contrast=\"none\"><span data-ccp-parastyle=\"Normal (Web)\">first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to&nbsp;</span><span data-ccp-parastyle=\"Normal (Web)\">operate</span><span data-ccp-parastyle=\"Normal (Web)\">&nbsp;from&nbsp;</span><span data-ccp-parastyle=\"Normal (Web)\">additional</span><span data-ccp-parastyle=\"Normal (Web)\">&nbsp;offices in&nbsp;</span><span data-ccp-parastyle=\"Normal (Web)\">Sydney, Shanghai, London, and&nbsp;</span><span data-ccp-parastyle=\"Normal (Web)\">Singapore</span><span data-ccp-parastyle=\"Normal (Web)\">.</span></span><span data-ccp-props=\"{&quot;134233117&quot;:true,&quot;134233118&quot;:false,&quot;201341983&quot;:2,&quot;335559739&quot;:300,&quot;335559740&quot;:350}\">&nbsp;</span></p>\n<p><strong><span data-contrast=\"none\">What&nbsp;you’ll&nbsp;do as a Quantitative Researcher at Akuna:</span></strong><span data-ccp-props=\"{&quot;201341983&quot;:2,&quot;335559738&quot;:240,&quot;335559739&quot;:0,&quot;335559740&quot;:240}\">&nbsp;</span></p>\n<p><span data-contrast=\"auto\">Akuna's Prediction Markets team is looking to add a Quantitative Researcher focused on sports related contracts. The successful candidate will play a crucial role in developing Akuna’s sports pricing capabilities, working closely with development and trading teams to refine and deploy these models alongside our strategies. This position offers the opportunity to make a direct impact on an exciting new desk at Akuna. The ideal candidate will possess strong programming and analytical skills, a creative mindset, and a passion for sports. In this role you will:&nbsp; </span><span data-ccp-props=\"{&quot;201341983&quot;:2,&quot;335559738&quot;:240,&quot;335559739&quot;:0,&quot;335559740&quot;:240}\">&nbsp;</span></p>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">Design and develop data capture pipelines to enable the pricing of a variety of sports contracts (match outcomes, player props, in-game events)</span></li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\">Develop and calibrate pricing models using historical data in service of in-play quoting of sports contracts.</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\">Build and maintain internal tooling to facilitate all aspects of the research pipeline</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\">Work closely with trading and development to deploy models into production trading strategies, bridging the gap from research to production with an ownership mentality<span data-ccp-props=\"{}\">&nbsp;</span></li>\n</ul>\n<p><strong><span data-contrast=\"auto\">Qualities that make great&nbsp;candidates:</span></strong><span data-ccp-props=\"{&quot;201341983&quot;:2,&quot;335559738&quot;:240,&quot;335559739&quot;:0,&quot;335559740&quot;:240}\">&nbsp;</span></p>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"5\" data-aria-level=\"1\"><span data-contrast=\"auto\">Bachelor’s, Master’s, or PhD degree in a technical field, such as Engineering, Computer Science, Mathematics, or Physics (or a related subject)</span></li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"5\" data-aria-level=\"1\">Proficient programming skills in Python (C++ is a plus)</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"5\" data-aria-level=\"1\">1+ years of experience in a quantitative or programming role, preferably within the trading sector.</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"5\" data-aria-level=\"1\">Deep understanding of fields such as Linear Algebra, Numerical Methods, Statistics, Optimization, and Machine Learning</li>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"5\" data-aria-level=\"1\">Strong interest in sports and quantitative modeling.<span data-ccp-props=\"{}\">&nbsp;</span></li>\n</ul>\n<p><span data-contrast=\"auto\">We are especially interested in high agency individuals who have practical experience in financial markets and see the recent rise in prediction markets as an opportunity to ply their trade to a new domain they find more dynamic and exciting: sports. If you are a working quant and a sports data nerd, we want to hear from you!</span><span data-ccp-props=\"{&quot;335559685&quot;:0}\">&nbsp;</span></p>\n<p><strong><em>In addition to technical skillsets, Akuna values the unique perspectives people can bring to the table to collaboratively solve complex problems and drive Akuna forward. We want everyone to feel empowered to apply. We welcome your application and encourage you to take the first steps toward your future with us!</em></strong></p>\n<p><em>In accordance with Illinois Equal Pay Act, the minimum base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. This role is also eligible for a discretionary performance bonus as part of the total compensation package and includes a comprehensive benefits package that may encompass employer-paid medical, dental, vision, retirement contributions, paid time off, and other benefits. The minimum base salary herein was determined in good faith by Akuna Capital LLC.</em></p>","compensation":[],"custom_fields":{"Employment Type":"Full-time","Careers Site Section":["Experienced"],"Specialty":["QUANT TRADING"],"Experience":"Experienced","Crossfilter":["Quantitative"]},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":true,"tier":"stretch","score":3,"level":"unspecified","term":null,"tracks":["quant"],"role_matches":["Quantitative"],"early_career_matches":[],"positive_matches":["Quantitative"],"exclude_matches":[],"configured_tracks":["quant"]}}
{"schema_version":1,"job_key":"greenhouse:akunacapital:6527972","source":{"type":"greenhouse","board":"akunacapital","job_id":"6527972","source_url":"https://boards-api.greenhouse.io/v1/boards/akunacapital/jobs","response_hash":"54c3c7ffa1b35cd1a0df9dc4a6f744ffee944e26810e93eec66cf9b87f01efa0","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Akuna Capital","slug":"akuna-capital","lists":["quant"],"target_role":null,"fit_tier":null},"title":"Quantitative Trader","canonical_url":"https://www.akunacapital.com/careers/job/6527972?gh_jid=6527972","apply_url":"https://www.akunacapital.com/careers/job/6527972/?gh_jid=6527972","locations":[{"label":"Singapore"}],"workplace_type":"unknown","employment_type":"full_time","departments":["Trading"],"teams":[],"language":"en","requisition_id":"208","internal_job_id":3045420,"first_published_at":"2025-01-13T00:07:23-05:00","source_updated_at":"2026-07-13T13:29:51-04:00","application_deadline":null,"description_plain":"About Akuna:\n\nAkuna Capital is an innovative trading firm with a strong focus on collaboration, cutting-edge technology, data driven solutions and automation. We specialise in providing liquidity as an options market maker – meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully we design and implement our own low latency technologies, trading strategies and mathematical models. At Akuna we have a flat structure, where the best idea wins.\n\nOur Founding Partners, including Andrew Killion, first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to operate from additional offices in Sydney, Shanghai, Singapore and London.\n\nWhat you'll do as a Quantitative Trader at Akuna:\nWe are seeking experienced Quantitative Options Traders to join our dynamic team at Akuna Capital. The ideal candidate will be a motivated individual with a desire to make an immediate impact. We are searching for creative thinkers, for competition winners, for those who enjoy a challenge. If you enjoy taking an idea, making it tangible, and receiving rapid feedback - we have the challenge for you.\n\nIn this role you will:\n\n- Manage trading strategies and improve profitability by converting ideas into quantitative models\n\n- Implement trading signals that influence our automated trading\n\n- Develop a deep understanding of derivatives theory and financial markets\n\n- Generate ideas on trading opportunities, product insights, risk management and trading systems\n\nQualities that make great candidates:\n\n- 3+ years of professional work experience in Options Trading or related field\n\n- BS/MS/PhD in a technical field – Engineering, Statistics, Computer Science, Mathematics, Physics, or similar\n\n- Understanding of advanced Mathematics: Calculus, Probability, Linear Algebra, Statistics and Optimization\n\n- Working knowledge of statistical analysis, numerical linear algebra, machine learning or convex optimization\n\n- Intermediate programming skills in Python (C++ is a plus)","description_html":"<p><strong>About Akuna:</strong></p>\n<p>Akuna Capital is an innovative trading firm with a strong focus on collaboration, cutting-edge technology, data driven solutions and automation. We specialise in providing liquidity as an options market maker – meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully we design and implement our own low latency technologies, trading strategies and mathematical models. At Akuna we have a flat structure, where the best idea wins.<br><br>Our Founding Partners, including Andrew Killion, first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to operate from additional offices in Sydney, Shanghai, Singapore and London.</p>\n<div class=\"p-rich_text_section\"><strong data-stringify-type=\"bold\">What you'll do as a Quantitative Trader at Akuna:</strong><br>We are seeking experienced Quantitative Options Traders to join our dynamic team at Akuna Capital. The ideal candidate will be a motivated individual with a desire to make an immediate impact. We are searching for creative thinkers, for competition winners, for those who enjoy a challenge. If you enjoy taking an idea, making it tangible, and receiving rapid feedback - we have the challenge for you.</div>\n<div class=\"p-rich_text_section\">&nbsp;</div>\n<div class=\"p-rich_text_section\"><strong data-stringify-type=\"bold\">In this role you will:</strong></div>\n<div class=\"p-rich_text_section\">\n<ul>\n<li>Manage trading strategies and improve profitability by converting ideas into quantitative models</li>\n<li>Implement trading signals that influence our automated trading</li>\n<li>Develop a deep understanding of derivatives theory and financial markets</li>\n<li>Generate ideas on trading opportunities, product insights, risk management and trading systems</li>\n</ul>\n</div>\n<div class=\"p-rich_text_section\"><strong data-stringify-type=\"bold\">Qualities that make great candidates:</strong></div>\n<ul class=\"p-rich_text_list p-rich_text_list__bullet p-rich_text_list--nested\" data-stringify-type=\"unordered-list\" data-list-tree=\"true\" data-indent=\"0\" data-border=\"0\">\n<li data-stringify-indent=\"0\" data-stringify-border=\"0\">3+ years of professional work experience in Options Trading or related field</li>\n<li data-stringify-indent=\"0\" data-stringify-border=\"0\">BS/MS/PhD in a technical field – Engineering, Statistics, Computer Science, Mathematics, Physics, or similar</li>\n<li data-stringify-indent=\"0\" data-stringify-border=\"0\">Understanding of advanced Mathematics: Calculus, Probability, Linear Algebra, Statistics and Optimization</li>\n<li data-stringify-indent=\"0\" data-stringify-border=\"0\">Working knowledge of statistical analysis, numerical linear algebra, machine learning or convex optimization</li>\n<li data-stringify-indent=\"0\" data-stringify-border=\"0\">Intermediate programming skills in Python (C++ is a plus)</li>\n</ul>\n<p>&nbsp;</p>","compensation":[],"custom_fields":{"Employment Type":"Full-time","Careers Site Section":["Experienced","Student - Full Time"],"Specialty":[],"Experience":"Experienced","Crossfilter":["Trading"]},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":true,"tier":"stretch","score":3,"level":"unspecified","term":null,"tracks":["quant"],"role_matches":["Quantitative"],"early_career_matches":[],"positive_matches":["Quantitative"],"exclude_matches":[],"configured_tracks":["quant"]}}
{"schema_version":1,"job_key":"greenhouse:akunacapital:8047104","source":{"type":"greenhouse","board":"akunacapital","job_id":"8047104","source_url":"https://boards-api.greenhouse.io/v1/boards/akunacapital/jobs","response_hash":"e0bc043d1cdc5c35fb077b85b21df4a4c34ad62b2e006453b2292d01ddfb9c62","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Akuna Capital","slug":"akuna-capital","lists":["quant"],"target_role":null,"fit_tier":null},"title":"Security Engineer II","canonical_url":"https://www.akunacapital.com/careers/job/8047104?gh_jid=8047104","apply_url":"https://www.akunacapital.com/careers/job/8047104/?gh_jid=8047104","locations":[{"label":"Chicago"},{"label":"Chicago, Illinois, United States"}],"workplace_type":"unknown","employment_type":"full_time","departments":["Information Security"],"teams":[],"language":"en","requisition_id":"283","internal_job_id":3487780,"first_published_at":"2026-07-08T10:53:56-04:00","source_updated_at":"2026-07-22T12:41:42-04:00","application_deadline":null,"description_plain":null,"description_html":null,"compensation":[],"custom_fields":{"Employment Type":"Full-time","Careers Site Section":["Experienced"],"Specialty":[],"Experience":"Experienced","Crossfilter":["Information Security"]},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":false,"tier":"stretch","score":0,"level":"unspecified","term":null,"tracks":[],"role_matches":[],"early_career_matches":[],"positive_matches":[],"exclude_matches":[],"configured_tracks":["quant"]}}
{"schema_version":1,"job_key":"greenhouse:akunacapital:7496397","source":{"type":"greenhouse","board":"akunacapital","job_id":"7496397","source_url":"https://boards-api.greenhouse.io/v1/boards/akunacapital/jobs","response_hash":"c3df24325a813fcc15336b4b80c99c41ae966b26573965503cf0bdff9b36b8f7","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Akuna Capital","slug":"akuna-capital","lists":["quant"],"target_role":null,"fit_tier":null},"title":"Software Engineer - C++","canonical_url":"https://www.akunacapital.com/careers/job/7496397?gh_jid=7496397","apply_url":"https://www.akunacapital.com/careers/job/7496397/?gh_jid=7496397","locations":[{"label":"Chicago, IL"},{"label":"Chicago, Illinois, United States"}],"workplace_type":"unknown","employment_type":"full_time","departments":["C++"],"teams":[],"language":"en","requisition_id":"252","internal_job_id":3325438,"first_published_at":"2026-01-02T11:22:39-05:00","source_updated_at":"2026-08-18T14:40:41-04:00","application_deadline":null,"description_plain":"About Akuna:\n\nAkuna Capital is an innovative trading firm with a strong focus on collaboration, cutting-edge technology, data driven solutions, and automation. We specialize in providing liquidity as an options market maker – meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully, we design and implement our own low latency technologies, trading strategies, and mathematical models.\n\nOur Founding Partners first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to operate from additional offices in Sydney, Shanghai, London and Singapore.\n\nWhat you’ll do as a Software Engineer at Akuna:\n\nAkuna is looking for motivated self-starters to join our growing engineering team and contribute to the build-out of our proprietary options market-making trading platform. You will focus on analysis, design, implementation, testing and delivery of Akuna’s trading system using the latest technologies. Successful candidates will work closely with an industry-leading team of options Traders who participate fully in the design and ongoing enhancements to our proprietary trading platform . In this role, you will:\n\n- Design and build mission-critical and complex trading systems\n\n- Plan, design, and implement efficient, flexible, and resilient Linux services using modern C++ technologies\n\n- Build software using Agile methodologies\n\n- Participate in design sessions and code reviews\n\n- Work on cross-functional teams to troubleshoot and solve complex problems\n\nQualities that make great candidates:\n\n- 3+ years of experience developing performant, scalable applications in modern C++ (and at least 2 years with C++ 20 or 23; template metaprogramming a plus)\n\n- Experience with Linux and Python required\n\n- Understanding of data structures, algorithms, distributed systems, multi-threading, and asynchronous execution\n\n- Object-oriented design and programming experience\n\n- Ability to take on projects and drive them through to completion in a timely manner\n\n- Familiarity with trading and trading systems is a plus\n\n- Bachelor’s degree in Computer Science, Engineering, Math, or equivalent\n\n- The ability to react quickly and accurately to rapidly changing market conditions, including the ability to quickly and accurately respond and/or solve math and coding problems are essential functions of the role\n\nIn addition to technical skillsets, Akuna values the unique perspectives people can bring to the table to collaboratively solve complex problems and drive Akuna forward. We want everyone to feel empowered to apply. We welcome your application and encourage you to take the first steps toward your future with us!\n\nPlease note that level/title, as well as team placement, will be determined upon the conclusion of the interview process. If you are a current student or recent graduate, please take a look at our Entry Level and Intern positions.\n\nIn accordance with Illinois Equal Pay Act, the minimum base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. This role is also eligible for a discretionary performance bonus as part of the total compensation package and includes a comprehensive benefits package that may encompass employer-paid medical, dental, vision, retirement contributions, paid time off, and other benefits. The minimum base salary herein was determined in good faith by Akuna Capital LLC.","description_html":"<p><strong><span data-contrast=\"none\">About Akuna:</span></strong><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:200,&quot;335559740&quot;:276}\">&nbsp;</span></p>\n<p><span data-contrast=\"none\">Akuna Capital is an innovative trading firm with a strong focus on collaboration, cutting-edge technology, data driven solutions, and automation. We specialize in providing liquidity as an options market maker – meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully, we design and implement our own low latency technologies, trading strategies, and mathematical models.</span><span data-ccp-props=\"{&quot;134233117&quot;:true,&quot;134233118&quot;:false,&quot;201341983&quot;:2,&quot;335559739&quot;:300,&quot;335559740&quot;:350}\">&nbsp;</span></p>\n<p><span data-contrast=\"none\">Our Founding Partners</span><em> </em><span data-contrast=\"none\">first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. <span data-ccp-parastyle=\"Normal (Web)\">Today, Akuna is proud to operate from additional offices in Sydney, Shanghai, London and Singapore.</span></span></p>\n<p><strong><span data-contrast=\"none\">What you’ll do as a Software Engineer at Akuna:</span></strong><span data-ccp-props=\"{&quot;134233117&quot;:true,&quot;134233118&quot;:true,&quot;201341983&quot;:2,&quot;335559740&quot;:312}\">&nbsp;</span></p>\n<p><span data-contrast=\"auto\">Akuna is looking for motivated self-starters to join our growing engineering team and contribute to the build-out of our proprietary options market-making trading platform. You will focus on analysis, design, implementation, testing and delivery of Akuna’s trading system using the latest technologies. Successful candidates will work closely with an industry-leading team of options Traders who participate fully in the design and ongoing enhancements to our proprietary trading platform</span><span data-contrast=\"none\">. In this role, you will:</span><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<ul>\n<li><span data-contrast=\"none\">Design and build mission-critical and complex trading systems</span><span data-ccp-props=\"{&quot;134233117&quot;:true,&quot;134233118&quot;:true,&quot;201341983&quot;:0,&quot;335559740&quot;:240}\">&nbsp;</span></li>\n<li><span data-contrast=\"none\">Plan, design, and implement efficient, flexible, and resilient Linux services using modern C++ technologies</span></li>\n<li><span data-contrast=\"none\">Build software using Agile methodologies</span><span data-ccp-props=\"{&quot;134233117&quot;:true,&quot;134233118&quot;:true,&quot;201341983&quot;:2,&quot;335559740&quot;:312}\">&nbsp;</span></li>\n<li><span data-contrast=\"none\">Participate in design sessions and code reviews</span><span data-ccp-props=\"{&quot;134233117&quot;:true,&quot;134233118&quot;:true,&quot;201341983&quot;:2,&quot;335559740&quot;:312}\">&nbsp;</span></li>\n<li><span data-contrast=\"none\">Work on cross-functional teams to troubleshoot and solve complex problems</span><span data-ccp-props=\"{&quot;134233117&quot;:true,&quot;134233118&quot;:true,&quot;201341983&quot;:2,&quot;335559740&quot;:312}\">&nbsp;</span></li>\n</ul>\n<p><strong><span data-contrast=\"none\">Qualities that make great candidates:</span></strong><span data-ccp-props=\"{&quot;134233117&quot;:true,&quot;134233118&quot;:true,&quot;201341983&quot;:2,&quot;335559740&quot;:312}\">&nbsp;</span></p>\n<ul>\n<li><span data-contrast=\"none\">3+ years of experience developing performant, scalable applications in modern C++ (and at least 2 years with C++ 20 or 23; template metaprogramming a plus)</span><span data-ccp-props=\"{&quot;134233117&quot;:true,&quot;134233118&quot;:true,&quot;201341983&quot;:2,&quot;335559740&quot;:312}\">&nbsp;</span></li>\n<li><span data-contrast=\"none\">Experience with Linux and Python required</span><span data-ccp-props=\"{&quot;134233117&quot;:true,&quot;134233118&quot;:true,&quot;201341983&quot;:2,&quot;335559740&quot;:312}\">&nbsp;</span></li>\n<li><span data-contrast=\"none\">Understanding of data structures, algorithms, distributed systems, multi-threading, and asynchronous execution</span></li>\n<li><span data-contrast=\"none\">Object-oriented design and programming experience</span><span data-ccp-props=\"{&quot;134233117&quot;:true,&quot;134233118&quot;:true,&quot;201341983&quot;:2,&quot;335559740&quot;:312}\">&nbsp;</span></li>\n<li><span data-contrast=\"none\">Ability to take on projects and drive them through to completion</span><span data-ccp-props=\"{&quot;134233117&quot;:true,&quot;134233118&quot;:true,&quot;201341983&quot;:2,&quot;335559740&quot;:312}\"> in a timely manner</span></li>\n<li><span data-contrast=\"none\">Familiarity with trading and trading systems is a plus</span><span data-ccp-props=\"{&quot;134233117&quot;:true,&quot;134233118&quot;:true,&quot;201341983&quot;:2,&quot;335559740&quot;:312}\">&nbsp;</span></li>\n<li><span data-contrast=\"none\">Bachelor’s degree in Computer Science, Engineering, Math, or equivalent</span><span data-ccp-props=\"{&quot;134233117&quot;:true,&quot;134233118&quot;:true,&quot;201341983&quot;:2,&quot;335559740&quot;:312}\">&nbsp;</span></li>\n<li>The ability to react quickly and accurately to rapidly changing market conditions, including the ability to quickly and accurately respond and/or solve math and coding problems are essential functions of the role</li>\n</ul>\n<p><strong><em>In addition to technical skillsets, Akuna values the unique perspectives people can bring to the table to collaboratively solve complex problems and drive Akuna forward. We want everyone to feel empowered to apply. We welcome your application and encourage you to take the first steps toward your future with us!</em></strong></p>\n<p><em><span data-contrast=\"none\">Please note that level/title, as well as team placement, will be determined upon the conclusion of the interview process. If you are a current student or recent graduate, please take a look at our Entry Level and Intern positions.</span></em><span data-contrast=\"none\">&nbsp;</span></p>\n<p><span data-contrast=\"none\"><em>In accordance with Illinois Equal Pay Act, the minimum base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. This role is also eligible for a discretionary performance bonus as part of the total compensation package and includes a comprehensive benefits package that may encompass employer-paid medical, dental, vision, retirement contributions, paid time off, and other benefits. The minimum base salary herein was determined in good faith by Akuna Capital LLC.</em></span></p>","compensation":[],"custom_fields":{"Employment Type":"Full-time","Careers Site Section":["Experienced"],"Specialty":["C++"],"Experience":"Experienced","Crossfilter":["Development"]},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":true,"tier":"stretch","score":3,"level":"unspecified","term":null,"tracks":["software"],"role_matches":["Software Engineer"],"early_career_matches":[],"positive_matches":["Software Engineer"],"exclude_matches":[],"configured_tracks":["quant"]}}
{"schema_version":1,"job_key":"greenhouse:akunacapital:7496408","source":{"type":"greenhouse","board":"akunacapital","job_id":"7496408","source_url":"https://boards-api.greenhouse.io/v1/boards/akunacapital/jobs","response_hash":"b94adc4c386a2dc11e84f00941c86cbfa67b041197192c1d0637d1e08decef58","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Akuna Capital","slug":"akuna-capital","lists":["quant"],"target_role":null,"fit_tier":null},"title":"Software Engineer - C++, Trading Strategies","canonical_url":"https://www.akunacapital.com/careers/job/7496408?gh_jid=7496408","apply_url":"https://www.akunacapital.com/careers/job/7496408/?gh_jid=7496408","locations":[{"label":"Chicago, IL"},{"label":"Chicago, Illinois, United States"}],"workplace_type":"unknown","employment_type":"full_time","departments":["C++"],"teams":[],"language":"en","requisition_id":"253","internal_job_id":3325445,"first_published_at":"2026-01-02T11:24:40-05:00","source_updated_at":"2026-08-24T09:52:41-04:00","application_deadline":null,"description_plain":"About Akuna:\n\nAkuna Capital is an innovative trading firm with a strong focus on collaboration, cutting-edge technology, data driven solutions, and automation. We specialize in providing liquidity as an options market maker – meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully, we design and implement our own low latency technologies, trading strategies, and mathematical models.\n\nOur Founding Partners first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to operate from additional offices in Sydney, Shanghai, London and Singapore.\n\nWhat you’ll do as a Software Engineer on the Trading Strategies Team at Akuna:\n\nAkuna is looking for Software Engineers who are excited to apply their skills to low latency trading. Working directly with Traders and Researchers, you will focus on analysis, design, implementation, testing and delivery of Akuna’s strategies to the market. Your goal is to develop software that incorporates vast amounts of data to drive sophisticated, ultra-fast strategies, capturing market opportunities before our competition. In this role, you will:\n\n- Lead in the design, implementation, and deployment of trading strategies using modern C++ technologies\n\n- Bring deep technical knowledge in areas such as parallel programming, trading systems, networking, and performance analysis\n\n- Be extremely hands-on, producing both detailed technical work and high-level architectural designs\n\n- Have leadership opportunities across both project and team management\n\n- Build software using Agile methodologies and modern software best practices\n\n- Work directly with Traders and Researchers to create and enhance high performance, low latency trading strategies\n\nQualities that make great candidates:\n\n- 3+ years of experience developing performant, scalable applications in modern C++20 and beyond\n\n- Experience developing trading strategies and/or a demonstrated passion for financial markets\n\n- Experience using data to drive decision-making\n\n- Significant experience with distributed systems, data structures, and algorithms\n\n- Solid understanding of multi-threaded/multi-core programming paradigms\n\n- Highly collaborative in nature, with excellent written and verbal communication skills\n\n- Bachelor’s degree in Computer Science, Engineering, Math or equivalent\n\n- The ability to react quickly and accurately to rapidly changing market conditions, including the ability to quickly and accurately respond and/or solve math and coding problems are essential functions of the role\n\nIn addition to technical skillsets, Akuna values the unique perspectives people can bring to the table to collaboratively solve complex problems and drive Akuna forward. We want everyone to feel empowered to apply. We welcome your application and encourage you to take the first steps toward your future with us!\n\nPlease note that level/title, as well as team placement, will be determined upon the conclusion of the interview process. If you are a current student or recent graduat e , please take a look at our Entry Level and Intern positions .\n\nIn accordance with Illinois Equal Pay Act, the minimum base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. This role is also eligible for a discretionary performance bonus as part of the total compensation package and includes a comprehensive benefits package that may encompass employer-paid medical, dental, vision, retirement contributions, paid time off, and other benefits. The minimum base salary herein was determined in good faith by Akuna Capital LLC.","description_html":"<p><strong><span data-contrast=\"none\">About Akuna:</span></strong><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:200,&quot;335559740&quot;:276}\">&nbsp;</span></p>\n<p><span data-contrast=\"none\">Akuna Capital is an innovative trading firm with a strong focus on collaboration, cutting-edge technology, data driven solutions, and automation. We specialize in providing liquidity as an options market maker – meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully, we design and implement our own low latency technologies, trading strategies, and mathematical models.</span><span data-ccp-props=\"{&quot;134233117&quot;:true,&quot;134233118&quot;:false,&quot;201341983&quot;:2,&quot;335559739&quot;:300,&quot;335559740&quot;:350}\">&nbsp;</span></p>\n<p><span data-contrast=\"none\">Our Founding Partners</span><em> </em><span data-contrast=\"none\">first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. <span data-ccp-parastyle=\"Normal (Web)\">Today, Akuna is proud to operate from additional offices in Sydney, Shanghai, London and Singapore.</span></span></p>\n<p><strong><span data-contrast=\"auto\">What you’ll do as a Software Engineer on the Trading Strategies Team at Akuna:</span></strong><span data-ccp-props=\"{&quot;201341983&quot;:2,&quot;335559685&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:330}\">&nbsp;</span></p>\n<p><span data-contrast=\"auto\">Akuna is looking for Software Engineers who are excited to apply their skills to low latency trading. Working directly with Traders and Researchers, you will focus on analysis, design, implementation, testing and delivery of Akuna’s strategies to the market. Your goal is to develop software that incorporates vast amounts of data to drive sophisticated, ultra-fast strategies, capturing market opportunities before our competition. In this role, you will:</span><span data-ccp-props=\"{&quot;335559685&quot;:0}\">&nbsp;</span></p>\n<ul>\n<li><span data-contrast=\"auto\">Lead in the design, implementation, and deployment of trading strategies using modern C++ technologies</span><span data-ccp-props=\"{}\">&nbsp;</span></li>\n<li><span data-contrast=\"auto\">Bring deep technical knowledge in areas such as parallel programming, trading systems, networking, and performance analysis</span><span data-ccp-props=\"{}\">&nbsp;</span></li>\n<li><span data-contrast=\"auto\">Be extremely hands-on, producing both detailed technical work and high-level architectural designs</span><span data-ccp-props=\"{}\">&nbsp;</span></li>\n<li><span data-contrast=\"auto\">Have leadership opportunities across both project and team management</span><span data-ccp-props=\"{}\">&nbsp;</span></li>\n<li><span data-contrast=\"auto\">Build software using Agile methodologies and modern software best practices</span><span data-ccp-props=\"{}\">&nbsp;</span></li>\n<li><span data-contrast=\"auto\">Work directly with Traders and Researchers to create and enhance high performance, low latency trading strategies</span><span data-ccp-props=\"{}\">&nbsp;</span></li>\n</ul>\n<p><strong><span data-contrast=\"auto\">Qualities that make great candidates:</span></strong><span data-ccp-props=\"{&quot;335559685&quot;:0}\">&nbsp;</span></p>\n<ul>\n<li><span data-contrast=\"auto\">3+ years of experience developing performant, scalable applications in modern C++20 and beyond</span><span data-ccp-props=\"{}\">&nbsp;</span></li>\n<li><span data-contrast=\"auto\">Experience developing trading strategies and/or a demonstrated passion for financial markets</span><span data-ccp-props=\"{}\">&nbsp;</span></li>\n<li><span data-contrast=\"auto\">Experience using data to drive decision-making</span><span data-ccp-props=\"{}\">&nbsp;</span></li>\n<li><span data-contrast=\"auto\">Significant experience with distributed systems, data structures, and algorithms</span><span data-ccp-props=\"{}\">&nbsp;</span></li>\n<li><span data-contrast=\"auto\">Solid understanding of multi-threaded/multi-core programming paradigms</span><span data-ccp-props=\"{}\">&nbsp;</span></li>\n<li><span data-contrast=\"auto\">Highly collaborative in nature, with excellent written and verbal communication skills</span><span data-ccp-props=\"{}\">&nbsp;</span></li>\n<li><span data-contrast=\"auto\">Bachelor’s degree in Computer Science, Engineering, Math or equivalent</span><span data-ccp-props=\"{}\">&nbsp;</span></li>\n<li><span data-ccp-props=\"{}\">The ability to react quickly and accurately to rapidly changing market conditions, including the ability to quickly and accurately respond and/or solve math and coding problems are essential functions of the role</span></li>\n</ul>\n<p><strong><em>In addition to technical skillsets, Akuna values the unique perspectives people can bring to the table to collaboratively solve complex problems and drive Akuna forward. We want everyone to feel empowered to apply. We welcome your application and encourage you to take the first steps toward your future with us!</em></strong></p>\n<p><em><span class=\"TextRun SCXW16753980 BCX0\" lang=\"EN-US\" data-contrast=\"none\"><span class=\"NormalTextRun SCXW16753980 BCX0\">Please note that level/title, as well as team placement, will be determined upon the conclusion of the interview process. If you are&nbsp;</span><span class=\"NormalTextRun SCXW16753980 BCX0\">a current student or recent graduat</span><span class=\"NormalTextRun SCXW16753980 BCX0\">e</span><span class=\"NormalTextRun SCXW16753980 BCX0\">, </span><span class=\"NormalTextRun SCXW16753980 BCX0\">please </span><span class=\"NormalTextRun SCXW16753980 BCX0\">take a look</span><span class=\"NormalTextRun SCXW16753980 BCX0\"> at our Entry Level and Intern positions</span></span><span class=\"TextRun SCXW16753980 BCX0\" lang=\"EN-US\" data-contrast=\"none\"><span class=\"NormalTextRun SCXW16753980 BCX0\">.&nbsp;</span></span></em></p>\n<p><em><span class=\"TextRun SCXW16753980 BCX0\" lang=\"EN-US\" data-contrast=\"none\"><span class=\"NormalTextRun SCXW16753980 BCX0\">In accordance with Illinois Equal Pay Act, the minimum base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. This role is also eligible for a discretionary performance bonus as part of the total compensation package and includes a comprehensive benefits package that may encompass employer-paid medical, dental, vision, retirement contributions, paid time off, and other benefits. The minimum base salary herein was determined in good faith by Akuna Capital LLC.</span></span></em></p>","compensation":[],"custom_fields":{"Employment Type":"Full-time","Careers Site Section":["Experienced"],"Specialty":["C++"],"Experience":"Experienced","Crossfilter":["Development"]},"status":"open","first_seen_at":"2026-08-24T14:34:26.860Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":true,"tier":"stretch","score":5,"level":"unspecified","term":null,"tracks":["quant","software"],"role_matches":["Software Engineer","Trading"],"early_career_matches":[],"positive_matches":["Software Engineer"],"exclude_matches":[],"configured_tracks":["quant"]}}
{"schema_version":1,"job_key":"greenhouse:akunacapital:7496411","source":{"type":"greenhouse","board":"akunacapital","job_id":"7496411","source_url":"https://boards-api.greenhouse.io/v1/boards/akunacapital/jobs","response_hash":"4ab0603b4509bf82630fefb6212f0994625afafafba28d4c336e5277cfbbca1c","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Akuna Capital","slug":"akuna-capital","lists":["quant"],"target_role":null,"fit_tier":null},"title":"Software Engineer - Data Engineering","canonical_url":"https://www.akunacapital.com/careers/job/7496411?gh_jid=7496411","apply_url":"https://www.akunacapital.com/careers/job/7496411/?gh_jid=7496411","locations":[{"label":"Chicago, IL"},{"label":"Chicago, Illinois, United States"}],"workplace_type":"unknown","employment_type":"full_time","departments":["Data"],"teams":[],"language":"en","requisition_id":"254","internal_job_id":3325447,"first_published_at":"2026-01-02T11:26:14-05:00","source_updated_at":"2026-07-13T13:29:51-04:00","application_deadline":null,"description_plain":"About Akuna:\n\nAkuna Capital is an innovative trading firm with a strong focus on collaboration, cutting-edge technology, data driven solutions, and automation. We specialize in providing liquidity as an options market maker – meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully, we design and implement our own low latency technologies, trading strategies, and mathematical models.\n\nOur Founding Partners first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to operate from additional offices in Sydney, Shanghai, London and Singapore.\n\nWhat you’ll do as a Software Engineer on the Data Engineering team at Akuna:\n\nWe are a data-driven organization, leveraging our data as a key competitive advantage essential to our success. The Akuna Data Engineering team is composed of world-class talent responsible for designing, building, and maintaining the systems, applications, and infrastructure needed to collect, store, process, manage, and query Akuna’s data assets. The Akuna Data Engineering team plays a crucial role in ensuring that trustworthy data is available, reliable, and accessible to support various data-driven initiatives within Akuna’s Quant, Trading, and Business Operations business units.\n\nIn this role, you will:\n\n- Work within a growing Data Engineering division supporting the strategic role of data at Akuna\n\n- Drive the ongoing design and expansion of our data platform across a wide variety of data sources, supporting an array of streaming, operational and research workflows\n\n- Work closely with Trading, Quant, Technology & Business Operations teams throughout the firm to identify how data is produced and consumed, helping to define and deliver high impact projects\n\n- Build and deploy batch and streaming pipelines to collect and transform our rapidly growing Big Data set within our hybrid cloud architecture utilizing Kubernetes/EKS, Kafka/MSK and Databricks/Spark.\n\n- Mentor junior engineers in software and data engineering best practices\n\n- Produce clean, well-tested, and documented code with a clear design to support mission critical applications\n\n- Build automated data validation test suites that ensure that data is processed and published in accordance with well-defined Service Level Agreements (SLA’s) pertaining to data quality, data availability and data correctness\n\n- Challenge the status quo and help push our organization forward, as we grow beyond the limits of our current tech stack\n\nQualities that make great candidates:\n\n- BS/MS/PhD in Computer Science, Engineering, Physics, Math, or equivalent technical field\n\n- 5+ years of professional experience developing software applications\n\n- Java/Scala experience required – Python experience a significant plus\n\n- Highly motivated and willing to take ownership of high-impact projects upon arrival\n\n- Prior hands-on experience with data platforms and technologies such as Delta Lake, Spark, Kubernetes, Kafka, ClickHouse, and/or Presto/Trino\n\n- Experience building large-scale batch and streaming pipelines with strict SLA and data quality requirements\n\n- Must possess excellent communication, analytical, and problem-solving skills\n\n- Demonstrated experience working with diverse data sets and frameworks across multiple domains – financial data experience not required, but a strong plus\n\n- Recent hands-on experience with AWS Cloud development, deployment and monitoring necessary\n\n- Demonstrated experience working on an Agile team employing software engineering best practices, such as GitOps and CI/CD, to deliver complex software projects\n\n- The ability to react quickly and accurately to rapidly changing market conditions, including the ability to quickly and accurately respond and/or solve math and coding problems are essential functions of the role\n\nPlease note that level/title will be determined upon the conclusion of the interview process. If you are a current student or recent graduate, please take a look at our Entry Level and Intern positions.\n\nIn addition to technical skillsets, Akuna values the unique perspectives people can bring to the table to collaboratively solve complex problems and drive Akuna forward. We want everyone to feel empowered to apply. We welcome your application and encourage you to take the first steps toward your future with us!\n\nIn accordance with Illinois Equal Pay Act, the minimum base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. This role is also eligible for a discretionary performance bonus as part of the total compensation package and includes a comprehensive benefits package that may encompass employer-paid medical, dental, vision, retirement contributions, paid time off, and other benefits. The minimum base salary herein was determined in good faith by Akuna Capital LLC.","description_html":"<p><strong>About Akuna:</strong></p>\n<p>Akuna Capital is an innovative trading firm with a strong focus on collaboration, cutting-edge technology, data driven solutions, and automation. We specialize in providing liquidity as an options market maker – meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully, we design and implement our own low latency technologies, trading strategies, and mathematical models.</p>\n<p>Our Founding Partners<em> </em>first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. <span data-contrast=\"none\"><span data-ccp-parastyle=\"Normal (Web)\">Today, Akuna is proud to operate from additional offices in Sydney, Shanghai, London and Singapore.</span></span></p>\n<p><strong>What you’ll do as a Software Engineer on the Data Engineering team at Akuna:</strong></p>\n<p>We are a data-driven organization, leveraging our data as a key competitive advantage essential to our success. The Akuna Data Engineering team is composed of world-class talent responsible for designing, building, and maintaining the systems, applications, and infrastructure needed to collect, store, process, manage, and query Akuna’s data assets. The Akuna Data Engineering team plays a crucial role in ensuring that trustworthy data is available, reliable, and accessible to support various data-driven initiatives within Akuna’s Quant, Trading, and Business Operations business units.&nbsp;&nbsp;&nbsp;</p>\n<p><strong>In this role, you will:</strong></p>\n<ul>\n<li>Work within a growing Data Engineering division supporting the strategic role of data at Akuna</li>\n<li>Drive the ongoing design and expansion of our data platform across a wide variety of data sources, supporting an array of streaming, operational and research workflows</li>\n<li>Work closely with Trading, Quant, Technology &amp; Business Operations teams throughout the firm to identify how data is produced and consumed, helping to define and deliver high impact projects</li>\n<li>Build and deploy batch and streaming pipelines to collect and transform our rapidly growing Big Data set within our hybrid cloud architecture utilizing Kubernetes/EKS, Kafka/MSK and Databricks/Spark.</li>\n<li>Mentor junior engineers in software and data engineering best practices</li>\n<li>Produce clean, well-tested, and documented code with a clear design to support mission critical applications</li>\n<li>Build automated data validation test suites that ensure that data is processed and published in accordance with well-defined Service Level Agreements (SLA’s) pertaining to data quality, data availability and data correctness</li>\n<li>Challenge the status quo and help push our organization forward, as we grow beyond the limits of our current tech stack</li>\n</ul>\n<p><strong>Qualities that make great candidates:</strong></p>\n<ul>\n<li>BS/MS/PhD in Computer Science, Engineering, Physics, Math, or equivalent technical field</li>\n<li>5+ years of professional experience developing software applications</li>\n<li>Java/Scala experience required – Python experience a significant plus</li>\n<li>Highly motivated and willing to take ownership of high-impact projects upon arrival</li>\n<li>Prior hands-on experience with data platforms and technologies such as Delta Lake, Spark, Kubernetes, Kafka, ClickHouse, and/or Presto/Trino</li>\n<li>Experience building large-scale batch and streaming pipelines with strict SLA and data quality requirements</li>\n<li>Must possess excellent communication, analytical, and problem-solving skills</li>\n<li>Demonstrated experience working with diverse data sets and frameworks across multiple domains – financial data experience not required, but a strong plus</li>\n<li>Recent hands-on experience with AWS Cloud development, deployment and monitoring necessary</li>\n<li>Demonstrated experience working on an Agile team employing software engineering best practices, such as GitOps and CI/CD, to deliver complex software projects</li>\n<li>The ability to react quickly and accurately to rapidly changing market conditions, including the ability to quickly and accurately respond and/or solve math and coding problems are essential functions of the role</li>\n</ul>\n<p><em><span data-contrast=\"none\">Please note that level/title will be determined upon the conclusion of the interview process. If you are a current student or recent graduate, please take a look at our Entry Level and Intern positions.</span></em></p>\n<p><strong><em>In addition to technical skillsets, Akuna values the unique perspectives people can bring to the table to collaboratively solve complex problems and drive Akuna forward. We want everyone to feel empowered to apply. We welcome your application and encourage you to take the first steps toward your future with us!</em></strong></p>\n<p><em>In accordance with Illinois Equal Pay Act, the minimum base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. This role is also eligible for a discretionary performance bonus as part of the total compensation package and includes a comprehensive benefits package that may encompass employer-paid medical, dental, vision, retirement contributions, paid time off, and other benefits. The minimum base salary herein was determined in good faith by Akuna Capital LLC.</em></p>\n<p>&nbsp;</p>","compensation":[],"custom_fields":{"Employment Type":"Full-time","Careers Site Section":["Experienced"],"Specialty":["DATA INFRASTRUCTURE","PYTHON","SCALA"],"Experience":"Experienced","Crossfilter":["Development"]},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":true,"tier":"stretch","score":5,"level":"unspecified","term":null,"tracks":["data","software"],"role_matches":["Software Engineer","Data Engineering"],"early_career_matches":[],"positive_matches":["Software Engineer"],"exclude_matches":[],"configured_tracks":["quant"]}}
{"schema_version":1,"job_key":"greenhouse:akunacapital:8096516","source":{"type":"greenhouse","board":"akunacapital","job_id":"8096516","source_url":"https://boards-api.greenhouse.io/v1/boards/akunacapital/jobs","response_hash":"0ee4c9c6722c43914b086694342d3ff60ae81bf88cd666e68245dfbb01d998a5","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Akuna Capital","slug":"akuna-capital","lists":["quant"],"target_role":null,"fit_tier":null},"title":"Software Engineer - Python, Business Operations","canonical_url":"https://www.akunacapital.com/careers/job/8096516?gh_jid=8096516","apply_url":"https://www.akunacapital.com/careers/job/8096516/?gh_jid=8096516","locations":[{"label":"Chicago, IL"},{"label":"Chicago, Illinois, United States"}],"workplace_type":"unknown","employment_type":"full_time","departments":["Python"],"teams":[],"language":"en","requisition_id":"284","internal_job_id":3507527,"first_published_at":"2026-08-11T18:16:36-04:00","source_updated_at":"2026-08-11T18:16:36-04:00","application_deadline":null,"description_plain":"About Akuna:\n\nAkuna Capital is an innovative trading firm with a strong focus on collaboration, cutting-edge technology, data driven solutions, and automation. We specialize in providing liquidity as an options market-maker – meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully, we design and implement our own low latency technologies, trading strategies, and mathematical models.\n\nOur Founding Partners first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to operate from additional offices in Sydney, Shanghai, London, and Singapore.\n\nWhat you'll do as a Software Engineer - Business Operations at Akuna:\n\nThis role is the primary ongoing development resource for Business Operations technology, primarily supporting Procurement, Finance, and Human Resources. The current priority is a data infrastructure project that consolidates cost data from several internal systems into a unified cost-attribution framework, but the role is not scoped to that project alone - it will take on a broadening range of development work across these functions over time. A defining requirement of this role is applying AI capabilities - through native AI features in existing tools, API integrations, and protocols such as MCP (Model Context Protocol) - to improve data workflows, reporting, and operational processes across these functions. In this role, you will:\n\n- Lead the development efforts for our FP&A Cost Attribution Project\n\n- Serve as lead developer for the development of a bitemporal PostgreSQL database that enables traceable cost allocation, with a schema designed to become more granular as business requirements evolve\n\n- Build and maintain integrations pulling data from Jira, NetSuite, Device42, and Bitbucket, among other data sources, to support cost attribution logic\n\n- Support the project toward its Q1 2027 deployment target, including schema documentation and handoff materials, and maintain the system once in production\n\n- Lead engineering efforts in support of our Business Operations teams\n\n- Work with the Procurement team to rebuild the current quote order management systems\n\n- Support Finance and HR operations by building data pipelines, automating reports, and integrating systems as needs arise\n\n- Act as a general-purpose development resource across these functions, prioritizing work in coordination with the Director of Operations\n\n- Identify and implement native AI features within tools already in use by Procurement, Finance, HR, Compliance, and Risk, such as AI capabilities embedded in NetSuite, Jira, Confluence, or other platforms\n\n- Build custom integrations using APIs, MCP, or comparable protocols to connect large language models to internal systems and workflows\n\n- Evaluate current manual processes across these functions and propose and implement AI-assisted or automated alternatives\n\n- Work with the Security team to maintain security best practices and appropriate data-handling controls when integrating AI tooling with internal or vendor systems\n\nQualities that make great candidates:\n\n- Bachelor's degree in Computer Science, Engineering, Information Systems, or equivalent practical experience\n\n- Professional software development experience (minimum 3-5 years), with demonstrated ability to work as a sole or lead developer on cross-functional projects\n\n- Strong proficiency in a backend language commonly used for data integration and automation work, such as Python\n\n- Strong SQL skills and relational database design experience; direct experience with PostgreSQL is preferred\n\n- Demonstrated experience building and consuming REST APIs, including authentication, error handling, and data transformation across systems that were not designed to work together\n\n- Direct experience integrating with at least several of the following, or clearly transferable equivalents: Jira/JSM (API/scripting), NetSuite (SuiteScript/SuiteTalk or equivalent), Atlassian Bitbucket/Git, and CMDB-type tools such as Device42\n\n- Hands-on experience integrating LLM/AI APIs, such as Anthropic or OpenAI, into applications or workflows, including prompt construction and handling structured and unstructured outputs\n\n- Version control proficiency with Git and comfort working in a Bitbucket-based environment\n\n- Ability to communicate technical concepts and tradeoffs clearly to non-technical stakeholders in Finance, Procurement, and HR\n\n- Ability to work independently, manage competing priorities across multiple business functions, and operate with minimal direct technical oversight\n\n- Prior experience in financial services, trading, or a similarly data- and compliance-sensitive industry\n\n- Experience with cost allocation, chargeback, or FinOps-style frameworks\n\n- Experience building internal tools or dashboards for non-technical business users\n\n- Exposure to procurement or vendor management systems\n\n- The ability to react quickly and accurately to rapidly changing market conditions, including the ability to quickly and accurately respond and/or solve math and coding problems are essential functions of the role\n\nIn addition to technical skillsets, Akuna values the unique perspectives people can bring to the table to collaboratively solve complex problems and drive Akuna forward. We want everyone to feel empowered to apply. We welcome your application and encourage you to take the first steps toward your future with us!\n\nIn accordance with Illinois Equal Pay Act, the minimum base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. This role is also eligible for a discretionary performance bonus as part of the total compensation package and includes a comprehensive benefits package that may encompass employer-paid medical, dental, vision, retirement contributions, paid time off, and other benefits. The minimum base salary herein was determined in good faith by Akuna Capital LLC.","description_html":"<p><strong><span data-contrast=\"none\">About Akuna:</span></strong><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:200,&quot;335559740&quot;:276}\">&nbsp;</span></p>\n<p><span data-contrast=\"none\">Akuna Capital is an innovative trading firm with a strong focus on collaboration, cutting-edge technology, data driven solutions, and automation. We specialize in providing liquidity as an options market-maker – meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully, we design and implement our own low latency technologies, trading strategies, and mathematical models.</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559685&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:300}\">&nbsp;</span></p>\n<p><span data-contrast=\"none\">Our Founding Partners</span><em> </em><span data-contrast=\"none\">first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to operate from additional offices in Sydney, Shanghai, London, and Singapore.</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559685&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:300}\">&nbsp;</span></p>\n<p><strong><span data-contrast=\"none\">What you'll do as a Software Engineer - Business Operations at Akuna:</span></strong><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335557856&quot;:16777215,&quot;335559685&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:300}\">&nbsp;</span></p>\n<p><span data-contrast=\"auto\">This role is the primary ongoing development resource for Business Operations technology, primarily supporting Procurement, Finance, and Human Resources. The current priority is a data infrastructure project that consolidates cost data from several internal systems into a unified cost-attribution framework, but the role is not scoped to that project alone - it will take on a broadening range of development work across these functions over time. A defining requirement of this role is applying AI capabilities - through native AI features in existing tools, API integrations, and protocols such as MCP (Model Context Protocol) - to improve data workflows, reporting, and operational processes across these functions. In this role, you will:&nbsp;</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:257}\">&nbsp;</span></p>\n<ul>\n<li data-leveltext=\"•\" data-font=\"Calibri\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Calibri&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;•&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">Lead the development efforts for our FP&amp;A Cost Attribution Project</span>\n<ul>\n<li data-leveltext=\"•\" data-font=\"Calibri\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Calibri&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;•&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\">Serve as lead developer for the development of a bitemporal PostgreSQL database that enables traceable cost allocation, with a schema designed to become more granular as business requirements evolve</li>\n<li data-leveltext=\"•\" data-font=\"Calibri\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Calibri&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;•&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\">Build and maintain integrations pulling data from Jira, NetSuite, Device42, and Bitbucket, among other data sources, to support cost attribution logic</li>\n<li data-leveltext=\"•\" data-font=\"Calibri\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Calibri&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;•&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\">Support the project toward its Q1 2027 deployment target, including schema documentation and handoff materials, and maintain the system once in production</li>\n</ul>\n</li>\n<li data-leveltext=\"•\" data-font=\"Calibri\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Calibri&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;•&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\">Lead engineering efforts in support of our Business Operations teams</li>\n<li data-leveltext=\"•\" data-font=\"Calibri\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Calibri&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;•&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\">Work with the Procurement team to rebuild the current quote order management systems</li>\n<li data-leveltext=\"•\" data-font=\"Calibri\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Calibri&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;•&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\">Support Finance and HR operations by building data pipelines, automating reports, and integrating systems as needs arise</li>\n<li data-leveltext=\"•\" data-font=\"Calibri\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Calibri&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;•&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\">Act as a general-purpose development resource across these functions, prioritizing work in coordination with the Director of Operations</li>\n<li data-leveltext=\"•\" data-font=\"Calibri\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Calibri&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;•&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\">Identify and implement native AI features within tools already in use by Procurement, Finance, HR, Compliance, and Risk, such as AI capabilities embedded in NetSuite, Jira, Confluence, or other platforms</li>\n<li data-leveltext=\"•\" data-font=\"Calibri\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Calibri&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;•&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\">Build custom integrations using APIs, MCP, or comparable protocols to connect large language models to internal systems and workflows</li>\n<li data-leveltext=\"•\" data-font=\"Calibri\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Calibri&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;•&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\">Evaluate current manual processes across these functions and propose and implement AI-assisted or automated alternatives</li>\n<li data-leveltext=\"•\" data-font=\"Calibri\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Calibri&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;•&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\">Work with the Security team to maintain security best practices and appropriate data-handling controls when integrating AI tooling with internal or vendor systems</li>\n</ul>\n<p><strong><span data-contrast=\"auto\">Qualities that make great candidates:</span></strong><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:0,&quot;335559738&quot;:160,&quot;335559739&quot;:80,&quot;335559740&quot;:257}\">&nbsp;</span></p>\n<ul>\n<li data-leveltext=\"•\" data-font=\"Calibri\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Calibri&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;•&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"10\" data-aria-level=\"1\"><span data-contrast=\"auto\">Bachelor's degree in Computer Science, Engineering, Information Systems, or equivalent practical experience</span></li>\n<li data-leveltext=\"•\" data-font=\"Calibri\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Calibri&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;•&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"10\" data-aria-level=\"1\">Professional software development experience (minimum 3-5 years), with demonstrated ability to work as a sole or lead developer on cross-functional projects</li>\n<li data-leveltext=\"•\" data-font=\"Calibri\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Calibri&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;•&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"10\" data-aria-level=\"1\">Strong proficiency in a backend language commonly used for data integration and automation work, such as Python</li>\n<li data-leveltext=\"•\" data-font=\"Calibri\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Calibri&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;•&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"10\" data-aria-level=\"1\">Strong SQL skills and relational database design experience; direct experience with PostgreSQL is preferred</li>\n<li data-leveltext=\"•\" data-font=\"Calibri\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Calibri&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;•&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"10\" data-aria-level=\"1\">Demonstrated experience building and consuming REST APIs, including authentication, error handling, and data transformation across systems that were not designed to work together</li>\n<li data-leveltext=\"•\" data-font=\"Calibri\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Calibri&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;•&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"10\" data-aria-level=\"1\">Direct experience integrating with at least several of the following, or clearly transferable equivalents: Jira/JSM (API/scripting), NetSuite (SuiteScript/SuiteTalk or equivalent), Atlassian Bitbucket/Git, and CMDB-type tools such as Device42</li>\n<li data-leveltext=\"•\" data-font=\"Calibri\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Calibri&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;•&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"10\" data-aria-level=\"1\">Hands-on experience integrating LLM/AI APIs, such as Anthropic or OpenAI, into applications or workflows, including prompt construction and handling structured and unstructured outputs</li>\n<li data-leveltext=\"•\" data-font=\"Calibri\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Calibri&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;•&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"10\" data-aria-level=\"1\">Version control proficiency with Git and comfort working in a Bitbucket-based environment</li>\n<li data-leveltext=\"•\" data-font=\"Calibri\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Calibri&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;•&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"10\" data-aria-level=\"1\">Ability to communicate technical concepts and tradeoffs clearly to non-technical stakeholders in Finance, Procurement, and HR</li>\n<li data-leveltext=\"•\" data-font=\"Calibri\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Calibri&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;•&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"10\" data-aria-level=\"1\">Ability to work independently, manage competing priorities across multiple business functions, and operate with minimal direct technical oversight</li>\n<li data-leveltext=\"•\" data-font=\"Calibri\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Calibri&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;•&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"10\" data-aria-level=\"1\">Prior experience in financial services, trading, or a similarly data- and compliance-sensitive industry</li>\n<li data-leveltext=\"•\" data-font=\"Calibri\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Calibri&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;•&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"10\" data-aria-level=\"1\">Experience with cost allocation, chargeback, or FinOps-style frameworks</li>\n<li data-leveltext=\"•\" data-font=\"Calibri\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Calibri&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;•&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"10\" data-aria-level=\"1\">Experience building internal tools or dashboards for non-technical business users</li>\n<li data-leveltext=\"•\" data-font=\"Calibri\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Calibri&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;•&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"10\" data-aria-level=\"1\">Exposure to procurement or vendor management systems</li>\n<li data-leveltext=\"•\" data-font=\"Calibri\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Calibri&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;•&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"10\" data-aria-level=\"1\">The ability to react quickly and accurately to rapidly changing market conditions, including the ability to quickly and accurately respond and/or solve math and coding problems are essential functions of the role</li>\n</ul>\n<p><strong><em>In addition to technical skillsets, Akuna values the unique perspectives people can bring to the table to collaboratively solve complex problems and drive Akuna forward. We want everyone to feel empowered to apply. We welcome your application and encourage you to take the first steps toward your future with us!</em></strong></p>\n<p><span data-contrast=\"none\"><em>In accordance with Illinois Equal Pay Act, the minimum base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. This role is also eligible for a discretionary performance bonus as part of the total compensation package and includes a comprehensive benefits package that may encompass employer-paid medical, dental, vision, retirement contributions, paid time off, and other benefits. The minimum base salary herein was determined in good faith by Akuna Capital LLC.</em></span></p>","compensation":[],"custom_fields":{"Employment Type":"Full-time","Careers Site Section":["Experienced"],"Specialty":["PYTHON"],"Experience":"Experienced","Crossfilter":["Business Operations","Development"]},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":true,"tier":"stretch","score":3,"level":"unspecified","term":null,"tracks":["software"],"role_matches":["Software Engineer"],"early_career_matches":[],"positive_matches":["Software Engineer"],"exclude_matches":[],"configured_tracks":["quant"]}}
{"schema_version":1,"job_key":"greenhouse:akunacapital:8013085","source":{"type":"greenhouse","board":"akunacapital","job_id":"8013085","source_url":"https://boards-api.greenhouse.io/v1/boards/akunacapital/jobs","response_hash":"0226a7a80b123c146b9f642de8aafa6f4fd3f7647ca3368f0b539315dd8788da","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Akuna Capital","slug":"akuna-capital","lists":["quant"],"target_role":null,"fit_tier":null},"title":"Software Engineer (Entry-Level) - C++","canonical_url":"https://www.akunacapital.com/careers/job/8013085?gh_jid=8013085","apply_url":"https://www.akunacapital.com/careers/job/8013085/?gh_jid=8013085","locations":[{"label":"Chicago, IL"},{"label":"Chicago, Illinois, United States"}],"workplace_type":"unknown","employment_type":"full_time","departments":["Engineering"],"teams":[],"language":"en","requisition_id":null,"internal_job_id":3474192,"first_published_at":"2026-07-13T14:41:18-04:00","source_updated_at":"2026-07-14T14:29:19-04:00","application_deadline":null,"description_plain":"About Akuna\n\nAkuna Capital is an innovative trading firm with a strong focus on collaboration, cutting-edge technology, data-driven solutions, and automation. We specialize in providing liquidity on a variety of exchanges across various asset classes, primarily as an options market maker. To do this successfully, we build and maintain our own low-latency technologies, including application frameworks, trading strategies, and mathematical models.\n\nOur Founding Partners first conceptualized Akuna in their hometown of Sydney, Australia. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to operate from additional offices around the world: Sydney, Shanghai, Singapore, and London.\n\nWhat You’ll Do as an Entry-Level C++ Software Engineer at Akuna\n\nC++ software engineers at Akuna have the opportunity to work on a variety of high-performance systems that power the firm’s core business operations. Our engineers work on small-to-medium-sized teams that frequently interface with Quant and Trading, allowing them to build expertise in a specific domain area while maintaining broader exposure to the needs of their end-users. Akuna’s C++ systems are heavily multithreaded, asynchronous, and distributed by nature, which comes with a slew of challenges; our engineers are tasked with ensuring these systems are reliable, efficient, scalable, and flexible enough for even the most niche use cases. Entry-level engineers in particular are responsible for day-to-day upkeep of core systems, servicing lower-risk feature requests, and executing individual projects on behalf of their team’s stakeholders.\n\nAkuna is looking for software engineers who are motivated, can solve complex problems, and are willing to reach for creative solutions when faced with novel problems. We value innovation, hard work, and knowledge, and we want our engineers to make a direct impact on the firm. Whether you are interested in algorithms and data structures, concurrency, networking and protocols, performance tuning, data capture and analysis, mathematical modeling, hardware, or something else, there’s engaging work to be done.\n\nRequirements for This Role\n\n- Pursuing a bachelor’s, master’s, or Ph.D. in a technical field (computer science/engineering, math, physics, or equivalent)\n\n- Graduating by August 2027\n\n- Legal authorization to work in the U.S. as of the first day of employment, including F-1 students using OPT or STEM\n\nPrevious experience in finance or trading is not required. Many of our engineers joined Akuna with little-to-no prior knowledge of the markets, and we pride ourselves on our ability to onboard those new to the industry. Training and continuous education are provided for all engineers to ensure they can build the requisite technical and non-technical skillset for success.\n\nQualities That Make a Great C++ Software Engineer Candidate\n\n- Experience programming in modern C++ (C++20 or later; C++23 preferred)\n\n- Experience with several of the following\n\n-\n\n- Distributed systems\n\n-\n\n- Parallel processing\n\n-\n\n- Asynchronous architectures\n\n-\n\n- Networking or protocol encoding/decoding\n\n-\n\n- Lock-free data structures and algorithms\n\n-\n\n- Performance profiling (e.g. perf, gprof, vtune)\n\n-\n\n- Scripting, such as in Python or shell\n\n- Familiarity with standard debugging tools (e.g. GDB, Valgrind, address sanitizer)\n\n- The ability to effectively communicate with non-technical stakeholders in Quant and Trading to obtain requirements, workshop solutions, and implement agreed-upon roadmaps\n\n- The ability to react quickly and effectively to rapidly changing market conditions, including the ability to quickly and accurately respond and/or solve math and coding problems, is an essential function of the role\n\n- A passion for building complex systems from the ground up\n\n- The ability to collaborate with other developers of different backgrounds, specialties, and knowledge levels to collectively deliver cohesive solutions to non-trivial problems\n\n- An intrinsically motivated attitude and the ability to work independently\n\n- A strong sense of ownership, including a drive to fix bugs when they inevitably arise\n\nIn addition to the above technical skills, Akuna values diversity of experience and perspective. We believe that engineers with varied backgrounds and interests allow us to approach problems from unique angles and to uncover innovative, optimal solutions. We want everyone to feel empowered to apply; we welcome your application, and we strongly encourage you to take the first steps in joining us in the future!\n\nResumes must be submitted in PDF format.\n\nBy applying to this role, you are indicating this is your top preference and acknowledge you will not be considered for other Quant and/or Tech roles at Akuna this recruiting season. This acknowledgement does not limit applications to Trading roles - in addition to this role, you may apply to any Trader roles of interest.\n\nWe are an AI-friendly company and encourage employees to leverage AI in their daily work. However, AI assistance is not permitted during interviews or assessments . Our interview process is designed to evaluate your individual skills and judgment , and the use of AI tools will result in disqualification from the hiring process.\n\nIn accordance with the Illinois Equal Pay Act, the minimum base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. This role is also eligible for a discretionary performance bonus as part of the total compensation package and includes a comprehensive benefits package that may encompass employer-paid medical, dental, vision, retirement contributions, paid time off, and other benefits. The minimum base salary herein was determined in good faith by Akuna Capital LLC.","description_html":"<div class=\"OutlineElement Ltr SCXW256449397 BCX0\">\n<p><strong><span data-contrast=\"auto\">About Akuna</span></strong><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<p><span data-contrast=\"auto\">Akuna Capital is an innovative trading firm with a strong focus on collaboration,&nbsp;cutting-edge&nbsp;technology, data-driven solutions, and automation. We specialize in providing liquidity on a variety of exchanges&nbsp;across various asset classes, primarily as&nbsp;an options market maker. To do this successfully, we&nbsp;build&nbsp;and&nbsp;maintain&nbsp;our own low-latency technologies, including application frameworks, trading strategies, and mathematical models.</span><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<p><span data-contrast=\"auto\">Our Founding Partners first conceptualized Akuna in their hometown of Sydney, Australia. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to&nbsp;operate&nbsp;from&nbsp;additional&nbsp;offices around the world:&nbsp;Sydney, Shanghai, Singapore, and London.</span><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<p><strong><span data-contrast=\"auto\">What You’ll Do as an Entry-Level C++ Software Engineer at Akuna</span></strong><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<p><span data-contrast=\"auto\">C++ software engineers at Akuna&nbsp;have&nbsp;the opportunity to work on a variety of high-performance systems that&nbsp;power&nbsp;the firm’s core business operations.&nbsp;Our engineers work on small-to-medium-sized teams that&nbsp;frequently&nbsp;interface with Quant and Trading, allowing them to build&nbsp;expertise&nbsp;in a specific domain area while&nbsp;maintaining&nbsp;broader exposure to the needs of their end-users.&nbsp;Akuna’s C++ systems are heavily multithreaded, asynchronous, and distributed by nature, which comes with a slew of challenges; our&nbsp;engineers are tasked with ensuring these systems&nbsp;are&nbsp;reliable,&nbsp;efficient, scalable,&nbsp;and flexible enough for&nbsp;even the most&nbsp;niche use cases. Entry-level engineers&nbsp;in particular&nbsp;are&nbsp;responsible for&nbsp;day-to-day upkeep of core systems, servicing lower-risk feature requests, and executing&nbsp;individual projects on behalf of their&nbsp;team’s&nbsp;stakeholders.</span><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<p><span data-contrast=\"auto\">Akuna is&nbsp;looking for software engineers who are motivated,&nbsp;can solve complex problems, and are willing to reach for&nbsp;creative&nbsp;solutions when faced with novel problems. We value innovation, hard work, and knowledge, and we want&nbsp;our engineers to make a direct&nbsp;impact on the firm. Whether you are interested in algorithms and data structures, concurrency, networking and protocols, performance tuning, data capture and analysis, mathematical modeling, hardware, or something&nbsp;else,&nbsp;there’s&nbsp;engaging work to be done.</span><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<p><strong><span data-contrast=\"auto\">Requirements</span></strong><strong><span data-contrast=\"auto\">&nbsp;for This Role</span></strong><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">Pursuing a bachelor’s,&nbsp;master’s, or&nbsp;Ph.D. in a technical field (computer science/engineering, math,&nbsp;physics, or equivalent)</span><span data-ccp-props=\"{}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"2\" data-aria-level=\"1\"><span data-contrast=\"auto\">Graduating&nbsp;by&nbsp;August 2027</span><span data-ccp-props=\"{}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"3\" data-aria-level=\"1\"><span data-contrast=\"auto\">Legal authorization to work in the U.S. as of the first day of employment, including F-1 students using OPT or STEM</span><span data-ccp-props=\"{}\">&nbsp;</span></li>\n</ul>\n<p><span data-contrast=\"auto\">Previous&nbsp;experience in finance or trading is&nbsp;</span><strong><span data-contrast=\"auto\">not</span></strong><span data-contrast=\"auto\">&nbsp;required.&nbsp;Many of our&nbsp;engineers&nbsp;joined&nbsp;Akuna with little-to-no&nbsp;prior&nbsp;knowledge&nbsp;of the markets, and we pride ourselves on our ability to onboard those new to the industry. Training and continuous education are provided for all engineers to ensure they can build&nbsp;the requisite technical and non-technical skillset for success.</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559685&quot;:0,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></p>\n<p><strong><span data-contrast=\"auto\">Qualities That Make a Great C++ Software Engineer Candidate</span></strong><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559685&quot;:0,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></p>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">Experience programming in modern C++ (C++20&nbsp;or later;&nbsp;C++23&nbsp;preferred)</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"2\" data-aria-level=\"1\"><span data-contrast=\"auto\">Experience with several of the following</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li>\n<ul>\n<li data-leveltext=\"o\" data-font=\"Courier New\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:1440,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Courier New&quot;,&quot;469769242&quot;:[9675],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;o&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"2\"><span data-contrast=\"auto\">Distributed systems</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></li>\n</ul>\n</li>\n</ul>\n<ul>\n<li>\n<ul>\n<li data-leveltext=\"o\" data-font=\"Courier New\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:1440,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Courier New&quot;,&quot;469769242&quot;:[9675],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;o&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"2\" data-aria-level=\"2\"><span data-contrast=\"auto\">Parallel processing</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></li>\n</ul>\n</li>\n</ul>\n<ul>\n<li>\n<ul>\n<li data-leveltext=\"o\" data-font=\"Courier New\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:1440,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Courier New&quot;,&quot;469769242&quot;:[9675],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;o&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"3\" data-aria-level=\"2\"><span data-contrast=\"auto\">Asynchronous&nbsp;architectures</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></li>\n</ul>\n</li>\n</ul>\n<ul>\n<li>\n<ul>\n<li data-leveltext=\"o\" data-font=\"Courier New\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:1440,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Courier New&quot;,&quot;469769242&quot;:[9675],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;o&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"4\" data-aria-level=\"2\"><span data-contrast=\"auto\">Networking or protocol encoding/decoding</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></li>\n</ul>\n</li>\n</ul>\n<ul>\n<li>\n<ul>\n<li data-leveltext=\"o\" data-font=\"Courier New\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:1440,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Courier New&quot;,&quot;469769242&quot;:[9675],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;o&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"5\" data-aria-level=\"2\"><span data-contrast=\"auto\">Lock-free data structures and&nbsp;algorithms</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559685&quot;:1440,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n</li>\n</ul>\n<ul>\n<li>\n<ul>\n<li data-leveltext=\"o\" data-font=\"Courier New\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:1440,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Courier New&quot;,&quot;469769242&quot;:[9675],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;o&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"6\" data-aria-level=\"2\"><span data-contrast=\"auto\">Performance profiling (e.g.&nbsp;perf,&nbsp;gprof,&nbsp;vtune)</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559685&quot;:1440,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n</li>\n</ul>\n<ul>\n<li>\n<ul>\n<li data-leveltext=\"o\" data-font=\"Courier New\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:1440,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Courier New&quot;,&quot;469769242&quot;:[9675],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;o&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"7\" data-aria-level=\"2\"><span data-contrast=\"auto\">Scripting, such as in Python or&nbsp;shell</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559685&quot;:1440,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n</li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"3\" data-aria-level=\"1\"><span data-contrast=\"auto\">Familiarity with standard debugging tools&nbsp;(e.g.&nbsp;GDB,&nbsp;Valgrind, address sanitizer)</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"4\" data-aria-level=\"1\"><span data-contrast=\"auto\">The ability to effectively communicate with non-technical stakeholders in Quant and Trading to obtain requirements, workshop solutions, and implement agreed-upon roadmaps</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"5\" data-aria-level=\"1\"><span data-contrast=\"auto\">The ability to react quickly and effectively to rapidly changing market conditions, including the ability to quickly and accurately respond and/or solve math and coding problems, is an essential function of the role&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"6\" data-aria-level=\"1\"><span data-contrast=\"auto\">A passion for&nbsp;building&nbsp;complex&nbsp;systems from the ground up</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"7\" data-aria-level=\"1\"><span data-contrast=\"auto\">The ability to collaborate with other developers of&nbsp;different backgrounds, specialties, and knowledge levels to collectively deliver&nbsp;cohesive solutions to non-trivial problems</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"8\" data-aria-level=\"1\"><span data-contrast=\"auto\">An intrinsically motivated attitude and the ability to work independently</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"9\" data-aria-level=\"1\"><span data-contrast=\"auto\">A strong sense&nbsp;of ownership, including a drive to fix bugs when they inevitably arise</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></li>\n</ul>\n<p><span data-contrast=\"auto\">In addition to the above technical skills, Akuna&nbsp;values diversity of experience and perspective. We believe that&nbsp;engineers with&nbsp;varied backgrounds and interests allow&nbsp;us to&nbsp;approach problems from&nbsp;unique&nbsp;angles&nbsp;and&nbsp;to&nbsp;uncover innovative,&nbsp;optimal&nbsp;solutions.&nbsp;We want everyone to feel empowered to apply; we welcome your application, and we strongly encourage you to take the first steps in joining us&nbsp;in the future!</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559685&quot;:0,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></p>\n<p><strong><em><span data-contrast=\"auto\">Resumes&nbsp;</span></em></strong><strong><em><span data-contrast=\"auto\">must</span></em></strong><strong><em><span data-contrast=\"auto\">&nbsp;be&nbsp;submitted&nbsp;in PDF format.</span></em></strong><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></p>\n<p><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\"><span class=\"TextRun SCXW267104367 BCX0\" lang=\"EN-US\" data-contrast=\"none\"><span class=\"NormalTextRun SCXW267104367 BCX0\">By applying to this role, you are&nbsp;</span><span class=\"NormalTextRun SCXW267104367 BCX0\">indicating</span><span class=\"NormalTextRun SCXW267104367 BCX0\">&nbsp;this is your top preference and acknowledge you will not be considered for other Quant and/or Tech roles at Akuna this recruiting season. This acknowledgement does not limit applications to Trading roles - in addition to this role, you may apply to any Trader roles of interest.&nbsp;</span></span><span class=\"EOP Selected SCXW267104367 BCX0\" data-ccp-props=\"{&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:278}\">&nbsp;</span></span></p>\n<p><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\"><span class=\"EOP Selected SCXW267104367 BCX0\" data-ccp-props=\"{&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:278}\">We are an AI-friendly company and encourage employees to leverage AI in their daily work. However, AI assistance is not permitted during interviews or assessments<span data-renderer-mark=\"true\">. Our interview process is designed to evaluate your individual skills and judgment</span>, <strong data-renderer-mark=\"true\">and the use of AI tools will result in disqualification from the hiring process.</strong></span></span></p>\n<p><em><span data-contrast=\"auto\">In accordance with&nbsp;the Illinois Equal Pay Act, the minimum base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. This role is also eligible for a discretionary performance bonus as part of the total compensation package and includes a comprehensive benefits package that may encompass employer-paid medical, dental, vision, retirement contributions, paid time off, and other benefits. The minimum base salary&nbsp;herein&nbsp;was&nbsp;determined&nbsp;in good faith by Akuna Capital LLC.</span></em><span data-ccp-props=\"{}\">&nbsp;</span></p>\n</div>","compensation":[],"custom_fields":{"Employment Type":"Full-time","Careers Site Section":["Student - Full Time"],"Specialty":["C++"],"Experience":"Junior","Crossfilter":["Engineering"]},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":true,"tier":"stretch","score":3,"level":"unspecified","term":null,"tracks":["software"],"role_matches":["Software Engineer"],"early_career_matches":[],"positive_matches":["Software Engineer"],"exclude_matches":[],"configured_tracks":["quant"]}}
{"schema_version":1,"job_key":"greenhouse:akunacapital:8013230","source":{"type":"greenhouse","board":"akunacapital","job_id":"8013230","source_url":"https://boards-api.greenhouse.io/v1/boards/akunacapital/jobs","response_hash":"247e4d5a05d356dc93433eb9033f4113982ec2bcbac9ee84ec535468741e7f3e","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Akuna Capital","slug":"akuna-capital","lists":["quant"],"target_role":null,"fit_tier":null},"title":"Software Engineer (Entry-Level) - Python","canonical_url":"https://www.akunacapital.com/careers/job/8013230?gh_jid=8013230","apply_url":"https://www.akunacapital.com/careers/job/8013230/?gh_jid=8013230","locations":[{"label":"Chicago, IL"},{"label":"Chicago, Illinois, United States"}],"workplace_type":"unknown","employment_type":"full_time","departments":["Engineering"],"teams":[],"language":"en","requisition_id":null,"internal_job_id":3474253,"first_published_at":"2026-07-13T14:21:16-04:00","source_updated_at":"2026-07-14T14:37:56-04:00","application_deadline":null,"description_plain":"About Akuna:\n\nAkuna Capital is an innovative trading firm with a strong focus on collaboration, cutting-edge technology, data driven solutions, and automation. We specialize in providing liquidity as an options market maker, meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully, we design and implement our own low latency technologies, trading strategies, and mathematical models.\n\nOur Founding Partners first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to operate from additional offices in Sydney, Shanghai, Singapore, and London.\n\nWhat you’ll do as an Entry-Level Python Software Engineer at Akuna:\n\nPython software engineers at Akuna have the opportunity to join either our Post Trade Technology, Data Engineering, or Crypto teams, working alongside other software engineers and traders to design and implement elegant solutions to complex and interesting problems. You’ll use cutting-edge technology while working on high-performance systems that process and analyze large volumes of trading and market data. We offer a team-based approach to trading and software engineering, believing that productive integration of the two groups is vital for success in this industry.\n\nAkuna is looking for software engineers who are motivated and willing to reach for creative solutions when faced with novel problems. We value innovation and hard work and want our engineers to make an impact on the firm. Whether you are interested in trading infrastructure, algorithms, exchange gateways, or data capture and analysis, there’s engaging work to be done. If you are excited to jump in and make a difference, Akuna could be the place for you.\n\nRequirements for this role:\n\n- Pursuing a bachelor’s, master’s, or Ph.D. in a technical field (computer science/engineering, math, physics, or equivalent)\n\n- Graduating by August 2027\n\n- Major GPA of 3.5 or above\n\n- Legal authorization to work in the U.S. is required on the first day of employment including F-1 students using OPT or STEM\n\nPrevious experience in finance or trading is not required. Many of our engineers joined Akuna with little-to-no prior knowledge of the markets, and we pride ourselves on our ability to onboard those new to the industry. Training and continuous education are provided for all engineers to ensure they can build the requisite technical and non-technical skillset for success.\n\nQualities That Make a Great Python Software Engineer Candidate:\n\n- Strong programming skills in Object-Oriented Python Development\n\n- Demonstrated experience with distributed systems\n\n- Strong analytical and problem-solving skills\n\n- Ability to communicate with the trading team, obtain requirements, find solutions, and implement them in a clean and concise way\n\n- Ability to create an easily understood and testable codebase that can change as quickly as market conditions require\n\n- Ability to react quickly and accurately to rapidly changing market conditions, including the ability to quickly and accurately respond and/or solve math and coding problems, is an essential function of the role\n\n- Passion for innovation and building systems from the ground up\n\n- Adaptability in an ever-changing environment\n\n- Self-starter attitude with the ability to work independently\n\n**Resumes must be submitted in PDF format.\n\nIn addition to the above technical skills, Akuna values diversity of experience and perspective. We believe that engineers with varied backgrounds and interests allow us to approach problems from unique angles and to uncover innovative, optimal solutions. We want everyone to feel empowered to apply; we welcome your application, and we strongly encourage you to take the first steps in joining us in the future!\n\nBy applying to this role, you are indicating this is your top preference and acknowledge you will not be considered for other Quant and/or Tech roles at Akuna this recruiting season. This acknowledgement does not limit applications to Trading roles - in addition to this role, you may apply to any Trader roles of interest.\n\nWe are an AI-friendly company and encourage employees to leverage AI in their daily work. However, AI assistance is not permitted during interviews or assessments . Our interview process is designed to evaluate your individual skills and judgment , and the use of AI tools will result in disqualification from the hiring process.\n\nIn accordance with the Illinois Equal Pay Act, the minimum annualized base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. The minimum base salary herein was determined in good faith by Akuna Capital LLC.","description_html":"<div class=\"OutlineElement Ltr SCXW256449397 BCX0\">\n<p><strong><span data-contrast=\"none\">About Akuna:&nbsp;</span></strong><span data-ccp-props=\"{&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:278}\">&nbsp;</span></p>\n<p><span data-contrast=\"none\">Akuna Capital is an innovative trading firm with a strong focus on collaboration,&nbsp;cutting-edge&nbsp;technology, data driven solutions, and automation. We specialize in providing liquidity as an options market&nbsp;maker, meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully, we design and implement our own low latency technologies, trading strategies, and mathematical models.</span><span data-ccp-props=\"{&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:278}\">&nbsp;</span></p>\n<p><span data-contrast=\"none\">Our Founding Partners</span><em><span data-contrast=\"none\">&nbsp;</span></em><span data-contrast=\"none\">first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to&nbsp;operate&nbsp;from&nbsp;additional&nbsp;offices in Sydney, Shanghai, Singapore, and London.</span><span data-ccp-props=\"{&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:278}\">&nbsp;</span></p>\n<p><strong><span data-contrast=\"none\">What&nbsp;you’ll&nbsp;do as an Entry-Level Python Software Engineer&nbsp;at Akuna:</span></strong><span data-ccp-props=\"{&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:278}\">&nbsp;</span></p>\n<p><span data-contrast=\"none\">Python&nbsp;software engineers at Akuna&nbsp;have the opportunity to&nbsp;join either our Post Trade Technology,&nbsp;Data Engineering, or Crypto&nbsp;teams, working&nbsp;alongside&nbsp;other&nbsp;software engineers and traders to design and implement elegant solutions to complex and&nbsp;interesting problems.&nbsp;You’ll&nbsp;use&nbsp;cutting-edge&nbsp;technology while working on high-performance systems that process and analyze large volumes of trading and market data. We offer a team-based approach to trading and software engineering, believing that productive&nbsp;integration of the two groups is vital for success in this industry.&nbsp;</span><span data-ccp-props=\"{&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:278}\">&nbsp;</span></p>\n<p><span data-contrast=\"none\">Akuna is looking for software engineers who are motivated and willing to reach for creative solutions when faced with novel problems.&nbsp;We value innovation and hard work and want&nbsp;our engineers&nbsp;to make an impact on the firm.&nbsp;Whether you are&nbsp;interested in trading infrastructure, algorithms, exchange gateways, or data capture and analysis,&nbsp;there’s&nbsp;engaging&nbsp;work to be done. If you are excited to jump in and make a difference, Akuna could be the place for you.</span><span data-ccp-props=\"{&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:278}\">&nbsp;</span></p>\n<p><strong><span data-contrast=\"none\">Requirements for this role:</span></strong><span data-ccp-props=\"{&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:278}\">&nbsp;</span></p>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"none\">Pursuing a bachelor’s,&nbsp;master’s, or&nbsp;Ph.D. in a technical field (computer science/engineering, math,&nbsp;physics, or equivalent)</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"2\" data-aria-level=\"1\"><span data-contrast=\"none\">Graduating by August 2027</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"3\" data-aria-level=\"1\"><span data-contrast=\"none\">Major GPA of 3.5 or above</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"4\" data-aria-level=\"1\"><span data-contrast=\"none\">Legal authorization to work in the U.S. is&nbsp;required&nbsp;on the first day of employment including F-1 students using OPT or STEM</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n<p><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:360,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:0}\">&nbsp;</span><span data-contrast=\"none\">Previous&nbsp;experience in finance or trading is&nbsp;</span><strong><span data-contrast=\"none\">not</span></strong><span data-contrast=\"none\">&nbsp;required.&nbsp;Many of&nbsp;our&nbsp;engineers&nbsp;joined&nbsp;Akuna with little-to-no&nbsp;prior&nbsp;knowledge&nbsp;of the markets, and we pride ourselves on our ability to onboard those new to the industry. Training and continuous education are provided for all engineers to ensure they can build&nbsp;the requisite technical and non-technical skillset for success.</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:360,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:0}\">&nbsp;</span></p>\n<p><strong><span data-contrast=\"none\">Qualities&nbsp;That Make a Great Python Software Engineer Candidate:</span></strong><span data-ccp-props=\"{&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:278}\">&nbsp;</span></p>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"none\">Strong programming skills in Object-Oriented Python Development</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"2\" data-aria-level=\"1\"><span data-contrast=\"none\">Demonstrated experience with distributed systems</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"3\" data-aria-level=\"1\"><span data-contrast=\"none\">Strong analytical and problem-solving skills</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"4\" data-aria-level=\"1\"><span data-contrast=\"none\">Ability to communicate with the trading team, obtain requirements, find solutions, and implement them in a clean and concise way</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"5\" data-aria-level=\"1\"><span data-contrast=\"none\">Ability to create an easily understood and testable codebase that can change as quickly as market conditions require</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"6\" data-aria-level=\"1\"><span data-contrast=\"none\">Ability to react quickly and accurately to rapidly changing market conditions, including the ability to quickly and accurately respond and/or solve math and coding problems, is an essential function of the role</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"7\" data-aria-level=\"1\"><span data-contrast=\"none\">Passion for innovation and building systems from the ground up</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"8\" data-aria-level=\"1\"><span data-contrast=\"none\">Adaptability in an ever-changing environment</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"9\" data-aria-level=\"1\"><span data-contrast=\"none\">Self-starter attitude with the ability to work independently</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n<p><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span></p>\n<p><span data-contrast=\"none\">**Resumes must be&nbsp;submitted&nbsp;in PDF format.&nbsp;</span><span data-ccp-props=\"{&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:278}\">&nbsp;</span></p>\n<p><span data-contrast=\"none\">In addition to the above technical skills, Akuna&nbsp;values diversity of experience and perspective. We believe that&nbsp;engineers with&nbsp;varied backgrounds and&nbsp;interests allow&nbsp;us to&nbsp;approach problems from&nbsp;unique&nbsp;angles&nbsp;and&nbsp;to&nbsp;uncover innovative,&nbsp;optimal&nbsp;solutions.&nbsp;We want everyone to feel empowered to apply; we welcome your application, and we strongly encourage you to take the first steps in joining us&nbsp;in the future!</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559685&quot;:0,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></p>\n<p><span data-contrast=\"none\">By applying to this role, you are&nbsp;indicating&nbsp;this is your top preference and acknowledge you will not be considered for other Quant and/or Tech roles at&nbsp;Akuna&nbsp;this recruiting season. This acknowledgement does not limit applications to Trading roles - in addition to this role, you may apply to any Trader roles of&nbsp;interest.&nbsp;</span><span data-ccp-props=\"{&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:278}\">&nbsp;</span></p>\n<p><span data-ccp-props=\"{&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:278}\">We are an AI-friendly company and encourage employees to leverage AI in their daily work. However, AI assistance is not permitted during interviews or assessments<span data-renderer-mark=\"true\">. Our interview process is designed to evaluate your individual skills and judgment</span>, <strong data-renderer-mark=\"true\">and the use of AI tools will result in disqualification from the hiring process.</strong></span></p>\n<p><em><span data-contrast=\"none\">In accordance with&nbsp;the Illinois Equal Pay Act, the&nbsp;minimum&nbsp;annualized base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. The minimum base salary&nbsp;herein&nbsp;was&nbsp;determined&nbsp;in good faith by Akuna Capital LLC.</span></em><span data-ccp-props=\"{&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:278}\">&nbsp;</span></p>\n<p><span data-ccp-props=\"{}\">&nbsp;</span></p>\n</div>","compensation":[],"custom_fields":{"Employment Type":"Full-time","Careers Site Section":["Student - Full Time"],"Specialty":[],"Experience":"Junior","Crossfilter":["Engineering"]},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":true,"tier":"stretch","score":3,"level":"unspecified","term":null,"tracks":["software"],"role_matches":["Software Engineer"],"early_career_matches":[],"positive_matches":["Software Engineer"],"exclude_matches":[],"configured_tracks":["quant"]}}
{"schema_version":1,"job_key":"greenhouse:akunacapital:8018886","source":{"type":"greenhouse","board":"akunacapital","job_id":"8018886","source_url":"https://boards-api.greenhouse.io/v1/boards/akunacapital/jobs","response_hash":"ad6196b71110131a3dc7edd7653202258d7d3d101c0ff9f0e4cd760d92db4a0a","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Akuna Capital","slug":"akuna-capital","lists":["quant"],"target_role":null,"fit_tier":null},"title":"Software Engineer Intern - C# .NET Desktop, Summer 2027","canonical_url":"https://www.akunacapital.com/careers/job/8018886?gh_jid=8018886","apply_url":"https://www.akunacapital.com/careers/job/8018886/?gh_jid=8018886","locations":[{"label":"Chicago, IL"},{"label":"Chicago, Illinois, United States"}],"workplace_type":"unknown","employment_type":"intern","departments":["Engineering"],"teams":[],"language":"en","requisition_id":null,"internal_job_id":3476471,"first_published_at":"2026-07-13T14:21:28-04:00","source_updated_at":"2026-07-14T14:29:51-04:00","application_deadline":null,"description_plain":"About Akuna:\n\nAkuna Capital is an innovative trading firm with a strong focus on collaboration, cutting-edge technology, data driven solutions, and automation. We specialize in providing liquidity as an options market maker, meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully, we design and implement our own low latency technologies, trading strategies, and mathematical models.\n\nOur Founding Partners first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to operate from additional offices in Sydney, Shanghai, Singapore, and London.\n\nWhat you’ll do as a C# .NET Desktop Software Engineer Intern on the User Interface team at Akuna:\n\nAkuna is seeking a Software Engineer Intern to join the UI team for our 10-week Akunacademy summer internship program. You will work directly with Traders, Quants, and other Software Engineers to design, build, test, and maintain real-time trading applications. Each intern takes full ownership of their project, and at the end of the program, has the opportunity to present their work and accomplishments.\n\nOur applications are the primary way Akuna’s market-makers interact with the financial markets, and their performance allows us to confidently provide liquidity in times of volatility. In this role you will:\n\n- Collaborate with cross-functional teams to design and develop Windows desktop applications written in C# .NET and WinForms/WPF\n\n- Implement sound and robust unit and integration tests to ensure the quality of our software\n\n- Continuously discover, evaluate, and implement technologies to maximize both user experience and development efficiency\n\n- Participate in Agile/Scrum development and shadow application support process\n\nRequirements for this role:\n\n- Pursuing a Bachelor’s, master’s, or Ph.D. in a technical field – Computer Science/Engineering or equivalent\n\n- Graduating by August 2028\n\n- Major GPA of 3.5 or above\n\n- Legal authorization to work in the U.S. is required on the first day of employment including F-1 students using OPT or STEM\n\nPrevious experience in finance or trading is not required. Many of our engineers joined Akuna with little-to-no prior knowledge of the markets, and we pride ourselves on our ability to onboard those new to the industry. Training and continuous education are provided for all engineers to ensure they can build the requisite technical and non-technical skillset for success.\n\nQualities that make great candidates:\n\n- Understanding of .NET Framework and C# programming language\n\n- Familiarity with WinForm or WPF applications is a plus\n\n- Familiarity in object-oriented programming and design patterns\n\n- Familiarity with version control systems (e.g., Git)\n\n- Understanding of unit testing concepts and frameworks (e.g. NUnit)\n\n- Solid problem-solving and analytical skills\n\n- Excellent communication skills and the ability to work in a team environment\n\nIn addition to the above technical skills, Akuna values diversity of experience and perspective. We believe that engineers with varied backgrounds and interests allow us to approach problems from unique angles and to uncover innovative, optimal solutions. We want everyone to feel empowered to apply; we welcome your application, and we strongly encourage you to take the first steps in joining us in the future!\n\n**Resumes must be submitted in PDF format.\n\nBy applying to this role, you are indicating this is your top preference and acknowledge you will not be considered for other Quant and/or Tech roles at Akuna this recruiting season. This acknowledgement does not limit applications to Trading roles - in addition to this role, you may apply to any Trader roles of interest.\n\nWe are an AI-friendly company and encourage employees to leverage AI in their daily work. However, AI assistance is not permitted during interviews or assessments . Our interview process is designed to evaluate your individual skills and judgment , and the use of AI tools will result in disqualification from the hiring process.\n\nIn accordance with the Illinois Equal Pay Act, the minimum annualized base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. The minimum base salary herein was determined in good faith by Akuna Capital LLC.","description_html":"<p><strong><span data-contrast=\"auto\">About Akuna:&nbsp;</span></strong><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<p><span data-contrast=\"auto\">Akuna Capital is an innovative trading firm with a strong focus on collaboration,&nbsp;cutting-edge&nbsp;technology, data driven solutions, and automation. We specialize in providing liquidity as an options market&nbsp;maker,&nbsp;meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully,&nbsp;we design and implement our own low latency technologies, trading strategies, and mathematical models.</span><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<p><span data-contrast=\"auto\">Our Founding Partners</span><em><span data-contrast=\"auto\">&nbsp;</span></em><span data-contrast=\"auto\">first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to operate from additional offices in Sydney, Shanghai, Singapore, and London.</span><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<p><strong><span data-contrast=\"auto\">What you’ll do as a C# .NET Desktop Software Engineer Intern on the User Interface team at Akuna:</span></strong><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<p><span data-contrast=\"auto\">Akuna is seeking a Software Engineer Intern to join the UI team for our 10-week&nbsp;Akunacademy&nbsp;summer internship program.&nbsp;You will work directly with Traders, Quants, and other Software Engineers to design, build, test, and&nbsp;maintain&nbsp;real-time trading applications.&nbsp;</span><span data-contrast=\"none\">Each intern takes full ownership of their project, and at the end of the program, has the opportunity to present their work and accomplishments.&nbsp;</span><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<p><span data-contrast=\"auto\">Our applications are the primary way Akuna’s market-makers interact with the financial markets, and their performance allows us to confidently provide liquidity in times of volatility. In this role you will:</span><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">Collaborate with cross-functional teams to design and develop Windows desktop applications written in C# .NET and WinForms/WPF</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"2\" data-aria-level=\"1\"><span data-contrast=\"auto\">Implement sound and robust unit and integration tests to ensure the quality of our software</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"3\" data-aria-level=\"1\"><span data-contrast=\"auto\">Continuously discover, evaluate, and implement technologies to maximize both user experience and development efficiency</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"4\" data-aria-level=\"1\"><span data-contrast=\"auto\">Participate in Agile/Scrum development and shadow application support process</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<p><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span><strong><span data-contrast=\"auto\">Requirements for this role:</span></strong><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">Pursuing a Bachelor’s,&nbsp;master’s, or Ph.D. in&nbsp;a&nbsp;technical field – Computer Science/Engineering or equivalent</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"2\" data-aria-level=\"1\"><span data-contrast=\"auto\">Graduating&nbsp;by August 2028</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"3\" data-aria-level=\"1\"><span data-contrast=\"auto\">Major GPA of 3.5 or above</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"4\" data-aria-level=\"1\"><span data-contrast=\"auto\">Legal authorization to work in the U.S. is required on the first day of employment including F-1 students using OPT or STEM</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<p><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span><span data-contrast=\"none\">Previous&nbsp;experience in finance or trading is&nbsp;</span><strong><span data-contrast=\"none\">not</span></strong><span data-contrast=\"none\">&nbsp;required. Many of our engineers joined Akuna with little-to-no prior knowledge of the markets, and we pride ourselves on our ability to onboard those new to the industry. Training and continuous education are provided for all engineers to ensure they can build the requisite technical and non-technical skillset for success.</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559685&quot;:0,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></p>\n<p><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span><strong><span data-contrast=\"auto\">Qualities that make great candidates:</span></strong><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">Understanding of .NET Framework and C# programming language</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"2\" data-aria-level=\"1\"><span data-contrast=\"auto\">Familiarity with WinForm or WPF applications is a plus</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"3\" data-aria-level=\"1\"><span data-contrast=\"auto\">Familiarity in object-oriented programming and design patterns</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"4\" data-aria-level=\"1\"><span data-contrast=\"auto\">Familiarity with version control systems (e.g., Git)</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"5\" data-aria-level=\"1\"><span data-contrast=\"auto\">Understanding of unit testing concepts and frameworks (e.g. NUnit)</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"6\" data-aria-level=\"1\"><span data-contrast=\"auto\">Solid problem-solving and analytical skills</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"7\" data-aria-level=\"1\"><span data-contrast=\"auto\">Excellent communication skills and the ability to work in a team environment</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<p><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559685&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span><span data-contrast=\"none\">In addition to the above technical skills, Akuna values diversity of experience and perspective. We believe that engineers with varied backgrounds and interests allow us to approach problems from unique angles and to uncover innovative,&nbsp;optimal&nbsp;solutions. We want everyone to feel empowered to apply; we welcome your application, and we strongly encourage you to take the first steps in joining us in the future!</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559685&quot;:0,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></p>\n<p><span data-contrast=\"auto\">**Resumes must be&nbsp;submitted&nbsp;in PDF format.&nbsp;</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:279}\">&nbsp;</span></p>\n<p><span data-contrast=\"auto\">By&nbsp;applying&nbsp;to this role, you are&nbsp;indicating&nbsp;this is your top preference and acknowledge you will not be considered for other Quant and/or Tech roles at Akuna this recruiting season. This acknowledgement does not limit applications to Trading roles - in addition to this role, you may apply to any Trader roles of interest.&nbsp;</span><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<p><span data-ccp-props=\"{}\">We are an AI-friendly company and encourage employees to leverage AI in their daily work. However, AI assistance is not permitted during interviews or assessments<span data-renderer-mark=\"true\">. Our interview process is designed to evaluate your individual skills and judgment</span>, <strong data-renderer-mark=\"true\">and the use of AI tools will result in disqualification from the hiring process.</strong></span></p>\n<p><em><span data-contrast=\"none\">In accordance with&nbsp;the Illinois&nbsp;Equal Pay Act, the&nbsp;minimum&nbsp;annualized base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. The minimum base salary&nbsp;herein&nbsp;was&nbsp;determined&nbsp;in good faith by Akuna Capital LLC.</span></em><span data-ccp-props=\"{}\">&nbsp;</span></p>","compensation":[],"custom_fields":{"Employment Type":"Intern","Careers Site Section":["Student - Intern - Summer"],"Specialty":[],"Experience":"Intern","Crossfilter":["Engineering"]},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":true,"tier":"target","score":13,"level":"intern","term":"summer_2027","tracks":["software"],"role_matches":["Software Engineer"],"early_career_matches":["Intern","2027"],"positive_matches":["Intern","2027","Software Engineer"],"exclude_matches":[],"configured_tracks":["quant"]}}
{"schema_version":1,"job_key":"greenhouse:akunacapital:8018847","source":{"type":"greenhouse","board":"akunacapital","job_id":"8018847","source_url":"https://boards-api.greenhouse.io/v1/boards/akunacapital/jobs","response_hash":"bb791494f32d7cb1ea49b3031798f4adba81b73f0d8ac0a1d5999c23c3aa2ce7","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Akuna Capital","slug":"akuna-capital","lists":["quant"],"target_role":null,"fit_tier":null},"title":"Software Engineer Intern - C++, Summer 2027","canonical_url":"https://www.akunacapital.com/careers/job/8018847?gh_jid=8018847","apply_url":"https://www.akunacapital.com/careers/job/8018847/?gh_jid=8018847","locations":[{"label":"Chicago, IL"},{"label":"Chicago, Illinois, United States"}],"workplace_type":"unknown","employment_type":"intern","departments":["Engineering"],"teams":[],"language":"en","requisition_id":null,"internal_job_id":3476453,"first_published_at":"2026-07-13T14:41:20-04:00","source_updated_at":"2026-07-14T14:30:13-04:00","application_deadline":null,"description_plain":"About Akuna\n\nAkuna Capital is an innovative trading firm with a strong focus on collaboration, cutting-edge technology, data-driven solutions, and automation. We specialize in providing liquidity on a variety of exchanges across various asset classes, primarily as an options market maker. To do this successfully, we build and maintain our own low-latency technologies, including application frameworks, trading strategies, and mathematical models.\n\nOur Founding Partners first conceptualized Akuna in their hometown of Sydney, Australia. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to operate from additional offices around the world: Sydney, Shanghai, Singapore, and London.\n\nWhat you’ll do as a C++ Software Engineer Intern at Akuna:\n\nC++ software engineer interns at Akuna have the opportunity to work on a variety of high-performance systems that power the firm’s core business operations. Our interns are embedded on small-to-medium-sized teams that frequently interface with Quant and Trading, allowing them to focus on a specific domain area while still experiencing the day-to-day life of an Akuna software engineer. Akuna’s C++ systems are heavily multithreaded, asynchronous, and distributed by nature, which comes with a slew of challenges; our engineers are tasked with ensuring these systems are reliable, efficient, scalable, and flexible enough for even the most niche use cases.\n\nOver their 10-week Akunacademy experience, software engineer interns will work on one or more valuable projects, progressing from ideation and design all the way to delivery and maintenance. These projects range from adding functionality onto existing systems to implementing brand new componentry to experimenting with new technologies and patterns to better understand the solution space. Akuna is looking for software engineer interns who are motivated, can solve complex problems, and are willing to reach for creative solutions when faced with novel problems. We value innovation, hard work, and knowledge, and we want our engineer interns to make a direct impact on the firm. Whether you are interested in algorithms and data structures, concurrency, networking and protocols, performance tuning, data capture and analysis, mathematical modeling, hardware, or something else, there’s engaging work to be done.\n\nRequirements for This Role\n\n- Pursuing a bachelor’s, master’s, or Ph.D. in a technical field (computer science/engineering, math, physics, or equivalent)\n\n- Graduating by August 2028\n\n- Legal authorization to work in the U.S. as of the first day of employment, including F-1 students using OPT or STEM\n\nPrevious experience in finance or trading is not required. Many of our engineers joined Akuna with little-to-no prior knowledge of the markets, and we pride ourselves on our ability to onboard those new to the industry. Training and continuous education are provided for all engineers to ensure they can build the requisite technical and non-technical skillset for success.\n\nQualities That Make a Great C++ Software Engineer Candidate\n\n- Experience programming in modern C++ (C++20 or later; C++23 preferred)\n\n- Experience with several of the following\n\n-\n\n- Distributed systems\n\n-\n\n- Parallel processing\n\n-\n\n- Asynchronous architectures\n\n-\n\n- Networking or protocol encoding/decoding\n\n-\n\n- Lock-free data structures and algorithms\n\n-\n\n- Performance profiling (e.g. perf, gprof, vtune)\n\n-\n\n- Scripting, such as in Python or shell\n\n- Familiarity with standard debugging tools (e.g. GDB, Valgrind, address sanitizer)\n\n- The ability to effectively communicate with non-technical stakeholders in Quant and Trading to obtain requirements, workshop solutions, and implement agreed-upon roadmaps\n\n- The ability to react quickly and effectively to rapidly changing market conditions, including the ability to quickly and accurately respond and/or solve math and coding problems, is an essential function of the role\n\n- A passion for building complex systems from the ground up\n\n- The ability to collaborate with other developers of different backgrounds, specialties, and knowledge levels to collectively deliver cohesive solutions to non-trivial problems\n\n- An intrinsically motivated attitude and the ability to work independently\n\n- A strong sense of ownership, including a drive to fix bugs when they inevitably arise\n\nIn addition to the above technical skills, Akuna values diversity of experience and perspective. We believe that engineers with varied backgrounds and interests allow us to approach problems from unique angles and to uncover innovative, optimal solutions. We want everyone to feel empowered to apply; we welcome your application, and we strongly encourage you to take the first steps in joining us in the future!\n\nResumes must be submitted in PDF format.\n\nBy applying to this role, you are indicating this is your top preference and acknowledge you will not be considered for other Quant and/or Tech roles at Akuna this recruiting season. This acknowledgement does not limit applications to Trading roles - in addition to this role, you may apply to any Trader roles of interest.\n\nWe are an AI-friendly company and encourage employees to leverage AI in their daily work. However, AI assistance is not permitted during interviews or assessments . Our interview process is designed to evaluate your individual skills and judgment , and the use of AI tools will result in disqualification from the hiring process.\n\nIn accordance with the Illinois Equal Pay Act, the minimum base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. This role is also eligible for a discretionary performance bonus as part of the total compensation package and includes a comprehensive benefits package that may encompass employer-paid medical, dental, vision, retirement contributions, paid time off, and other benefits. The minimum base salary herein was determined in good faith by Akuna Capital LLC.","description_html":"<div class=\"OutlineElement Ltr SCXW256449397 BCX0\">\n<p><strong><span data-contrast=\"none\">About Akuna</span></strong><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<p><span data-contrast=\"none\">Akuna Capital is an innovative trading firm with a strong focus on collaboration,&nbsp;cutting-edge&nbsp;technology, data-driven solutions, and automation. We specialize in providing liquidity on a variety of exchanges&nbsp;across various asset classes, primarily as&nbsp;an options market maker. To do this successfully, we&nbsp;build&nbsp;and&nbsp;maintain&nbsp;our own low-latency technologies, including application frameworks, trading strategies, and mathematical models.</span><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<p><span data-contrast=\"none\">Our Founding Partners first conceptualized Akuna in their hometown of Sydney, Australia. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to&nbsp;operate&nbsp;from&nbsp;additional&nbsp;offices around the world:&nbsp;Sydney, Shanghai, Singapore, and London.</span><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<p><strong><span data-contrast=\"none\">What&nbsp;you’ll&nbsp;do as a&nbsp;C++&nbsp;Software Engineer Intern at Akuna:</span></strong><span data-contrast=\"none\">&nbsp;</span><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<p><span data-contrast=\"none\">C++ software engineer&nbsp;interns at Akuna&nbsp;have the opportunity to&nbsp;work on a variety of high-performance systems that power the firm’s core business operations.&nbsp;Our&nbsp;interns are&nbsp;embedded&nbsp;on small-to-medium-sized teams that&nbsp;frequently&nbsp;interface with Quant and Trading, allowing them to&nbsp;focus on&nbsp;a specific domain area while&nbsp;still experiencing the day-to-day life of an Akuna software engineer. Akuna’s C++ systems are heavily multithreaded, asynchronous, and distributed by nature, which comes with a slew of challenges; our engineers are tasked with ensuring these systems are reliable, efficient, scalable, and flexible enough for even the most niche use cases.&nbsp;</span></p>\n<p><span data-contrast=\"none\">Over their 10-week Akunacademy experience, software engineer interns will work on one or more valuable projects, progressing from ideation and design all the way to delivery and maintenance. These projects range from adding functionality onto existing systems to implementing brand new componentry to experimenting with new technologies and patterns to better understand the solution space. Akuna is looking for software engineer interns who are motivated, can solve complex problems, and are willing to reach for creative solutions when faced with novel problems. We value innovation, hard work, and knowledge, and we want our engineer interns to make a direct impact on the firm. Whether you are interested in algorithms and data structures, concurrency, networking and protocols, performance tuning, data capture and analysis, mathematical modeling, hardware, or something else, there’s engaging work to be done.</span><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<p><strong><span data-contrast=\"none\">Requirements&nbsp;for This Role</span></strong><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"none\">Pursuing a bachelor’s,&nbsp;master’s, or&nbsp;Ph.D. in a technical field (computer science/engineering, math,&nbsp;physics, or equivalent)</span><span data-ccp-props=\"{}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"2\" data-aria-level=\"1\"><span data-contrast=\"none\">Graduating&nbsp;by&nbsp;August 2028</span><span data-ccp-props=\"{}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"3\" data-aria-level=\"1\"><span data-contrast=\"none\">Legal authorization to work in the U.S. as of the first day of employment, including F-1 students using OPT or STEM</span><span data-ccp-props=\"{}\">&nbsp;</span></li>\n</ul>\n<p><span data-contrast=\"none\">Previous&nbsp;experience in finance or trading is&nbsp;</span><strong><span data-contrast=\"none\">not</span></strong><span data-contrast=\"none\">&nbsp;required.&nbsp;Many of our&nbsp;engineers&nbsp;joined&nbsp;Akuna with little-to-no&nbsp;prior&nbsp;knowledge&nbsp;of the markets, and we pride ourselves on our ability to onboard those new to the industry. Training and continuous education are provided for all engineers to ensure they can build&nbsp;the requisite technical and non-technical skillset for success.</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559685&quot;:0,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></p>\n<p><strong><span data-contrast=\"none\">Qualities That Make a Great C++ Software Engineer Candidate</span></strong><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559685&quot;:0,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></p>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"none\">Experience programming in modern C++ (C++20&nbsp;or later;&nbsp;C++23&nbsp;preferred)</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"2\" data-aria-level=\"1\"><span data-contrast=\"none\">Experience with several of the following</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li>\n<ul>\n<li data-leveltext=\"o\" data-font=\"Symbol\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:1,&quot;335559684&quot;:-2,&quot;335559685&quot;:1440,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[9675],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;o&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"2\"><span data-contrast=\"none\">Distributed systems</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></li>\n</ul>\n</li>\n</ul>\n<ul>\n<li>\n<ul>\n<li data-leveltext=\"o\" data-font=\"Symbol\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:1,&quot;335559684&quot;:-2,&quot;335559685&quot;:1440,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[9675],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;o&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"2\" data-aria-level=\"2\"><span data-contrast=\"none\">Parallel processing</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></li>\n</ul>\n</li>\n</ul>\n<ul>\n<li>\n<ul>\n<li data-leveltext=\"o\" data-font=\"Symbol\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:1,&quot;335559684&quot;:-2,&quot;335559685&quot;:1440,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[9675],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;o&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"3\" data-aria-level=\"2\"><span data-contrast=\"none\">Asynchronous&nbsp;architectures</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></li>\n</ul>\n</li>\n</ul>\n<ul>\n<li>\n<ul>\n<li data-leveltext=\"o\" data-font=\"Symbol\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:1,&quot;335559684&quot;:-2,&quot;335559685&quot;:1440,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[9675],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;o&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"4\" data-aria-level=\"2\"><span data-contrast=\"none\">Networking or protocol encoding/decoding</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></li>\n</ul>\n</li>\n</ul>\n<ul>\n<li>\n<ul>\n<li data-leveltext=\"o\" data-font=\"Symbol\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:1,&quot;335559684&quot;:-2,&quot;335559685&quot;:1440,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[9675],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;o&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"5\" data-aria-level=\"2\"><span data-contrast=\"none\">Lock-free data structures and&nbsp;algorithms</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559685&quot;:1440,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n</li>\n</ul>\n<ul>\n<li>\n<ul>\n<li data-leveltext=\"o\" data-font=\"Symbol\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:1,&quot;335559684&quot;:-2,&quot;335559685&quot;:1440,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[9675],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;o&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"6\" data-aria-level=\"2\"><span data-contrast=\"none\">Performance profiling (e.g.&nbsp;perf,&nbsp;gprof,&nbsp;vtune)</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559685&quot;:1440,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n</li>\n</ul>\n<ul>\n<li>\n<ul>\n<li data-leveltext=\"o\" data-font=\"Symbol\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:1,&quot;335559684&quot;:-2,&quot;335559685&quot;:1440,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[9675],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;o&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"7\" data-aria-level=\"2\"><span data-contrast=\"none\">Scripting, such as in Python or&nbsp;shell</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559685&quot;:1440,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n</li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"3\" data-aria-level=\"1\"><span data-contrast=\"none\">Familiarity with standard debugging tools&nbsp;(e.g.&nbsp;GDB,&nbsp;Valgrind, address sanitizer)</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"4\" data-aria-level=\"1\"><span data-contrast=\"none\">The ability to effectively communicate with non-technical stakeholders in Quant and Trading to obtain requirements, workshop solutions, and implement agreed-upon roadmaps</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"5\" data-aria-level=\"1\"><span data-contrast=\"none\">The <span data-contrast=\"auto\">ability to react quickly and effectively to rapidly changing market conditions, including the ability to quickly and accurately respond and/or solve math and coding problems, is an essential function of the role&nbsp;</span></span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"6\" data-aria-level=\"1\"><span data-contrast=\"none\">A passion for&nbsp;building&nbsp;complex&nbsp;systems from the ground up</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"7\" data-aria-level=\"1\"><span data-contrast=\"none\">The ability to collaborate with other developers of&nbsp;different backgrounds, specialties, and knowledge levels to collectively deliver&nbsp;cohesive solutions to non-trivial problems</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"8\" data-aria-level=\"1\"><span data-contrast=\"none\">An intrinsically motivated attitude and the ability to work independently</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559683&quot;:0,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"9\" data-aria-level=\"1\"><span data-contrast=\"none\">A strong sense&nbsp;of ownership, including a drive to fix bugs when they inevitably arise</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></li>\n</ul>\n<p><span data-contrast=\"none\">In addition to the above technical skills, Akuna&nbsp;values diversity of experience and perspective. We believe that&nbsp;engineers with&nbsp;varied backgrounds and interests allow&nbsp;us to&nbsp;approach problems from&nbsp;unique&nbsp;angles&nbsp;and&nbsp;to&nbsp;uncover innovative,&nbsp;optimal&nbsp;solutions.&nbsp;We want everyone to feel empowered to apply; we welcome your application, and we strongly encourage you to take the first steps in joining us&nbsp;in the future!</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559685&quot;:0,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></p>\n<p><strong><em><span data-contrast=\"none\">Resumes&nbsp;</span></em></strong><strong><em><span data-contrast=\"none\">must</span></em></strong><strong><em><span data-contrast=\"none\">&nbsp;be&nbsp;submitted&nbsp;in PDF format.</span></em></strong><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></p>\n<p>By applying to this role, you are&nbsp;indicating&nbsp;this is your top preference and acknowledge you will not be considered for other Quant and/or Tech roles at Akuna this recruiting season. This acknowledgement does not limit applications to Trading roles - in addition to this role, you may apply to any Trader roles of interest.</p>\n<p>We are an AI-friendly company and encourage employees to leverage AI in their daily work. However, AI assistance is not permitted during interviews or assessments<span data-renderer-mark=\"true\">. Our interview process is designed to evaluate your individual skills and judgment</span>, <strong data-renderer-mark=\"true\">and the use of AI tools will result in disqualification from the hiring process.</strong></p>\n<p><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\"><span class=\"TextRun SCXW267104367 BCX0\" lang=\"EN-US\" data-contrast=\"none\"><span class=\"NormalTextRun SCXW267104367 BCX0\">&nbsp;</span></span></span><em><span data-contrast=\"none\">In accordance with&nbsp;the Illinois Equal Pay Act, the minimum base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. This role is also eligible for a discretionary performance bonus as part of the total compensation package and includes a comprehensive benefits package that may encompass employer-paid medical, dental, vision, retirement contributions, paid time off, and other benefits. The minimum base salary&nbsp;herein&nbsp;was&nbsp;determined&nbsp;in good faith by Akuna Capital LLC.</span></em><span data-ccp-props=\"{}\">&nbsp;</span></p>\n</div>","compensation":[],"custom_fields":{"Employment Type":"Intern","Careers Site Section":["Student - Intern - Summer"],"Specialty":["C++"],"Experience":"Intern","Crossfilter":["Engineering"]},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":true,"tier":"target","score":13,"level":"intern","term":"summer_2027","tracks":["software"],"role_matches":["Software Engineer"],"early_career_matches":["Intern","2027"],"positive_matches":["Intern","2027","Software Engineer"],"exclude_matches":[],"configured_tracks":["quant"]}}
{"schema_version":1,"job_key":"greenhouse:akunacapital:8018893","source":{"type":"greenhouse","board":"akunacapital","job_id":"8018893","source_url":"https://boards-api.greenhouse.io/v1/boards/akunacapital/jobs","response_hash":"d406a65f2c8d191135eeb437cec02d9e3e067f4dfddbeeb35feab9c6a13ebca4","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Akuna Capital","slug":"akuna-capital","lists":["quant"],"target_role":null,"fit_tier":null},"title":"Software Engineer Intern - Full Stack Web, Summer 2027","canonical_url":"https://www.akunacapital.com/careers/job/8018893?gh_jid=8018893","apply_url":"https://www.akunacapital.com/careers/job/8018893/?gh_jid=8018893","locations":[{"label":"Chicago, IL"},{"label":"Chicago, Illinois, United States"}],"workplace_type":"unknown","employment_type":"intern","departments":["Engineering"],"teams":[],"language":"en","requisition_id":null,"internal_job_id":3476477,"first_published_at":"2026-07-13T14:21:34-04:00","source_updated_at":"2026-07-14T14:30:28-04:00","application_deadline":null,"description_plain":"About Akuna:\n\nAkuna Capital is an innovative trading firm with a strong focus on collaboration, cutting-edge technology, data driven solutions, and automation. We specialize in providing liquidity as an options market maker, meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully, we design and implement our own low latency technologies, trading strategies, and mathematical models.\n\nOur Founding Partners first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to operate from additional offices in Sydney, Shanghai, Singapore, and London.\n\nWhat you’ll do as a Full Stack Web Software Engineer Intern on the User Interface team at Akuna:\n\nWe are seeking Web Software Engineer Interns to join the UI team for our 10-week Akunacademy summer internship program. You will work directly with Traders, Quants, and other Software Engineers to design, build, test, and maintain real-time trading applications. Each intern takes full ownership of their project, and at the end of the program, has the opportunity to present their work and accomplishments.\n\nOur applications are the primary way Akuna’s market-makers interact with the financial markets, and their performance allows us to confidently provide liquidity in times of volatility. In this role you will:\n\n- Collaborate with cross-functional teams to design and develop web applications using React, TypeScript, and Python\n\n- Implement sound and robust unit and integration tests to ensure the quality of our software\n\n- Continuously discover, evaluate, and implement technologies to maximize both user experience and development efficiency\n\n- Participate in Agile/Scrum development and shadow application support process\n\nRequirements for this role:\n\n- Pursuing a Bachelors, Masters, or Ph.D. in technical field – Computer Science/Engineering or equivalent\n\n- Graduating by August 2028\n\n- Major GPA of 3.5 or above\n\n- Legal authorization to work in the U.S. is required on the first day of employment including F-1 students using OPT or STEM\n\nPrevious experience in finance or trading is not required. Many of our engineers joined Akuna with little-to-no prior knowledge of the markets, and we pride ourselves on our ability to onboard those new to the industry. Training and continuous education are provided for all engineers to ensure they can build the requisite technical and non-technical skillset for success.\n\nQualities that make great candidates:\n\n- Understanding of web programming languages (JavaScript, TypeScript, Python, HTML/CSS)\n\n- Familiarity with Linux and a command-line shell\n\n- Understanding of unit testing concepts and frameworks (e.g., pytest, Jest, Storybook)\n\n- Familiarity with version control systems (e.g., Git)\n\n- Solid problem-solving and analytical skills\n\n- Excellent communication skills and the ability to work in a team environment\n\n- Self-starter attitude with the ability to work independently\n\nIn addition to the above technical skills, Akuna values diversity of experience and perspective. We believe that engineers with varied backgrounds and interests allow us to approach problems from unique angles and to uncover innovative, optimal solutions. We want everyone to feel empowered to apply; we welcome your application, and we strongly encourage you to take the first steps in joining us in the future!\n\n**Resumes must be submitted in PDF format.\n\nBy applying to this role, you are indicating this is your top preference and acknowledge you will not be considered for other Quant and/or Tech roles at Akuna this recruiting season. This acknowledgement does not limit applications to Trading roles - in addition to this role, you may apply to any Trader roles of interest.\n\nWe are an AI-friendly company and encourage employees to leverage AI in their daily work. However, AI assistance is not permitted during interviews or assessments . Our interview process is designed to evaluate your individual skills and judgment , and the use of AI tools will result in disqualification from the hiring process.\n\nIn accordance with the Illinois Equal Pay Act, the minimum annualized base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. The minimum base salary herein was determined in good faith by Akuna Capital LLC.","description_html":"<p><strong><span data-contrast=\"auto\">About Akuna:&nbsp;</span></strong><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<p><span data-contrast=\"auto\">Akuna Capital is an innovative trading firm with a strong focus on collaboration,&nbsp;cutting-edge&nbsp;technology, data driven solutions, and automation. We specialize in providing liquidity as an options market&nbsp;maker,&nbsp;meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this&nbsp;successfully,&nbsp;we design and implement our own low latency technologies, trading strategies, and mathematical models.</span><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<p><span data-contrast=\"auto\">Our Founding Partners</span><em><span data-contrast=\"auto\">&nbsp;</span></em><span data-contrast=\"auto\">first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to&nbsp;operate&nbsp;from&nbsp;additional&nbsp;offices in Sydney, Shanghai, Singapore, and London.</span><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<p><strong><span data-contrast=\"auto\">What&nbsp;you’ll&nbsp;do as a Full Stack Web Software Engineer Intern on the User Interface team at Akuna:</span></strong><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<p><span data-contrast=\"auto\">We are seeking Web Software Engineer Interns to join the UI team for our 10-week&nbsp;Akunacademy&nbsp;summer internship program.&nbsp;You will work directly with Traders, Quants, and other Software Engineers to design, build, test, and&nbsp;maintain&nbsp;real-time trading applications.&nbsp;</span><span data-contrast=\"none\">Each intern takes full ownership of their project, and at the end of the program, has the opportunity to present their work and accomplishments.&nbsp;</span><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<p><span data-contrast=\"auto\">Our applications are the primary way Akuna’s market-makers interact with the financial markets, and their performance allows us to confidently provide liquidity in times of volatility. In this role you will:</span><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">Collaborate with cross-functional teams to design and develop web applications using React, TypeScript, and Python</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"2\" data-aria-level=\"1\"><span data-contrast=\"auto\">Implement sound and robust unit and integration tests to ensure the quality of our software</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"3\" data-aria-level=\"1\"><span data-contrast=\"auto\">Continuously discover, evaluate, and implement technologies to maximize both user experience and development efficiency</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"4\" data-aria-level=\"1\"><span data-contrast=\"auto\">Participate in Agile/Scrum development and shadow application support process</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<p><span data-ccp-props=\"{}\">&nbsp;</span><strong><span data-contrast=\"auto\">Requirements for this role:</span></strong><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">Pursuing a Bachelors, Masters, or Ph.D. in technical field&nbsp;– Computer&nbsp;Science/Engineering or equivalent</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"2\" data-aria-level=\"1\"><span data-contrast=\"none\">Graduating by August 2028</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"3\" data-aria-level=\"1\"><span data-contrast=\"auto\">Major GPA of 3.5 or above</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"4\" data-aria-level=\"1\"><span data-contrast=\"auto\">Legal authorization to work in the U.S. is&nbsp;required&nbsp;on the first day of employment including F-1 students using OPT or STEM</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<p><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span><span data-contrast=\"none\">Previous&nbsp;experience in finance or trading is&nbsp;</span><strong><span data-contrast=\"none\">not</span></strong><span data-contrast=\"none\">&nbsp;required.&nbsp;Many of&nbsp;our&nbsp;engineers&nbsp;joined&nbsp;Akuna with little-to-no&nbsp;prior&nbsp;knowledge&nbsp;of the markets, and we pride ourselves on our ability to onboard those new to the industry. Training and continuous education are provided for all engineers to ensure they can build&nbsp;the requisite technical and non-technical skillset for success.</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559685&quot;:0,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></p>\n<p><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span><strong><span data-contrast=\"auto\">Qualities that make great candidates:</span></strong><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">Understanding of web programming languages (JavaScript, TypeScript, Python, HTML/CSS)</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"2\" data-aria-level=\"1\"><span data-contrast=\"auto\">Familiarity with Linux and a command-line shell</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"3\" data-aria-level=\"1\"><span data-contrast=\"auto\">Understanding of unit testing concepts and frameworks (e.g.,&nbsp;pytest, Jest, Storybook)</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"4\" data-aria-level=\"1\"><span data-contrast=\"auto\">Familiarity with version control systems (e.g., Git)</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"5\" data-aria-level=\"1\"><span data-contrast=\"auto\">Solid problem-solving and analytical skills</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"6\" data-aria-level=\"1\"><span data-contrast=\"auto\">Excellent communication skills and the ability to work in a team environment</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"7\" data-aria-level=\"1\"><span data-contrast=\"auto\">Self-starter attitude with the ability to work independently</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></li>\n</ul>\n<p><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span><span data-contrast=\"none\">In addition to the above technical skills, Akuna&nbsp;values diversity of experience and perspective. We believe that&nbsp;engineers with&nbsp;varied backgrounds and interests allow&nbsp;us to&nbsp;approach problems from&nbsp;unique&nbsp;angles&nbsp;and&nbsp;to&nbsp;uncover innovative,&nbsp;optimal&nbsp;solutions.&nbsp;We want everyone to feel empowered to apply; we welcome your application, and we strongly encourage you to take the first steps in joining us&nbsp;in the future!</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559685&quot;:0,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></p>\n<p><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span><span data-contrast=\"auto\">**Resumes must be&nbsp;submitted&nbsp;in PDF format.</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\">&nbsp;</span></p>\n<p><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:279}\">&nbsp;</span><span data-contrast=\"auto\">By&nbsp;applying&nbsp;to this role, you are&nbsp;indicating&nbsp;this is your top preference and acknowledge you will not be considered for other Quant and/or Tech roles at&nbsp;Akuna&nbsp;this recruiting season. This acknowledgement does not limit applications to Trading roles - in addition to this role, you may apply to any Trader roles of interest.&nbsp;</span><span data-ccp-props=\"{}\">&nbsp;</span></p>\n<p><span data-ccp-props=\"{}\">We are an AI-friendly company and encourage employees to leverage AI in their daily work. However, AI assistance is not permitted during interviews or assessments<span data-renderer-mark=\"true\">. Our interview process is designed to evaluate your individual skills and judgment</span>, <strong data-renderer-mark=\"true\">and the use of AI tools will result in disqualification from the hiring process.</strong></span></p>\n<p><em><span data-contrast=\"none\">In accordance with&nbsp;the Illinois&nbsp;Equal Pay Act, the&nbsp;minimum&nbsp;annualized base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. The minimum base salary&nbsp;herein&nbsp;was&nbsp;determined&nbsp;in good faith by Akuna Capital LLC.</span></em><span data-ccp-props=\"{}\">&nbsp;</span></p>","compensation":[],"custom_fields":{"Employment Type":"Intern","Careers Site Section":["Student - Intern - Summer"],"Specialty":[],"Experience":"Intern","Crossfilter":["Engineering"]},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":true,"tier":"target","score":13,"level":"intern","term":"summer_2027","tracks":["software"],"role_matches":["Software Engineer"],"early_career_matches":["Intern","2027"],"positive_matches":["Intern","2027","Software Engineer"],"exclude_matches":[],"configured_tracks":["quant"]}}
{"schema_version":1,"job_key":"greenhouse:akunacapital:8018853","source":{"type":"greenhouse","board":"akunacapital","job_id":"8018853","source_url":"https://boards-api.greenhouse.io/v1/boards/akunacapital/jobs","response_hash":"cdd9ae7b7d8b6048116820d55226e8fdad70b0c7d34035f197de5f9fba00bf8d","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Akuna Capital","slug":"akuna-capital","lists":["quant"],"target_role":null,"fit_tier":null},"title":"Software Engineer Intern - Python, Summer 2027","canonical_url":"https://www.akunacapital.com/careers/job/8018853?gh_jid=8018853","apply_url":"https://www.akunacapital.com/careers/job/8018853/?gh_jid=8018853","locations":[{"label":"Chicago, IL"},{"label":"Chicago, Illinois, United States"}],"workplace_type":"unknown","employment_type":"intern","departments":["Engineering"],"teams":[],"language":"en","requisition_id":null,"internal_job_id":3476456,"first_published_at":"2026-07-13T14:21:39-04:00","source_updated_at":"2026-07-14T14:37:54-04:00","application_deadline":null,"description_plain":"About Akuna:\n\nAkuna Capital is an innovative trading firm with a strong focus on collaboration, cutting-edge technology, data driven solutions, and automation. We specialize in providing liquidity as an options market maker, meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully, we design and implement our own low latency technologies, trading strategies, and mathematical models.\n\nOur Founding Partners first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to operate from additional offices in Sydney, Shanghai, Singapore, and London.\n\nWhat you’ll do as a Python Software Engineer Intern at Akuna:\n\nWe are seeking Python Software Engineer Interns to join our innovative and growing technology team for our 10-week Akunacademy internship program. In this role, you will join either our Post Trade Technology or Data Engineering teams and work alongside software engineers and traders to design and implement elegant solutions to complex and interesting problems. Each intern takes full ownership of their project, and at the end of the program, has the opportunity to present their work and accomplishments.\n\nPython Software Engineer Interns at Akuna have the opportunity to use cutting-edge technology while working on high-performance systems that process and analyze large volumes of trading and market data. We offer a team-based approach to trading and software engineering, believing that productive integration of the two groups is vital for success in this industry.\n\nAkuna is looking for software engineer interns who are motivated and willing to reach for creative solutions when faced with novel problems. We value innovation and hard work and want our engineers to make an impact on the firm. Whether you are interested in trading infrastructure, algorithms, exchange gateways, or data capture and analysis, there’s engaging work to be done. If you are excited to jump in and make a difference, Akuna could be the place for you.\n\nRequirements for this role:\n\n- Pursuing a bachelor’s, master’s, or Ph.D. in a technical field (Computer Science/Engineering, Math, Physics, or equivalent)\n\n- Graduating by August 2028\n\n- Major GPA of 3.5 or above\n\n- Legal authorization to work in the U.S. is required on the first day of employment including F-1 students using OPT or STEM\n\nPrevious experience in finance or trading is not required. Many of our engineers joined Akuna with little-to-no prior knowledge of the markets, and we pride ourselves on our ability to onboard those new to the industry. Training and continuous education are provided for all engineers to ensure they can build the requisite technical and non-technical skillset for success.\n\nQualities That Make a Great Python Software Engineer Intern Candidate:\n\n- Strong programming skills in Object-Oriented Python Development\n\n- Demonstrated experience with distributed systems\n\n- Strong analytical and problem-solving skills\n\n- Ability to communicate with the trading team, obtain requirements, find solutions, and implement them in a clean and concise way\n\n- Ability to create an easily understood and testable codebase that can change as quickly as market conditions require\n\n- Ability to react quickly and accurately to rapidly changing market conditions, including the ability to quickly and accurately respond and/or solve math and coding problems, is an essential function of the role\n\n- Passion for innovation and building systems from the ground up\n\n- Adaptability in an ever-changing environment\n\n- Self-starter attitude with the ability to work independently\n\n**Resumes must be submitted in PDF format.\n\nIn addition to technical skillsets, Akuna values the unique perspectives people can bring to the table to collaboratively solve complex problems and drive Akuna forward. We want all groups to feel empowered to apply, even if you don’t meet every qualification. We welcome your application and encourage you to take the first steps toward your future with us!\n\nBy applying to this role, you are indicating this is your top preference and acknowledge you will not be considered for other Quant and/or Tech roles at Akuna this recruiting season. This acknowledgement does not limit applications to Trading roles - in addition to this role, you may apply to any Trader roles of interest.\n\nWe are an AI-friendly company and encourage employees to leverage AI in their daily work. However, AI assistance is not permitted during interviews or assessments . Our interview process is designed to evaluate your individual skills and judgment , and the use of AI tools will result in disqualification from the hiring process.\n\nIn accordance with the Illinois Equal Pay Act, the minimum annualized base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. The minimum base salary herein was determined in good faith by Akuna Capital LLC.","description_html":"<p><strong><span data-contrast=\"auto\">About Akuna:&nbsp;</span></strong><span data-ccp-props=\"{&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:278}\">&nbsp;</span></p>\n<p><span data-contrast=\"auto\">Akuna Capital is an innovative trading firm with a strong focus on collaboration,&nbsp;cutting-edge&nbsp;technology, data driven solutions, and automation. We specialize in providing liquidity as an options market&nbsp;maker,&nbsp;meaning we are committed to providing competitive quotes that we are willing to both buy and sell. To do this successfully, we design and implement our own low latency technologies, trading strategies, and mathematical models.</span><span data-ccp-props=\"{&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:278}\">&nbsp;</span></p>\n<p><span data-contrast=\"auto\">Our Founding Partners</span><em><span data-contrast=\"auto\">&nbsp;</span></em><span data-contrast=\"auto\">first conceptualized Akuna in their hometown of Sydney. They opened the firm’s first office in 2011 in the heart of the derivatives industry and the options capital of the world – Chicago. Today, Akuna is proud to&nbsp;operate&nbsp;from&nbsp;additional&nbsp;offices in Sydney, Shanghai, Singapore, and London.</span><span data-ccp-props=\"{&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:278}\">&nbsp;</span></p>\n<p><strong><span data-contrast=\"auto\">What&nbsp;you’ll&nbsp;do as a Python Software Engineer Intern at Akuna:</span></strong><span data-ccp-props=\"{&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:278}\">&nbsp;</span></p>\n<p><span data-contrast=\"auto\">We are seeking Python Software Engineer Interns to join our innovative and growing technology team for our 10-week&nbsp;Akunacademy&nbsp;internship program. In this role, you will join either our Post Trade Technology or Data Engineering teams and work alongside software engineers and traders to design and implement elegant solutions to complex and interesting problems.&nbsp;Each intern takes full ownership of their project, and at the end of the program, has the opportunity to present their work and accomplishments.&nbsp;</span><span data-ccp-props=\"{&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:278}\">&nbsp;</span></p>\n<p><span data-contrast=\"auto\">Python Software Engineer Interns at Akuna have the opportunity to use cutting-edge technology while working on&nbsp;high-performance systems that process and analyze&nbsp;large&nbsp;volumes of trading and market data.&nbsp;We offer a team-based approach to trading and software engineering, believing that productive integration of the two groups is vital for success in this industry.&nbsp;</span><span data-ccp-props=\"{&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:278}\">&nbsp;</span></p>\n<p><span data-contrast=\"none\">Akuna is looking for&nbsp;software&nbsp;engineer interns who are motivated and willing to reach for creative solutions when faced with novel problems.&nbsp;We value innovation and hard work and want&nbsp;our engineers&nbsp;to make an impact on the firm.&nbsp;Whether you are&nbsp;interested in trading infrastructure, algorithms, exchange gateways, or data capture and analysis,&nbsp;there’s&nbsp;engaging&nbsp;work to be done. If you are excited to jump in and make a difference, Akuna could be the place for you.</span><span data-ccp-props=\"{&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:278}\">&nbsp;</span></p>\n<p><strong><span data-contrast=\"auto\">Requirements for this role:</span></strong><span data-ccp-props=\"{&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:278}\">&nbsp;</span></p>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">Pursuing a bachelor’s, master’s, or Ph.D. in a technical field (Computer Science/Engineering, Math, Physics, or equivalent)</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"2\" data-aria-level=\"1\"><span data-contrast=\"auto\">Graduating&nbsp;by August 2028</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"3\" data-aria-level=\"1\"><span data-contrast=\"auto\">Major GPA of 3.5 or above</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"4\" data-aria-level=\"1\"><span data-contrast=\"auto\">Legal authorization to work in the U.S. is&nbsp;required&nbsp;on the first day of employment including F-1 students using OPT or STEM</span>&nbsp;<br><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n<p><span data-contrast=\"none\">Previous&nbsp;experience in finance or trading is&nbsp;</span><strong><span data-contrast=\"none\">not</span></strong><span data-contrast=\"none\">&nbsp;required.&nbsp;Many of&nbsp;our&nbsp;engineers&nbsp;joined&nbsp;Akuna with little-to-no&nbsp;prior&nbsp;knowledge&nbsp;of the markets, and we pride ourselves on our ability to onboard those new to the industry. Training and continuous education are provided for all engineers to ensure they can build&nbsp;the requisite technical and non-technical skillset for success.</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559685&quot;:0,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:279}\">&nbsp;</span></p>\n<p><strong><span data-contrast=\"none\">Qualities&nbsp;That Make a Great Python Software Engineer Intern Candidate:</span></strong><span data-ccp-props=\"{&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:278}\">&nbsp;</span></p>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">Strong programming skills in Object-Oriented Python Development</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"2\" data-aria-level=\"1\"><span data-contrast=\"auto\">Demonstrated experience with distributed systems</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"3\" data-aria-level=\"1\"><span data-contrast=\"auto\">Strong analytical&nbsp;and problem-solving skills</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"4\" data-aria-level=\"1\"><span data-contrast=\"auto\">Ability to communicate with the trading team, obtain requirements, find solutions, and implement them in a clean and concise way</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"5\" data-aria-level=\"1\"><span data-contrast=\"auto\">Ability to create an easily understood and testable codebase that can change as quickly as market conditions require</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"6\" data-aria-level=\"1\"><span data-contrast=\"auto\">Ability to react quickly and accurately to rapidly changing market conditions, including the ability to quickly and accurately respond and/or solve math and coding problems, is an essential function of the role</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"7\" data-aria-level=\"1\"><span data-contrast=\"auto\">Passion for innovation and building systems from the ground up</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"8\" data-aria-level=\"1\"><span data-contrast=\"auto\">Adaptability in&nbsp;an ever-changing environment</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n<ul>\n<li data-leveltext=\"·\" data-font=\"Symbol\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;·&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" data-aria-posinset=\"9\" data-aria-level=\"1\"><span data-contrast=\"auto\">Self-starter attitude with the ability to work independently</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559685&quot;:720,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:278,&quot;335559991&quot;:360}\">&nbsp;</span></li>\n</ul>\n<p><span data-contrast=\"auto\">**Resumes must be submitted in PDF format.&nbsp;</span><span data-ccp-props=\"{&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:278}\">&nbsp;</span></p>\n<p><span data-contrast=\"auto\">In addition to technical skillsets, Akuna values the unique perspectives people can bring to the table to collaboratively solve complex problems and drive Akuna forward. We want all groups to feel empowered to apply, even if you&nbsp;don’t&nbsp;meet every qualification. We welcome your application and encourage you to take the first steps toward your future with us!</span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559740&quot;:278}\">&nbsp;</span></p>\n<p><span data-contrast=\"auto\">By&nbsp;applying&nbsp;to this role, you are&nbsp;indicating&nbsp;this is your top preference and acknowledge you will not be considered for other Quant and/or Tech roles at&nbsp;Akuna&nbsp;this recruiting season. This acknowledgement does not limit applications to Trading roles - in addition to this role, you may apply to any Trader roles of interest.&nbsp;</span><span data-ccp-props=\"{&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:278}\">&nbsp;</span></p>\n<p><span data-ccp-props=\"{&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:278}\">We are an AI-friendly company and encourage employees to leverage AI in their daily work. However, AI assistance is not permitted during interviews or assessments<span data-renderer-mark=\"true\">. Our interview process is designed to evaluate your individual skills and judgment</span>, <strong data-renderer-mark=\"true\">and the use of AI tools will result in disqualification from the hiring process.</strong></span></p>\n<p><em><span data-contrast=\"none\">In accordance with&nbsp;the Illinois&nbsp;Equal Pay Act, the&nbsp;minimum&nbsp;annualized base salary starts at $145,000. Exact compensation offered may vary based on many factors including, but not limited to, the candidate’s experience, qualifications, and skill set. The minimum base salary&nbsp;herein&nbsp;was&nbsp;determined&nbsp;in good faith by Akuna Capital LLC.</span></em><span data-ccp-props=\"{&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:278}\">&nbsp;</span></p>","compensation":[],"custom_fields":{"Employment Type":"Intern","Careers Site Section":["Student - Intern - Summer"],"Specialty":["PYTHON"],"Experience":"Intern","Crossfilter":["Engineering"]},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":true,"tier":"target","score":13,"level":"intern","term":"summer_2027","tracks":["software"],"role_matches":["Software Engineer"],"early_career_matches":["Intern","2027"],"positive_matches":["Intern","2027","Software Engineer"],"exclude_matches":[],"configured_tracks":["quant"]}}

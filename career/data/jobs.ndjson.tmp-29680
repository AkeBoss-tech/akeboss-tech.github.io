{"schema_version":1,"job_key":"greenhouse:anthropic:5166178008","source":{"type":"greenhouse","board":"anthropic","job_id":"5166178008","source_url":"https://boards-api.greenhouse.io/v1/boards/anthropic/jobs","response_hash":"60739d8e27eb66fce2cb6f39a35d900cf609f2f931cbc5981b81bea49dabada2","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Anthropic","slug":"anthropic","lists":["ai-ml","ai-infra","research"],"target_role":null,"fit_tier":null},"title":"Director of Payroll","canonical_url":"https://job-boards.greenhouse.io/anthropic/jobs/5166178008","apply_url":"https://job-boards.greenhouse.io/anthropic/jobs/5166178008","locations":[{"label":"San Francisco, CA | Seattle, WA"},{"label":"San Francisco, California, United States"}],"workplace_type":"unknown","employment_type":"unknown","departments":["Finance"],"teams":[],"language":"en","requisition_id":"261515","internal_job_id":4449584008,"first_published_at":"2026-03-26T00:39:57-04:00","source_updated_at":"2026-08-21T12:50:03-04:00","application_deadline":null,"description_plain":null,"description_html":null,"compensation":[],"custom_fields":{"Location Type":"On-Site"},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":false,"tier":"stretch","score":0,"level":"director","term":null,"tracks":[],"role_matches":[],"early_career_matches":[],"positive_matches":[],"exclude_matches":["Director"],"configured_tracks":["ai-ml","ai-infra","research"]}}
{"schema_version":1,"job_key":"greenhouse:anthropic:5234538008","source":{"type":"greenhouse","board":"anthropic","job_id":"5234538008","source_url":"https://boards-api.greenhouse.io/v1/boards/anthropic/jobs","response_hash":"db2e9cf66d48b1bf59b1f4d60c48ac9922e63d83bd7ec3ffb6d99d611a15f9c2","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Anthropic","slug":"anthropic","lists":["ai-ml","ai-infra","research"],"target_role":null,"fit_tier":null},"title":"Director, Compute Infrastructure Procurement Operations","canonical_url":"https://job-boards.greenhouse.io/anthropic/jobs/5234538008","apply_url":"https://job-boards.greenhouse.io/anthropic/jobs/5234538008","locations":[{"label":"San Francisco, CA | New York City, NY"},{"label":"San Francisco, California, United States"}],"workplace_type":"unknown","employment_type":"unknown","departments":["Finance"],"teams":[],"language":"en","requisition_id":"262679","internal_job_id":4481617008,"first_published_at":"2026-05-29T15:55:31-04:00","source_updated_at":"2026-08-21T12:50:19-04:00","application_deadline":null,"description_plain":null,"description_html":null,"compensation":[],"custom_fields":{"Location Type":"On-Site"},"status":"open","first_seen_at":"2026-08-20T03:47:44.181Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":false,"tier":"stretch","score":1,"level":"director","term":null,"tracks":["software"],"role_matches":[],"early_career_matches":[],"positive_matches":["Infrastructure"],"exclude_matches":["Director"],"configured_tracks":["ai-ml","ai-infra","research"]}}

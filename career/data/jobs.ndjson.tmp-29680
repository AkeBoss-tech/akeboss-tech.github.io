{"schema_version":1,"job_key":"ashby:bland:92c9d58d-5cfa-4d30-b16d-b078e432712e","source":{"type":"ashby","board":"bland","job_id":"92c9d58d-5cfa-4d30-b16d-b078e432712e","source_url":"https://api.ashbyhq.com/posting-api/job-board/bland","response_hash":"1941610dae6bd8693939de15a8f55c8178533542cd49b5cd999215dc4fa37941","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Bland AI","slug":"bland-ai","lists":["ai-ml","enterprise-ai","founding"],"target_role":null,"fit_tier":null},"title":"Demand Gen Lead","canonical_url":"https://jobs.ashbyhq.com/bland/92c9d58d-5cfa-4d30-b16d-b078e432712e","apply_url":"https://jobs.ashbyhq.com/bland/92c9d58d-5cfa-4d30-b16d-b078e432712e/application","locations":[{"label":"San Francisco","city":"San Francisco","region":"California","country":"United States","remote":null,"hybrid":null}],"workplace_type":"unknown","employment_type":"full_time","departments":["Marketing"],"teams":["Marketing"],"language":null,"requisition_id":null,"internal_job_id":null,"first_published_at":"2026-07-28T21:30:45.828+00:00","source_updated_at":null,"application_deadline":null,"description_plain":null,"description_html":null,"compensation":[{"type":"salary","summary":null,"salary_summary":null,"tiers":[]}],"custom_fields":{},"status":"open","first_seen_at":"2026-08-20T05:34:36.556Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":false,"tier":"stretch","score":0,"level":"lead","term":null,"tracks":[],"role_matches":[],"early_career_matches":[],"positive_matches":[],"exclude_matches":["Lead "],"configured_tracks":["ai-ml","enterprise-ai","founding"]}}
{"schema_version":1,"job_key":"ashby:bland:dc26ae53-bd0f-4e58-9e01-dea3777c0830","source":{"type":"ashby","board":"bland","job_id":"dc26ae53-bd0f-4e58-9e01-dea3777c0830","source_url":"https://api.ashbyhq.com/posting-api/job-board/bland","response_hash":"4fb74b2794d0ef655b6df20c5e1a337ddd8b932455f354aac2a302441aebd7e5","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Bland AI","slug":"bland-ai","lists":["ai-ml","enterprise-ai","founding"],"target_role":null,"fit_tier":null},"title":"Enterprise Account Executive","canonical_url":"https://jobs.ashbyhq.com/bland/dc26ae53-bd0f-4e58-9e01-dea3777c0830","apply_url":"https://jobs.ashbyhq.com/bland/dc26ae53-bd0f-4e58-9e01-dea3777c0830/application","locations":[{"label":"San Francisco","city":"San Francisco","region":"California","country":"United States","remote":null,"hybrid":null}],"workplace_type":"unknown","employment_type":"full_time","departments":["Sales"],"teams":["Sales"],"language":null,"requisition_id":null,"internal_job_id":null,"first_published_at":"2026-04-14T02:58:02.550+00:00","source_updated_at":null,"application_deadline":null,"description_plain":null,"description_html":null,"compensation":[{"type":"salary","summary":"$150K – $170K • Offers Equity • Offers Commission • Offers Bonus","salary_summary":"$150K - $170K","tiers":[{"title":null,"summary":"$150K – $170K • Offers Equity • Offers Commission • Offers Bonus","additional_information":null}]}],"custom_fields":{},"status":"open","first_seen_at":"2026-08-20T05:34:36.556Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":false,"tier":"stretch","score":0,"level":"unspecified","term":null,"tracks":[],"role_matches":[],"early_career_matches":[],"positive_matches":[],"exclude_matches":["Account Executive"],"configured_tracks":["ai-ml","enterprise-ai","founding"]}}
{"schema_version":1,"job_key":"ashby:bland:ea532833-f3d8-4dad-b5b2-f9bbeaa1a1a5","source":{"type":"ashby","board":"bland","job_id":"ea532833-f3d8-4dad-b5b2-f9bbeaa1a1a5","source_url":"https://api.ashbyhq.com/posting-api/job-board/bland","response_hash":"fe0ac96ed7fe3a796545ae943534073c63e58a1a996220c4b04cd8ba5711be7c","fetched_at":"2026-08-25T09:13:58.725Z"},"company":{"name":"Bland AI","slug":"bland-ai","lists":["ai-ml","enterprise-ai","founding"],"target_role":null,"fit_tier":null},"title":"Enterprise Solutions Engineer","canonical_url":"https://jobs.ashbyhq.com/bland/ea532833-f3d8-4dad-b5b2-f9bbeaa1a1a5","apply_url":"https://jobs.ashbyhq.com/bland/ea532833-f3d8-4dad-b5b2-f9bbeaa1a1a5/application","locations":[{"label":"San Francisco or Remote","city":null,"region":null,"country":null,"remote":null,"hybrid":null}],"workplace_type":"remote","employment_type":"full_time","departments":["Sales"],"teams":["Sales"],"language":null,"requisition_id":null,"internal_job_id":null,"first_published_at":"2026-08-06T00:11:44.729+00:00","source_updated_at":null,"application_deadline":null,"description_plain":"Enterprise Solutions Engineer\n\nReports To: Taylor Hyde https://www.linkedin.com/in/taylor-hyde/ – VP, Sales\n\nLocation(s): San Francisco preferred (3–5 days in office); open to remote\n\nTitle: Enterprise Solutions Engineer\n\nExperience Level: Individual Contributor\n\nFunction: Pre-Sales | Solutions Engineering\n\nCore Product: Bland AI – Enterprise Voice AI Agent Platform\n\nBusiness Model: Platform fee (tiered) + consumption-based per-minute pricing\n\nTotal Funding: $100M+ raised; most recent $50M Series C led by Dell Technologies Capital\n\nAbout Bland AI\n\nBland AI is the enterprise voice AI platform built for organizations with high-volume, complex customer conversations. Founded by Sobhan Nejad and Isaiah Granet in San Francisco, Bland built its own voice models and infrastructure from the ground up to solve the latency, reliability, and control challenges that have historically limited enterprise adoption of voice AI. Today, Bland powers more than 3.5 million calls per week across regulated industries and has raised over $100M to accelerate its mission of building the most secure enterprise platform for high-stakes customer interactions.\n\nToday, Bland's platform fully resolves up to 65% of inbound calls autonomously—handling not just FAQs, but multi-step workflows, authentication, business-rule-based routing, and live data lookups. For large contact center operators, every additional percentage point of autonomous resolution can translate to $500K–$1M+ in annual savings, making the ROI story unusually compelling.\n\nBland's biggest technical differentiator is that it owns and operates the entire voice stack in-house—speech recognition, orchestration, and text-to-speech—rather than stitching together third-party APIs. This architectural approach gives enterprise customers greater reliability, security, governance, and customization, particularly in highly regulated industries.\n\nWhy This Role Matters\n\nBland is building a more structured pre-sales motion as enterprise demand grows. Today, pre-sales is supported by a founding sales engineer, founders, AEs, and forward-deployed engineers. As the market becomes more competitive, Bland needs Solutions Engineers who can help prospects understand not just what the product does, but why Bland is the right technical and business choice.\n\nThis is a hands-on IC role focused on technical discovery, demo execution, POV scoping, and technical evaluation. You’ll partner closely with AEs, FDEs, Product, and Engineering to help Bland win enterprise deals by proving value quickly and credibly.\n\nThis is not a traditional “demo-only” SE role. You’ll be expected to get deep into customer workflows, understand the technical and operational environment, scope POVs tightly, configure compelling demos, and keep evaluations moving with urgency.\n\nRole Overview\n\nAs a Solutions Engineer at Bland, you’ll own the technical side of the sales process from discovery through Proof of Value. You’ll help customers understand where Bland can create ROI, how the platform fits into their existing systems, and what a successful deployment could look like.\n\nYou’ll be one of the first dedicated SEs at the company, meaning you’ll have the opportunity to shape the motion as it evolves – but the immediate need is execution: running strong discovery, building great demos, managing technical evaluations, and helping enterprise buyers feel confident choosing Bland.\n\nCore Responsibilities\n\n\nTECHNICAL DISCOVERY & QUALIFICATION\n\n - Lead technical discovery with prospective customers to understand call center workflows, existing systems, integration requirements, operational pain, and AI readiness.\n\n - Identify where Bland can deliver the clearest ROI and where the platform is best positioned to win.\n\n - Qualify technical fit early so the team invests time in the right opportunities.\n\n - Surface Bland’s technical differentiators naturally in discovery, especially around reliability, latency, security, governance, and customization.\n\n - Work closely with AEs to define the technical win strategy for each opportunity.\n\n\n\n\nDEMO & PROOF OF VALUE EXECUTION\n\n - Design and run demos that map directly to a customer’s workflows, not generic product walkthroughs.\n\n - Scope POVs around clear success criteria, timelines, milestones, and stakeholder expectations.\n\n - Configure custom voice agent demos and technical proof points that show how Bland handles real-world complexity.\n\n - Keep POVs focused and commercially relevant, avoiding unnecessary scope creep or “science projects.”\n\n - Partner with FDEs and Engineering when deeper technical resources are needed, while protecting their time and keeping the sales process efficient.\n\n - Drive urgency throughout the evaluation process by clearly defining next steps, owners, and decision points.\n\n\nTECHNICAL CREDIBILITY & CUSTOMER PRESENCE\n\n - Act as a credible technical voice in front of technical buyers, operators, InfoSec teams, procurement, and executive stakeholders.\n\n - Explain Bland’s architecture, in-house voice stack, integration approach, and data/security posture in a clear and commercially relevant way.\n\n - Support prospects through RFIs, security questionnaires, technical due diligence, and enterprise procurement processes.\n\n - Build trust with skeptical buyers by being direct, knowledgeable, and honest about both Bland’s strengths and current limitations.\n\n - Help customers understand what is possible today, what requires additional configuration, and what is not the right fit.\n\n\nCROSS-FUNCTIONAL PARTNERSHIP\n\n - Partner closely with AEs on discovery, win plans, POV strategy, and deal execution.\n\n - Collaborate with FDEs on handoff, resource planning, technical feasibility, and implementation readiness.\n\n - Feed product gaps, competitive learnings, customer feedback, and recurring technical objections back to Product and Engineering.\n\n - Contribute to demo assets, POV templates, technical documentation, and repeatable pre-sales materials as the motion matures.\n\n - Help define what “great” looks like for Solutions Engineering at Bland as the team scales.\n\n \n \n\nIdeal Candidate Profile / Role Requirements\n\nWe’re looking for someone who can sit at the intersection of technical depth, customer presence, and commercial urgency. You should be comfortable going deep with technical buyers, configuring compelling demos, and working side-by-side with sales to move deals forward.\n\nYou do not need to be an LLM or voice AI expert today, but you should be highly curious, technically sharp, and excited to ramp quickly in one of the fastest-moving categories in AI.\n\nMust-Have Experience\n\n - 4–8+ years of Solutions Engineering, Sales Engineering, or technical pre-sales experience at a B2B SaaS company.\n\n - Experience running technical discovery and supporting enterprise sales cycles.\n\n - Has owned or meaningfully contributed to technical POVs, POCs, pilots, or evaluations.\n\n - Strong understanding of how to define POV success criteria, manage scope, and keep technical evaluations on track.\n\n - Technical enough to configure demos, understand APIs, work with prompts, reason through integrations, and engage credibly with customer engineering or IT teams.\n\n - Commercially strong enough to partner closely with AEs and understand how technical work ties back to deal progression.\n\n - Comfortable operating in ambiguity at an early-stage or high-growth company.\n\n - Genuine interest in AI, LLMs, voice automation, and enterprise workflow transformation.\n\nNice-to-Have Experience\n\n - Background at a horizontal platform, developer infrastructure, API, automation, or workflow company.\n\n - Experience with voice AI, conversational AI, CPaaS, CCaaS, contact center technology, or customer support automation.\n\n - Experience selling into regulated or operationally complex industries such as healthcare, financial services, insurance, logistics, or enterprise support.\n\n - Has helped build or improve demo environments, POV frameworks, SE playbooks, or technical evaluation processes.\n\n - Startup experience where the pre-sales motion was still being defined.\n\nWhat \"Great\" Looks Like in This Role\n\n - You quickly understand a customer's business, technical environment, and call center workflows, identifying where Bland can drive measurable ROI.\n\n - You can articulate why Bland's self-hosted voice infrastructure matters and confidently engage with architects, engineering leaders, security teams, and other highly technical stakeholders.\n\n - You intuitively understand both business and technical requirements, identify the fastest path to value, and clearly communicate that plan to the customer.\n\n - You build demos that feel tailored to the customer's business—not like a canned product tour.\n\n - You scope POVs that are achievable, commercially focused, and tied to clear success criteria, timelines, and buying milestones.\n\n - You understand how enterprise customers buy software and tailor technical evaluations to the priorities of executives, operators, engineering, procurement, and InfoSec stakeholders.\n\n - You know how to control technical evaluations so they don't drift, stall, or balloon in scope.\n\n - You are credible with technical buyers while remaining commercially oriented, partnering closely with AEs to drive the technical win.\n\n - You are direct and honest with customers, especially when discussing tradeoffs, security, implementation complexity, and product limitations.\n\n - You move with urgency and are never the bottleneck.\n\n - Every POV you run makes the next one stronger by documenting learnings, improving the process, and raising the bar for the team.\n\nCompensation & Benefits\n\n - Significant equity in a high-growth, well-funded AI company\n\n - SF-based with strong in-person culture\n\n - Full benefits package","description_html":"<p style=\"min-height:1.5em\"><strong>Enterprise Solutions Engineer</strong></p><p style=\"min-height:1.5em\"><strong>Reports To: </strong><a target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://www.linkedin.com/in/taylor-hyde/\"><u>Taylor Hyde</u></a> – VP, Sales</p><p style=\"min-height:1.5em\"><strong>Location(s): </strong>San Francisco preferred (3–5 days in office); open to remote</p><p style=\"min-height:1.5em\"><strong>Title: </strong>Enterprise Solutions Engineer</p><p style=\"min-height:1.5em\"><strong>Experience Level: </strong>Individual Contributor</p><p style=\"min-height:1.5em\"><strong>Function: </strong>Pre-Sales | Solutions Engineering</p><p style=\"min-height:1.5em\"><strong>Core Product: </strong>Bland AI – Enterprise Voice AI Agent Platform</p><p style=\"min-height:1.5em\"><strong>Business Model: </strong>Platform fee (tiered) + consumption-based per-minute pricing</p><p style=\"min-height:1.5em\"><strong>Total Funding: </strong>$100M+ raised; most recent $50M Series C led by Dell Technologies Capital</p><p style=\"min-height:1.5em\"><strong>About Bland AI</strong></p><p style=\"min-height:1.5em\">Bland AI is the enterprise voice AI platform built for organizations with high-volume, complex customer conversations. Founded by Sobhan Nejad and Isaiah Granet in San Francisco, Bland built its own voice models and infrastructure from the ground up to solve the latency, reliability, and control challenges that have historically limited enterprise adoption of voice AI. Today, Bland powers more than 3.5 million calls per week across regulated industries and has raised over $100M to accelerate its mission of building the most secure enterprise platform for high-stakes customer interactions.</p><p style=\"min-height:1.5em\">Today, Bland's platform fully resolves up to 65% of inbound calls autonomously—handling not just FAQs, but multi-step workflows, authentication, business-rule-based routing, and live data lookups. For large contact center operators, every additional percentage point of autonomous resolution can translate to $500K–$1M+ in annual savings, making the ROI story unusually compelling.</p><p style=\"min-height:1.5em\">Bland's biggest technical differentiator is that it owns and operates the entire voice stack in-house—speech recognition, orchestration, and text-to-speech—rather than stitching together third-party APIs. This architectural approach gives enterprise customers greater reliability, security, governance, and customization, particularly in highly regulated industries.</p><p style=\"min-height:1.5em\"><strong>Why This Role Matters</strong></p><p style=\"min-height:1.5em\">Bland is building a more structured pre-sales motion as enterprise demand grows. Today, pre-sales is supported by a founding sales engineer, founders, AEs, and forward-deployed engineers. As the market becomes more competitive, Bland needs Solutions Engineers who can help prospects understand not just what the product does, but why Bland is the right technical and business choice.</p><p style=\"min-height:1.5em\">This is a <strong>hands-on IC role</strong> focused on technical discovery, demo execution, POV scoping, and technical evaluation. You’ll partner closely with AEs, FDEs, Product, and Engineering to help Bland win enterprise deals by proving value quickly and credibly.</p><p style=\"min-height:1.5em\">This is not a traditional “demo-only” SE role. You’ll be expected to get deep into customer workflows, understand the technical and operational environment, scope POVs tightly, configure compelling demos, and keep evaluations moving with urgency.</p><p style=\"min-height:1.5em\"><strong>Role Overview</strong></p><p style=\"min-height:1.5em\">As a <strong>Solutions Engineer</strong> at Bland, you’ll own the technical side of the sales process from discovery through Proof of Value. You’ll help customers understand where Bland can create ROI, how the platform fits into their existing systems, and what a successful deployment could look like.</p><p style=\"min-height:1.5em\">You’ll be one of the first dedicated SEs at the company, meaning you’ll have the opportunity to shape the motion as it evolves – but the immediate need is execution: running strong discovery, building great demos, managing technical evaluations, and helping enterprise buyers feel confident choosing Bland.</p><p style=\"min-height:1.5em\"><strong>Core Responsibilities</strong></p><h3><strong>Technical Discovery &amp; Qualification</strong></h3><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Lead technical discovery with prospective customers to understand call center workflows, existing systems, integration requirements, operational pain, and AI readiness.</p></li><li><p style=\"min-height:1.5em\">Identify where Bland can deliver the clearest ROI and where the platform is best positioned to win.</p></li><li><p style=\"min-height:1.5em\">Qualify technical fit early so the team invests time in the right opportunities.</p></li><li><p style=\"min-height:1.5em\">Surface Bland’s technical differentiators naturally in discovery, especially around reliability, latency, security, governance, and customization.</p></li><li><p style=\"min-height:1.5em\">Work closely with AEs to define the technical win strategy for each opportunity.</p></li></ul><p style=\"min-height:1.5em\"></p><h3><strong>Demo &amp; Proof of Value Execution</strong></h3><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Design and run demos that map directly to a customer’s workflows, not generic product walkthroughs.</p></li><li><p style=\"min-height:1.5em\">Scope POVs around clear success criteria, timelines, milestones, and stakeholder expectations.</p></li><li><p style=\"min-height:1.5em\">Configure custom voice agent demos and technical proof points that show how Bland handles real-world complexity.</p></li><li><p style=\"min-height:1.5em\">Keep POVs focused and commercially relevant, avoiding unnecessary scope creep or “science projects.”</p></li><li><p style=\"min-height:1.5em\">Partner with FDEs and Engineering when deeper technical resources are needed, while protecting their time and keeping the sales process efficient.</p></li><li><p style=\"min-height:1.5em\">Drive urgency throughout the evaluation process by clearly defining next steps, owners, and decision points.</p></li></ul><h3><strong>Technical Credibility &amp; Customer Presence</strong></h3><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Act as a credible technical voice in front of technical buyers, operators, InfoSec teams, procurement, and executive stakeholders.</p></li><li><p style=\"min-height:1.5em\">Explain Bland’s architecture, in-house voice stack, integration approach, and data/security posture in a clear and commercially relevant way.</p></li><li><p style=\"min-height:1.5em\">Support prospects through RFIs, security questionnaires, technical due diligence, and enterprise procurement processes.</p></li><li><p style=\"min-height:1.5em\">Build trust with skeptical buyers by being direct, knowledgeable, and honest about both Bland’s strengths and current limitations.</p></li><li><p style=\"min-height:1.5em\">Help customers understand what is possible today, what requires additional configuration, and what is not the right fit.</p></li></ul><h3><strong>Cross-Functional Partnership</strong></h3><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Partner closely with AEs on discovery, win plans, POV strategy, and deal execution.</p></li><li><p style=\"min-height:1.5em\">Collaborate with FDEs on handoff, resource planning, technical feasibility, and implementation readiness.</p></li><li><p style=\"min-height:1.5em\">Feed product gaps, competitive learnings, customer feedback, and recurring technical objections back to Product and Engineering.</p></li><li><p style=\"min-height:1.5em\">Contribute to demo assets, POV templates, technical documentation, and repeatable pre-sales materials as the motion matures.</p></li><li><p style=\"min-height:1.5em\">Help define what “great” looks like for Solutions Engineering at Bland as the team scales.</p></li></ul><div style=\"min-height:1.2em;margin-top:0;margin-bottom:0\"> </div><div style=\"min-height:1.2em;margin-top:0;margin-bottom:0\"> </div><p style=\"min-height:1.5em\"><strong>Ideal Candidate Profile / Role Requirements</strong></p><p style=\"min-height:1.5em\">We’re looking for someone who can sit at the intersection of technical depth, customer presence, and commercial urgency. You should be comfortable going deep with technical buyers, configuring compelling demos, and working side-by-side with sales to move deals forward.</p><p style=\"min-height:1.5em\">You do not need to be an LLM or voice AI expert today, but you should be highly curious, technically sharp, and excited to ramp quickly in one of the fastest-moving categories in AI.</p><p style=\"min-height:1.5em\"><strong>Must-Have Experience</strong></p><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">4–8+ years of Solutions Engineering, Sales Engineering, or technical pre-sales experience at a B2B SaaS company.</p></li><li><p style=\"min-height:1.5em\">Experience running technical discovery and supporting enterprise sales cycles.</p></li><li><p style=\"min-height:1.5em\">Has owned or meaningfully contributed to technical POVs, POCs, pilots, or evaluations.</p></li><li><p style=\"min-height:1.5em\">Strong understanding of how to define POV success criteria, manage scope, and keep technical evaluations on track.</p></li><li><p style=\"min-height:1.5em\">Technical enough to configure demos, understand APIs, work with prompts, reason through integrations, and engage credibly with customer engineering or IT teams.</p></li><li><p style=\"min-height:1.5em\">Commercially strong enough to partner closely with AEs and understand how technical work ties back to deal progression.</p></li><li><p style=\"min-height:1.5em\">Comfortable operating in ambiguity at an early-stage or high-growth company.</p></li><li><p style=\"min-height:1.5em\">Genuine interest in AI, LLMs, voice automation, and enterprise workflow transformation.</p></li></ul><p style=\"min-height:1.5em\"><strong>Nice-to-Have Experience</strong></p><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Background at a horizontal platform, developer infrastructure, API, automation, or workflow company.</p></li><li><p style=\"min-height:1.5em\">Experience with voice AI, conversational AI, CPaaS, CCaaS, contact center technology, or customer support automation.</p></li><li><p style=\"min-height:1.5em\">Experience selling into regulated or operationally complex industries such as healthcare, financial services, insurance, logistics, or enterprise support.</p></li><li><p style=\"min-height:1.5em\">Has helped build or improve demo environments, POV frameworks, SE playbooks, or technical evaluation processes.</p></li><li><p style=\"min-height:1.5em\">Startup experience where the pre-sales motion was still being defined.</p></li></ul><p style=\"min-height:1.5em\"><strong>What \"Great\" Looks Like in This Role</strong></p><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">You quickly understand a customer's business, technical environment, and call center workflows, identifying where Bland can drive measurable ROI.</p></li><li><p style=\"min-height:1.5em\">You can articulate why Bland's self-hosted voice infrastructure matters and confidently engage with architects, engineering leaders, security teams, and other highly technical stakeholders.</p></li><li><p style=\"min-height:1.5em\">You intuitively understand both business and technical requirements, identify the fastest path to value, and clearly communicate that plan to the customer.</p></li><li><p style=\"min-height:1.5em\">You build demos that feel tailored to the customer's business—not like a canned product tour.</p></li><li><p style=\"min-height:1.5em\">You scope POVs that are achievable, commercially focused, and tied to clear success criteria, timelines, and buying milestones.</p></li><li><p style=\"min-height:1.5em\">You understand how enterprise customers buy software and tailor technical evaluations to the priorities of executives, operators, engineering, procurement, and InfoSec stakeholders.</p></li><li><p style=\"min-height:1.5em\">You know how to control technical evaluations so they don't drift, stall, or balloon in scope.</p></li><li><p style=\"min-height:1.5em\">You are credible with technical buyers while remaining commercially oriented, partnering closely with AEs to drive the technical win.</p></li><li><p style=\"min-height:1.5em\">You are direct and honest with customers, especially when discussing tradeoffs, security, implementation complexity, and product limitations.</p></li><li><p style=\"min-height:1.5em\">You move with urgency and are never the bottleneck.</p></li><li><p style=\"min-height:1.5em\">Every POV you run makes the next one stronger by documenting learnings, improving the process, and raising the bar for the team.</p></li></ul><p style=\"min-height:1.5em\"><strong>Compensation &amp; Benefits</strong></p><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Significant equity in a high-growth, well-funded AI company</p></li><li><p style=\"min-height:1.5em\">SF-based with strong in-person culture</p></li><li><p style=\"min-height:1.5em\">Full benefits package</p></li></ul>","compensation":[{"type":"salary","summary":null,"salary_summary":null,"tiers":[]}],"custom_fields":{},"status":"open","first_seen_at":"2026-08-20T05:34:36.556Z","last_seen_at":"2026-08-25T09:13:58.725Z","closed_at":null,"possibly_closed_at":null,"missing_complete_scans":0,"data_quality":null,"classification":{"included":true,"tier":"stretch","score":2,"level":"unspecified","term":null,"tracks":[],"role_matches":["Solutions Engineer"],"early_career_matches":[],"positive_matches":[],"exclude_matches":[],"configured_tracks":["ai-ml","enterprise-ai","founding"]}}

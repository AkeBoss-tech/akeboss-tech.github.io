{
  "manifest_version": 3,
  "name": "Career Monitor",
  "description": "Runs the local deterministic career monitor and shows its latest results.",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "activeTab",
    "alarms",
    "nativeMessaging",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Career Monitor"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
